---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import NotOpen from "../components/compte/NotOpen.astro";
import QgApp from "../components/compte/QgApp";
import { AUTH_ENABLED } from "../lib/compte/api";
---

{/* La face privée du site, et depuis le 10 novembre 2026 l'administration de l'encadrement : cette page ne contient que la porte.
    Le contenu vient du serveur, pour un membre validé seulement. `espace` : tout y est plus grand, voir global.css. */}
<Base title="Le QG" description="Le QG des membres du clan GAL : salons à rejoindre, décisions, boîte à idées et événements, réservé aux membres reconnus." noindex>
  <div class="wrap">
    <PageHeader title="Le QG" compact />
    <div class="espace">
      {AUTH_ENABLED ? <QgApp client:only="preact" /> : <NotOpen />}
    </div>
  </div>
</Base>
