---
import Base from "../layouts/Base.astro";
import CarteUtile from "../components/CarteUtile.astro";
import Empty from "../components/Empty.astro";
import PageHeader from "../components/PageHeader.astro";
import ReadingNote from "../components/ReadingNote.astro";
import { BANNIERES_MEMBRES_FILE, bannieresDuCache, fondsDesLignes } from "../lib/bannieres-joueurs";
import { fmtDayAndTime, fmtInt } from "../lib/format";
import { gauloisDuSite, portraitDuGaulois } from "../lib/gaulois-site";
import { tenueOf } from "../lib/gaulois-sprite";
import { PARTIES_MIN_DU_CLASSEMENT } from "../lib/rejeu/bilan";
import { classementDuSite } from "../lib/rejeu/utiles-site";
import { rareteDuCadre } from "../lib/village/vitrine";

/**
 * « Les plus utiles » (demande du pilote, 17 novembre 2026 : un classement général du score d'utilité, « uniquement pour les
 * gaulois », puis « lui donner sa propre entrée dans le menu ») : la moyenne de l'utilité de chaque membre au pseudo public
 * sur les parties à revoir qui ont leur bilan (`classementDuSite`, src/lib/rejeu/utiles-site.ts). Le bilan de chaque partie
 * est sous son replay, dans « Revoir une partie ». Exception à `stats.team` voulue par le pilote (CLAUDE.md) : jamais mêlé aux
 * stats du clan ni au classé, jamais appelé Elo.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { lignes: classement, rangs, ids, mouvements, parties, depuis, fait } = classementDuSite();
// La bannière que chaque membre a choisie pour son Gaulois, le fond de sa carte comme sur la liste des membres ; sans elle,
// le haut de sa carte est une case pâle à points d'interrogation.
const bannieres = fondsDesLignes(bannieresDuCache(BANNIERES_MEMBRES_FILE, ids.values()));
const lignes = classement.map((l) => {
  const id = ids.get(l.nom)!;
  const portrait = portraitDuGaulois(id);
  const tenue = portrait ? tenueOf(gauloisDuSite(), id) : null;
  const mouvement = mouvements.get(l.nom) ?? null;
  return {
    ...l,
    rang: rangs.get(l.nom)!,
    // « Monte », « descend », « nouveau » au classement, ou rien à dire (même rang).
    mouvement: mouvement === null ? { sens: "nouveau" as const, places: 0 } : mouvement > 0 ? { sens: "monte" as const, places: mouvement } : mouvement < 0 ? { sens: "descend" as const, places: -mouvement } : null,
    fiche: `${base}/membres/${encodeURIComponent(id)}`,
    banniere: Object.hasOwn(bannieres, id) ? `${base}${bannieres[id]!.image}` : null,
    portrait: portrait ? { ...portrait, image: `${base}${portrait.image}`, rarete: tenue ? rareteDuCadre(tenue) : null } : null,
  };
});
/** Les cartes montrées d'emblée ; les suivantes dans un repli. */
const PREMIERES = 12;
---

<Base title="Les plus utiles" description="Les Gaulois les plus utiles du clan GAL dans les parties à revoir : or produit, combat et dons, en parts de l'équipe.">
  <div class="wrap">
    <PageHeader title="Les plus utiles" intro="Qui pèse le plus dans l'effort des Gaulois, en moyenne sur les parties à revoir.">
      {fait && <p class="info-discrete tnum mt-2" data-testid="utiles-date">À jour du {fmtDayAndTime(fait)}.</p>}
    </PageHeader>

    {
      lignes.length === 0 ? (
        <Empty title="Pas de données" data-testid="utiles-vide">
          Le classement paraît quand un membre au pseudo public a joué {PARTIES_MIN_DU_CLASSEMENT} parties à revoir qui ont leur bilan.
        </Empty>
      ) : (
        <section class="bilan bilan-vu" aria-labelledby="utiles-titre" data-testid="utiles-classement">
          <h2 id="utiles-titre" class="sr-only">Le classement</h2>
          <p class="info-discrete tnum">
            Sur {parties > 1 ? `les ${fmtInt(parties)} parties à revoir qui ont leur bilan` : "la partie à revoir qui a son bilan"}
            {depuis && `, depuis le ${fmtDayAndTime(depuis)}`}, pour les membres au pseudo public qui en ont joué {PARTIES_MIN_DU_CLASSEMENT} au moins. 100 : la part moyenne d'un Gaulois de la partie. La flèche : les places gagnées ou perdues avec les parties du jour.
          </p>
          <ol class="bilan-liste">
            {lignes.slice(0, PREMIERES).map((l) => (
              <CarteUtile l={l} />
            ))}
          </ol>
          {/* La suite repliée (revue du 18 novembre 2026) : sur téléphone, le classement entier faisait treize écrans. */}
          {lignes.length > PREMIERES && (
            <details class="fold mt-4" data-testid="utiles-suite">
              <summary>Voir les {fmtInt(lignes.length - PREMIERES)} suivants</summary>
              <ol class="bilan-liste" start={PREMIERES + 1}>
                {lignes.slice(PREMIERES).map((l) => (
                  <CarteUtile l={l} />
                ))}
              </ol>
            </details>
          )}
        </section>
      )
    }

    <p class="mt-6">
      <a class="link" href={`${base}/revoir`} data-testid="utiles-revoir">Le bilan de chaque partie est sous son replay, dans « Revoir une partie »</a>
    </p>

    <ReadingNote page>
      <p>Chaque partie à revoir a son bilan : pour chaque joueur au tag du clan, ce que le jeu écrit à la fin de la partie (l'or produit par le travail, le commerce et les trains, les troupes envoyées à l'attaque, les unités et bâtiments ennemis détruits ou pris) et les dons relevés quand le robot du site rejoue la partie.</p>
      <p>Dans une partie, chaque axe est la part du joueur dans le total des Gaulois : Économie pour l'or produit, Combat pour la moyenne des troupes à l'attaque et des prises, Soutien pour la moyenne des troupes et de l'or donnés. L'utilité est la moyenne de ces parts, 100 étant la part moyenne d'un Gaulois de la partie. Ici, chaque nombre est la moyenne du membre sur ses parties.</p>
      <p>Ce classement compare les Gaulois entre eux, partie par partie. Il ne mesure pas le niveau d'un joueur : la place de départ, les dons reçus et une élimination précoce pèsent sur le score. Ce ne sont ni les stats du clan, ni le classé du jeu.</p>
      <p>Seuls les membres au pseudo public y sont, avec {PARTIES_MIN_DU_CLASSEMENT} parties au moins. Les parties à revoir sont les dernières du clan, sept jours au plus : le classement bouge avec elles.</p>
      <p>La flèche à côté du rang compare ce classement à celui que donneraient les mêmes parties sans celles commencées le jour de la dernière mise à jour, heure de Paris : les places gagnées ou perdues avec elles. « Nouveau » : le membre n'avait pas ses {PARTIES_MIN_DU_CLASSEMENT} parties sans elles. Ce n'est pas un relevé de la veille : une partie sortie depuis de la liste à revoir n'y est plus.</p>
    </ReadingNote>
  </div>
</Base>
