---
import Base from "../layouts/Base.astro";
import ClanCompare from "../components/ClanCompare.tsx";
import DataStatus from "../components/DataStatus.astro";
import Empty from "../components/Empty.astro";
import FaceOffs from "../components/FaceOffs.astro";
import PageHeader from "../components/PageHeader.astro";
import PageJumps from "../components/PageJumps.astro";
import ReadingNote from "../components/ReadingNote.astro";
import RivalRace from "../components/RivalRace.tsx";
import { clan } from "../../config/clan";
import { loadGames, loadLeaderboard, loadMeta, loadRivals, loadSessions } from "../lib/data";
import { fmtDate, fmtScore } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { FACE_OFF_MIN_MEETINGS, faceOffs } from "../lib/games";
import { rivalSeries } from "../lib/rivals";
import { findClan, neighbours, withOfficialRanks } from "../lib/stats";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const leaderboard = loadLeaderboard();
const clans = leaderboard ? withOfficialRanks(leaderboard.clans) : [];
const me = findClan(clans, clan.tag);
const near = neighbours(clans, clan.tag);
const lanes = me && near ? [near.above?.clan, me, near.below?.clan].filter((c) => c !== undefined) : [];
const laneMax = Math.max(1, ...lanes.map((c) => c.weightedWins));
const snapshots = loadRivals();
const race = leaderboard && snapshots.length > 0 ? rivalSeries(leaderboard.clans, snapshots, clan.tag) : null;
const meetings = leaderboard ? faceOffs(loadSessions(), loadGames(), clan.tag, leaderboard.clans.map((c) => c.clanTag), meta.sessions.coveredUntil) : null;
const jumps = [
  { href: "#race-title", label: "La course", show: race !== null && race.length > 0 },
  { href: "#compare-title", label: "Comparer un clan", show: me !== null && clans.length > 1 },
  { href: "#face-offs-title", label: "Face-à-face", show: meetings !== null && (meetings.rows.length > 0 || !meetings.reliable || meta.games.lastError !== null) },
].filter((jump) => jump.show);
---

<Base title="Nos rivaux" description="Les clans autour de GAL au classement officiel : la course jour après jour, le comparateur et les face-à-face.">
  <div class="wrap">
    <PageHeader title="Nos rivaux">
      <div class="mt-4">
        <DataStatus state={meta.leaderboard} maxAgeHours={MAX_AGE_HOURS.leaderboard} asOf={leaderboard?.end} asOfLabel="Classement arrêté au" />
      </div>
      {jumps.length > 1 && <PageJumps links={jumps} />}
    </PageHeader>

    {
      !leaderboard ? (
        <Empty title="Classement indisponible">Aucun classement valide n'a encore été collecté.</Empty>
      ) : (
        <>
          {lanes.length > 0 && (
            <section class="card reveal mb-8 p-5" data-testid="score-lanes" aria-labelledby="lanes-title">
              <h2 id="lanes-title" class="text-sm tracking-wide text-muted">Le score autour de [{clan.tag}]</h2>
              <ul class="mt-4 space-y-3">
                {lanes.map((lane) => (
                  <li class="grid grid-cols-[3.5rem_1fr_auto] items-center gap-3 sm:grid-cols-[4.5rem_1fr_6rem]">
                    <span class:list={["font-display font-bold", lane.clanTag !== clan.tag && "text-muted"]}>[{lane.clanTag}]</span>
                    <span class:list={["meter meter-lg", lane.clanTag === clan.tag ? "meter-gal" : "meter-other"]} aria-hidden="true">
                      <i style={{ "--v": `${(lane.weightedWins / laneMax) * 100}%` }}></i>
                    </span>
                    <span class="tnum text-right text-sm font-semibold">{fmtScore(lane.weightedWins)}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {race && race.length > 0 && (
            <section class="reveal mb-8 scroll-mt-24" aria-labelledby="race-title" data-testid="rival-race">
              <h2 id="race-title" class="section-title scroll-mt-24">La course avec nos voisins</h2>
              <p class="mb-4 mt-2 max-w-3xl text-sm text-muted">Relevé chaque jour depuis le {fmtDate(`${snapshots[0]?.date}T12:00:00Z`)}.</p>
              <RivalRace client:load series={race} />
              <ReadingNote>
                <p>L'écart de score entre [{clan.tag}] et les clans les plus proches au classement. L'API ne donne pas le passé du classement : les courbes commencent au premier relevé. Chaque courbe a sa propre échelle : le tableau donne les valeurs exactes.</p>
              </ReadingNote>
            </section>
          )}
          {me && clans.length > 1 && (
            <section class="stage stage-night reveal" aria-labelledby="compare-title" data-testid="clan-compare">
              <h2 id="compare-title" class="section-title scroll-mt-24">Comparer un clan avec [{clan.tag}]</h2>
              <div class="mt-6">
                <ClanCompare client:load clans={clans} tag={clan.tag} faceOffs={meetings?.reliable ? meetings.rows : []} src={`${base}/classement-scores.json`} />
              </div>
              <noscript><p class="mt-3 text-sm text-muted">JavaScript est nécessaire pour changer de clan.</p></noscript>
              <p class="mt-4 max-w-3xl text-sm text-muted" data-testid="compare-rate-note">Un taux dépend surtout du format et du nombre de joueurs : il ne dit pas qui joue le mieux.</p>
              <details class="mt-6 max-w-3xl text-sm text-muted" data-testid="compare-notes">
                <summary class="cursor-pointer font-semibold">Comment lire ces chiffres</summary>
                <p class="mt-2">
                  Le rang, le score, les parties, les victoires, les défaites et leur rapport pondéré viennent de la liste officielle, sans recalcul ni note, sur 90 jours glissants, hors classé et hors Humains contre Nations. Le taux vaut victoires ÷ parties, et les joueurs par partie, sessions de joueurs ÷ parties. L'écart se relève une fois par jour : l'API ne donne pas le passé du classement. Un face-à-face n'apparaît qu'à partir de {FACE_OFF_MIN_MEETINGS} parties l'un contre l'autre, et seulement pour les clans du bloc suivant.
                </p>
              </details>
            </section>
          )}
          <FaceOffs />
        </>
      )
    }
  </div>
</Base>
