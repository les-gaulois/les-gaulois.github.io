---
import Base from "../layouts/Base.astro";
import ClanCompare from "../components/ClanCompare.tsx";
import DataStatus from "../components/DataStatus.astro";
import Empty from "../components/Empty.astro";
import PageHeader from "../components/PageHeader.astro";
import PageJumps from "../components/PageJumps.astro";
import ReadingNote from "../components/ReadingNote.astro";
import RivalRace from "../components/RivalRace.tsx";
import { clan } from "../../config/clan";
import { loadGames, loadLeaderboard, loadMeta, loadRivals, loadSessions } from "../lib/data";
import { fmtCount, fmtDate, fmtInt, fmtScore } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { FACE_OFF_MAX_ROWS, FACE_OFF_MIN_MEETINGS, faceOffs, MIN_CLAN_PLAYERS } from "../lib/games";
import { RESULTS_DAYS } from "../lib/results";
import { rivalSeries } from "../lib/rivals";
import { findClan, neighbours, withOfficialRanks } from "../lib/stats";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const leaderboard = loadLeaderboard();
const clans = leaderboard ? withOfficialRanks(leaderboard.clans) : [];
const me = findClan(clans, clan.tag);
const near = neighbours(clans, clan.tag);
const lanes = me && near ? [near.above?.clan, me, near.below?.clan].filter((c) => c !== undefined) : [];
const laneMax = Math.max(1, ...lanes.map((c) => c.weightedWins));
const snapshots = loadRivals();
const race = leaderboard && snapshots.length > 0 ? rivalSeries(leaderboard.clans, snapshots, clan.tag) : null;
const meetings = leaderboard ? faceOffs(loadSessions(), loadGames(), clan.tag, leaderboard.clans.map((c) => c.clanTag), meta.sessions.coveredUntil) : null;
const jumps = [
  { href: "#race-title", label: "La course", show: race !== null && race.length > 0 },
  { href: "#compare-title", label: "Comparer un clan", show: me !== null && clans.length > 1 },
].filter((jump) => jump.show);
---

<Base title="Nos rivaux" description="Les clans autour de GAL au classement officiel : la course jour après jour et le comparateur.">
  <div class="wrap">
    <PageHeader title="Nos rivaux">
      <div class="mt-4">
        <DataStatus state={meta.leaderboard} maxAgeHours={MAX_AGE_HOURS.leaderboard} asOf={leaderboard?.end} asOfLabel="Classement arrêté au" />
      </div>
      {jumps.length > 1 && <PageJumps links={jumps} />}
    </PageHeader>

    {
      !leaderboard ? (
        <Empty title="Classement indisponible">Aucun classement valide n'a encore été collecté.</Empty>
      ) : (
        <>
          {lanes.length > 0 && (
            <section class="chart-open reveal mb-section" data-testid="score-lanes" aria-labelledby="lanes-title">
              <h2 id="lanes-title" class="kpi-label">Le score autour de [{clan.tag}]</h2>
              {/* Les lignes partagent leurs colonnes (subgrid) : celle des tags prend la largeur du plus long, au moins 3,5 rem (4,5 rem
                  dès sm), et les barres commencent et finissent au même point. Dans l'onciale, la moitié des tags du classement ne tenaient
                  pas dans la colonne fixe sur téléphone, et [GAL] y tenait à peine. Sans subgrid (navigateurs d'avant 2023), tag, barre et
                  score s'empilent : c'est le repli voulu, lisible et sans débordement. */}
              <ul class="mt-4 grid grid-cols-[minmax(3.5rem,auto)_1fr_auto] gap-3 sm:grid-cols-[minmax(4.5rem,auto)_1fr_6rem]">
                {lanes.map((lane) => (
                  <li class="col-span-full grid grid-cols-subgrid items-center">
                    <span class:list={["font-display font-bold", lane.clanTag !== clan.tag && "text-muted"]}>[{lane.clanTag}]</span>
                    <span class:list={["meter meter-lg", lane.clanTag === clan.tag ? "meter-gal" : "meter-other"]} aria-hidden="true">
                      <i style={{ "--v": `${(lane.weightedWins / laneMax) * 100}%` }}></i>
                    </span>
                    <span class="tnum text-right text-sm font-semibold">{fmtScore(lane.weightedWins)}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {race && race.length > 0 && (
            <section class="reveal mb-section scroll-mt-24" aria-labelledby="race-title" data-testid="rival-race">
              <h2 id="race-title" class="section-title scroll-mt-24">La course avec nos voisins</h2>
              <p class="mb-4 mt-2 max-w-3xl text-sm text-muted">Relevé chaque jour depuis le {fmtDate(`${snapshots[0]?.date}T12:00:00Z`)}.</p>
              <RivalRace client:load series={race} />
              <ReadingNote>
                <p>L'écart de score entre [{clan.tag}] et les clans les plus proches au classement. L'API ne donne pas le passé du classement : les courbes commencent au premier relevé. Chaque courbe a sa propre échelle : le tableau donne les valeurs exactes.</p>
              </ReadingNote>
            </section>
          )}
          {me && clans.length > 1 && (
            <section class="stage stage-night reveal" aria-labelledby="compare-title" data-testid="clan-compare">
              <h2 id="compare-title" class="section-title scroll-mt-24">Comparer un clan avec [{clan.tag}]</h2>
              <div class="mt-6">
                <ClanCompare client:load clans={clans} tag={clan.tag} faceOffs={meetings?.reliable ? meetings.rows : []} src={`${base}/classement-scores.json`} />
              </div>
              <noscript><p class="mt-3 text-sm text-muted">JavaScript est nécessaire pour changer de clan.</p></noscript>
              {meetings && !meetings.reliable && (
                <p class="mt-4 max-w-3xl font-semibold text-warn" role="status" data-testid="compare-face-off-suspended">
                  Les face-à-face sont suspendus : {fmtInt(meetings.checkedDoubtful)} des {fmtCount(meetings.checked, "partie")} les plus récentes ne concordent pas avec les vainqueurs officiels. La façon dont le jeu forme les équipes a peut-être changé.
                </p>
              )}
              <p class="mt-4 max-w-3xl text-sm text-muted" data-testid="compare-rate-note">Un taux dépend surtout du format et du nombre de joueurs : il ne dit pas qui joue le mieux.</p>
              <details class="fold mt-6" data-testid="compare-notes">
                <summary>Comment lire ces chiffres</summary>
                <div class="max-w-3xl space-y-2 text-sm text-muted">
                  <p>
                    Le rang, le score, les parties, les victoires, les défaites et leur rapport pondéré viennent de la liste officielle, sans recalcul ni note, sur 90 jours glissants, hors classé et hors Humains contre Nations. Le taux vaut victoires ÷ parties, et les joueurs par partie, sessions de joueurs ÷ parties. L'écart se relève une fois par jour : l'API ne donne pas le passé du classement.
                  </p>
                  <p>
                    Un face-à-face compte, sur {RESULTS_DAYS} jours, les parties publiques en équipe où [{clan.tag}] et l'autre clan avaient chacun au moins {MIN_CLAN_PLAYERS} joueurs, dans des équipes différentes. Il n'apparaît qu'à partir de {FACE_OFF_MIN_MEETINGS} rencontres, pour les {FACE_OFF_MAX_ROWS} clans les plus rencontrés. L'API ne donne pas l'équipe des perdants : le site la calcule avec la règle du jeu, qui place tout un clan dans une seule équipe, et écarte une partie où ce calcul contredit les vainqueurs officiels.
                  </p>
                </div>
              </details>
              {/* Le face-à-face vient du détail des parties : sa date de mise à jour et ses pannes restent visibles. */}
              <div class="mt-4" data-testid="compare-games-status">
                <p class="info-discrete">Le détail des parties</p>
                <DataStatus state={meta.games} maxAgeHours={MAX_AGE_HOURS.games} />
              </div>
            </section>
          )}
        </>
      )
    }
  </div>
</Base>
