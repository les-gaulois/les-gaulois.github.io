---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageJumps from "../components/PageJumps.astro";
import { clan } from "../../config/clan";
import { fmtInt } from "../lib/format";
import { ANNOUNCED_TIERS, DISCORD_TIERS } from "../lib/paliers-franchis";
import { CODE_LOGIN_OPEN } from "../lib/compte/connexion-code";
import { AUTH_ENABLED } from "../lib/compte/api";
import { loadFilms } from "../lib/data";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Le paragraphe du vrai lecteur du jeu, seulement quand des parties y mènent (son site à part réglé et déposé).
const siteDuLecteur = (() => {
  const jeu = loadFilms()?.films.find((f) => f.jeu)?.jeu;
  return jeu ? new URL(jeu).host : null;
})();
const listOf = (tiers: readonly number[]) => {
  const words = tiers.map(fmtInt);
  return `${words.slice(0, -1).join(", ")} ou ${words.at(-1) ?? ""}`;
};
// La semaine (accueil et gazette) cite les paliers à partir de 100 ; Discord les annonce à partir de 50.
const weekTierList = listOf(ANNOUNCED_TIERS);
const discordTierList = listOf(DISCORD_TIERS);
// Le sommaire du haut : chaque grande partie, sous son titre exact, vers l'ancre de ce titre (un test vérifie qu'ils concordent).
const parties = [
  { href: "#membre-du-clan", label: "Si vous êtes membre du clan dans le jeu" },
  { href: "#serveur-discord", label: "Sur le serveur Discord du clan" },
  { href: "#sans-compte", label: "Sans compte" },
  ...(AUTH_ENABLED ? [{ href: "#compte-des-visites", label: "Le compte des visites" }] : []),
  { href: "#avec-un-compte", label: "Avec un compte" },
  { href: "#qui-peut-lire", label: "Où, et qui peut lire" },
  { href: "#effacer-ses-donnees", label: "Effacer ses données" },
];
---

<Base title="Confidentialité" description="Ce que le site du clan GAL publie sur ses membres, ce qu'il conserve pour la connexion Discord, et comment l'effacer.">
  <div class="wrap">
    <PageHeader title="Confidentialité" intro="Ce que le site publie sur les membres du clan, ce qu'il conserve pour la connexion Discord, et comment l'effacer.">
      <PageJumps links={parties} />
    </PageHeader>
    <div class="text-page max-w-3xl" data-testid="privacy">
      <h2 id="membre-du-clan" class="scroll-mt-24">Si vous êtes membre du clan dans le jeu</h2>
      <p>Le site reprend la liste officielle du clan, publique chez OpenFront : votre rôle, votre date d'arrivée, vos parties d'équipe sous le tag et, s'ils figurent dans cette liste, le niveau et le prestige de votre compte, que vous ayez un pseudo public ou non. Si vous cachez votre niveau dans OpenFront, le site ne le montre plus à la relecture suivante de la liste. Si vous avez un pseudo public, il affiche aussi ce pseudo, votre arrivée dans la gazette et sur l'accueil, et une fiche avec vos 10 dernières parties sous le tag : le jour, la carte, le format et le résultat. Avec la commande /fiche, tout membre du serveur Discord du clan peut montrer votre fiche dans un salon : son image, avec votre pseudo, votre place aux victoires dans le clan, vos victoires, vos défaites, votre taux et votre palier, le niveau et le prestige de votre compte s'ils figurent dans la liste, votre série de victoires en cours sous le tag à partir de 5 d'affilée (une flamme, aussi sur la page de votre fiche), et un lien vers elle ; le site ne garde rien de qui la demande. Avec la commande /moi, un membre validé sur le site montre sa propre fiche : le serveur retrouve son pseudo par le lien entre son compte Discord et son compte du site, sans rien garder. Votre arrivée peut aussi être saluée sur le serveur Discord du clan, avec votre pseudo, son heure et un lien vers votre fiche. Si vous êtes parmi ceux qui ont le plus de victoires ou le plus de parties dans la semaine, la gazette et l'accueil du site peuvent citer votre pseudo et ces nombres ; le podium des victoires peut aussi paraître sur le serveur Discord du clan. Si vous êtes parmi ceux qui ont joué le plus de parties sous le tag depuis le relevé de la veille, votre pseudo, ces parties et vos victoires peuvent être postés sur le serveur Discord du clan, avec un lien vers votre fiche. Si vous passez un palier de {weekTierList} victoires, votre pseudo et ce palier peuvent être cités sur l'accueil et dans la gazette. Les paliers de {discordTierList} victoires peuvent être annoncés sur le serveur Discord du clan, avec votre pseudo et un lien vers votre fiche. La page Records peut aussi citer votre pseudo sur ses podiums de 5 joueurs, avec votre plus longue série de victoires ou votre meilleure journée et leurs dates, et votre fiche montre votre série de victoires en cours et ses dates à partir de 5 d'affilée, avec les membres au pseudo public qui ont gagné une de ses parties avec vous (si votre pseudo est public, il paraît de même sur leur fiche), ainsi que votre meilleure série : pour cela, le site garde le résultat de chacune de vos parties sous le tag, hors de son code public. L'encadrement peut aussi vous choisir comme Gaulois de la semaine : votre pseudo et le mot qui l'accompagne paraissent alors sur l'accueil, sans le nom de qui vous a choisi. Ce choix reste gardé avec sa semaine, sauvegardes comprises : pour qu'un ancien choix soit effacé, demandez-le aux officiers. Votre fiche montre aussi vos victoires et vos défaites sous le tag selon le nombre de Gaulois dans la partie, et par format. Si vous êtes d'un des duos qui ont le plus gagné ensemble dans la semaine, vos deux pseudos, ces victoires et ces parties peuvent être postés sur le serveur Discord du clan, avec un lien vers vos fiches. Chaque victoire du clan peut aussi y être postée quelques minutes après la partie, avec la carte, le format, l'heure de début, la durée, le nombre de Gaulois et de joueurs, les points gagnés, les clans du classement officiel qui jouaient dans une autre équipe et un lien vers la partie sur OpenFront. Si vous avez joué cette partie sous le tag, vous y figurez sous le nom que vous portiez dans la partie, même sans pseudo public sur le site, et, si vous avez une fiche, avec un lien vers elle : pour cela, le site compare votre identifiant public à la liste du clan, ou lit les clans de votre fiche publique d'OpenFront, sans rien garder. L'image peut aussi montrer la carte de la fin de la partie, que le robot rejoue à partir de sa fiche publique chez OpenFront : vos territoires y sont en bleu, sans votre nom. Pour cela, le robot lit l'identifiant que vous aviez dans cette partie, et garde un jour, dans l'espace de travail de GitHub, public comme le code du site, l'état de la carte avec les identifiants de partie et les équipes des joueurs, déjà publics dans la fiche de la partie, sans aucun nom. Un message déjà posté sur Discord n'est pas retiré automatiquement : pour en faire retirer un, demandez-le aux officiers. La fiche n'est pas proposée aux moteurs de recherche, mais tout le monde peut l'ouvrir. Ces données viennent de l'API publique d'OpenFront : le site ne lit rien qui demande un compte.</p>
      <p>Sans pseudo public, vous restez « Membre anonyme » sur le site : ni fiche, ni identifiant. Seul le message d'une victoire, sur le serveur Discord du clan, peut citer le nom que vous portiez dans la partie. Si vous quittez le clan ou retirez votre pseudo, votre fiche, vos parties gardées pour les podiums ou pour les plus actifs du jour, et votre nom dans la gazette, sur l'accueil, sur la page Records et sur la fiche des autres membres disparaissent à la relecture de la liste, une fois par jour. Si vous supprimez votre compte OpenFront, ils disparaissent dès que la collecte horaire le voit dans la liste des comptes supprimés. Les anciennes versions de la liste des membres, avec le pseudo, le rôle, la date d'arrivée, les parties d'équipe et le niveau du compte, et celles des relevés de victoires et de parties du lundi et de la veille, des paliers franchis dans la semaine et du palier atteint par chaque membre avec pseudo, restent dans l'historique public du code du site.</p>

      <h2 id="serveur-discord" class="scroll-mt-24">Sur le serveur Discord du clan</h2>
      <p>Quand vous rejoignez le serveur Discord du clan, son robot peut remplacer le message d'arrivée de Discord par une image de bienvenue, postée dans le même salon. Elle porte votre nom affiché sur Discord et votre photo de profil, que les membres du serveur voient déjà ; sans photo, l'initiale de votre nom. Le robot les lit chez Discord peu après votre arrivée, à son passage suivant, et ne les garde nulle part : ni sur le site, ni dans son code public. Le nom du fichier de l'image porte le numéro de votre compte Discord, que tout membre du serveur peut déjà lire. De ce salon, il reçoit la liste des derniers messages, avec leur auteur et leur type, et n'en retient que les messages d'arrivée et ses propres images : il ne lit jamais ce que les membres écrivent. Juste après, il vous salue aussi dans le salon général du serveur : il vous y mentionne, ce qui vous envoie une notification, avec une seconde image à votre nom et avec votre photo, quelques conseils pour commencer et un lien vers le salon des tickets. Pour trouver ces deux salons, il lit la liste des salons du serveur, avec leur nom et leurs droits, sans rien en garder, et rien de ce qui s'y écrit. Les deux images ne changent pas si vous changez ensuite de nom ou de photo, et elles restent dans leur salon si vous quittez le serveur. Pour en faire retirer une, demandez-le aux officiers.</p>
      <p>Les boutons du panneau des rôles, posté par le robot sur ce serveur, donnent ou retirent un rôle d'alerte (Rassemblement, Giveaway, Tournois, Membre GAL) au membre qui clique. Discord envoie alors au robot votre identifiant et votre nom Discord, et la liste de vos rôles du moment : il change le rôle demandé, vous répond à vous seul, et ne garde rien, ni sur le site ni dans son code public. Le journal des actions du serveur, que lit l'encadrement, note chaque rôle donné ou retiré.</p>
      <p data-testid="privacy-tickets">Si vous ouvrez un ticket au guichet du serveur, le robot crée un salon que seuls voient vous et ceux qui voient la catégorie des tickets, en général l'encadrement. Il y écrit vos réponses au formulaire, et les note, avec votre nom Discord et l'heure, dans un salon journal privé, choisi par l'encadrement, où s'ajoutent à la fermeture qui a fermé le ticket et pourquoi. Le robot ne lit pas ce que vous écrivez ensuite dans le salon. À la fermeture, le salon et ses messages sont supprimés ; le journal reste sur Discord. Le site, lui, n'en garde rien. Pour faire retirer une entrée du journal, demandez-le aux officiers.</p>
      <p>Si vous participez à un concours que l'encadrement lance sur le serveur, le site garde le numéro de votre compte Discord, l'heure de votre clic et le numéro de votre billet, donné dans l'ordre des inscriptions, pour vous compter, vous retirer si vous le demandez et vous tirer au sort. Les membres du serveur peuvent voir la liste des participants. Au tirage, le robot demande à Discord si chaque personne tirée au sort est encore sur le serveur et a encore le rôle demandé ; s'il passe quelqu'un, le site garde son numéro et la raison. La liste des participants, et le numéro des personnes passées ou remplacées par un nouveau tirage, sont effacés 30 jours après le tirage, ou dès l'annulation du concours. Le numéro des gagnants, avec leur billet et la confirmation qu'ils donnent d'un clic, et celui de qui a lancé ou annulé le concours, restent avec le concours un an après sa fin. Le site ne garde ni votre nom ni votre photo. Pour faire effacer plus tôt ce qui vous concerne, ou retirer un message du concours, demandez-le aux officiers.</p>

      <p id="coffre" class="scroll-mt-24" data-testid="privacy-coffre">Si vous jouez au coffre du druide avec la commande /coffre, tout le salon voit ce que vous écrivez au gardien du coffre, et sa réponse. Le gardien est joué par Claude, l'intelligence artificielle d'Anthropic : à chaque essai, le robot envoie à Anthropic votre message, le nom que vous portez sur le serveur Discord, et les derniers échanges de la manche avec le nom de leurs auteurs, pour qu'il réponde ; jamais votre identifiant Discord, ni votre Gaulois, ni vos statères. Pour compter vos essais du jour et désigner le gagnant, le site garde votre identifiant et votre nom Discord, votre message, la réponse et l'heure, pendant 30 jours ; ils sont effacés chaque nuit, passé ce délai. Si vous gagnez une manche, votre identifiant, votre nom et l'heure restent avec elle ; et quand c'est votre message qui a fait dire le mot au gardien, ce message aussi : le gardien le relit aux manches suivantes, il est donc renvoyé à Anthropic. Si vous avez un compte validé sur le site avec votre Gaulois, le robot le retrouve par votre identifiant Discord pour dessiner votre Gaulois face au gardien, sur l'image jointe à la réponse : tout le salon le voit. Si vous choisissez de miser des statères, la mise et, si vous gagnez, la cagnotte reçue s'écrivent au journal de vos statères, gardé jusqu'à l'effacement de votre compte ; le salon lit votre mise et la cagnotte gagnée. La commande /perceurs montre à tout le salon les trois membres qui ont ouvert le plus de coffres depuis lundi, avec le nom sous lequel ils ont gagné, leur Gaulois et, en fond, la bannière qu'ils ont choisie pour lui ; celui qui est en tête peut recevoir sur Discord le rôle « Perceur de coffres », et le site garde son identifiant Discord tant qu'il reste en tête. Aucune page du site ne montre ces données : seuls le robot et la direction, dans la base, peuvent les lire. Un message déjà posté reste sur Discord, où les modérateurs du salon peuvent le retirer. Pour faire effacer vos essais, demandez-le aux officiers.</p>

      <h2 id="sans-compte" class="scroll-mt-24">Sans compte</h2>
      <p>Le site ne vous demande rien et ne pose pas de traceur publicitaire. D'un simple visiteur, il ne conserve rien qui permette de le reconnaître{AUTH_ENABLED ? " : il compte seulement les visites, décrit plus bas" : ""}. Pour un joueur du clan, il y a une autre exception que la liste ci-dessus : si vous avez donné des capsules à [GAL] dans le jeu, le montant, la date et une empreinte de votre identifiant OpenFront peuvent figurer dans une liste des dons recopiée par les officiers pour un ancien jeu du site. Ni votre identifiant, ni votre pseudo. Cette liste n'est plus complétée ni affichée. Pour faire retirer un don, adressez-vous aux officiers.</p>

      <p>Votre navigateur peut garder, sur votre appareil seulement : l'identifiant public du membre que vous choisissez de retenir pour retrouver sa place, la date de votre dernière visite et les chiffres du clan vus ce jour-là, pour vous dire ce qui a changé et reprendre le film de la carte où vous l'aviez laissé, vos propres chiffres vus ce jour-là si vous avez retenu votre pseudo, la dernière mise à jour du site que vous avez vue, pour signaler les suivantes d'un point, votre choix de mettre les animations en pause, votre choix du thème clair ou sombre{AUTH_ENABLED ? ", et la marque du compte des visites" : ""}. Pour le petit Gaulois qui vous suit sur les pages, votre navigateur garde aussi s'il est en prison ou posé et, le temps de l'onglet, sa place, ses images et s'il vous a déjà salué{AUTH_ENABLED ? ", et, si vous êtes connecté, la tenue de votre Gaulois avec l'identifiant interne de votre compte sur le site, effacés à la déconnexion" : ""}. Rien de cela n'est envoyé au site{AUTH_ENABLED ? ", sauf les réponses par oui ou non du compte des visites, décrit juste après" : ""}. Pour l'effacer, utilisez « Changer de pseudo » ou videz les données du site dans votre navigateur.</p>

      {siteDuLecteur && <p data-testid="privacy-replay">Le replay du jeu de « Revoir une partie » est le lecteur d'OpenFront lui-même, montré dans un cadre de la page mais servi par le clan sur un site à part ({siteDuLecteur}, hébergé par GitHub), sans publicité ni mesure d'audience : il ne voit ni votre connexion ni ce que ce site garde dans votre navigateur. Dès que la page montre une partie qui l'a, il se charge et lit les images, les cartes et les sons du jeu sur jsDelivr, le service public qui recopie le dépôt du jeu sur GitHub : GitHub et jsDelivr reçoivent donc l'adresse IP de votre connexion, comme tout service qui vous répond. Ce lecteur garde dans votre navigateur ses réglages et les parties déjà préparées (jusqu'à 256 Mo, les plus anciennes effacées d'abord), pour les rouvrir plus vite ; rien n'en est envoyé à ce site ni au sien. Il montre les pseudos des joueurs tels que la fiche publique de la partie les donne, sans leur identifiant.</p>}

      {
        AUTH_ENABLED && (
          <>
          <h2 id="compte-des-visites" class="scroll-mt-24">Le compte des visites</h2>
          <p data-testid="privacy-visits">Pour que l'encadrement sache si le site sert, chaque page ouverte ajoute un aux totaux du jour, que seul l'encadrement lit, dans l'espace Direction : pages vues par page et par heure, visiteurs du jour, de la semaine et du mois. Pour ne compter votre navigateur qu'une fois, il garde une marque, deux dates seulement : celle de sa dernière visite comptée et celle où la marque a été posée. Elle ne vit pas plus de 13 mois, même si vous revenez chaque jour ; une nouvelle est alors posée. Il en tire des réponses par oui ou non qui partent avec la page : première visite du jour, de la semaine, du mois, ou première visite tout court, selon qu'il porte déjà une trace du site. À la première page du jour s'ajoutent la famille du site d'où vous arrivez (Discord, Google, OpenFront…, jamais son adresse), si votre écran est tactile et si une session du site est ouverte dans ce navigateur. Le serveur du site n'en garde que des totaux, sans cookie, sans identifiant, sans votre adresse IP, rien qui distingue un visiteur d'un autre, et sans limite de durée puisqu'ils ne disent rien de personne. Comme tout serveur, il reçoit l'adresse IP de votre connexion pour vous répondre : le site ne la lit pas et ne la garde pas ; Supabase, son hébergeur, peut la noter un temps dans ses journaux techniques. Rien n'est compté si votre navigateur demande de ne pas être suivi (Global Privacy Control ou Do Not Track), ni dans un navigateur où vous refusez ici :</p>
          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2" data-visites-choix hidden>
            <span data-visites-bouton-boite>
              <button type="button" class="btn btn-ghost" data-visites-bouton>Ne plus compter mes visites</button>
            </span>
            <p class="m-0" role="status" data-visites-etat></p>
          </div>
          </>
        )
      }

      <h2 id="avec-un-compte" class="scroll-mt-24">Avec un compte</h2>
      <ul>
        <li><strong>Votre identifiant et votre nom Discord,</strong> et l'adresse e-mail que Discord transmet à la connexion. Ils servent à vous connecter et à ce qu'un officier vous reconnaisse. Votre identifiant et votre adresse ne sont jamais affichés publiquement. Seul cas où d'autres membres validés peuvent lire votre identifiant : si vous choisissez de vous montrer au QG, décrit plus bas. Votre nom Discord ne leur est montré sur le site que si vous devenez parrain ; votre nom d'utilisateur Discord paraît aussi sur le serveur Discord du clan, sur l'image des objets que vous recevez au village (voir votre Gaulois du village, plus bas).</li>
        {CODE_LOGIN_OPEN && (
          <li data-testid="privacy-code"><strong>Si vous vous connectez avec un code demandé dans le Discord du clan :</strong> par ce chemin, le site ne garde que votre identifiant et votre nom d'utilisateur Discord. Un compte ouvert avec un code n'a donc ni votre adresse e-mail, il en reçoit une inventée qui ne mène nulle part, ni votre photo : au QG, votre initiale la remplace. Un compte ouvert d'abord avec Discord garde ce que dit le point précédent. Le code n'est gardé que par son empreinte, il ne sert que cinq minutes, et la trace de sa demande s'efface au bout d'un jour. Un code faux essayé sur le site ne laisse que son heure, effacée dans les vingt minutes.</li>
        )}
        <li><strong>Si vous faites partie de l'encadrement du clan :</strong> la direction peut noter à l'avance votre identifiant Discord et votre rôle, avant même votre première connexion, pour vous donner ce rôle à votre validation. Cette note est effacée dès qu'elle a servi.</li>
        <li><strong>Si vous faites partie de l'encadrement, les messages Discord que vous envoyez depuis la Direction.</strong> Le serveur garde chacun, sans limite de durée, avec votre nom, son salon et son heure, pour que l'encadrement les retrouve et puisse les retirer du salon ; effacer votre compte en retire votre nom. Les images jointes sont déposées dans un espace public du serveur : qui a leur adresse peut les voir, comme dans le salon Discord. Le site ne les efface jamais, même avec votre compte : un message posté les montre. Le message en cours d'écriture reste dans votre navigateur jusqu'à son envoi, à « Tout effacer » ou à la déconnexion.</li>
        <li><strong>Une empreinte de votre identifiant OpenFront,</strong> jamais l'identifiant lui-même, pour vérifier votre présence dans la liste des membres, éviter qu'un même joueur ait deux comptes et, si vous choisissez de vous montrer, mettre votre photo à côté de votre pseudo du moment.</li>
        <li><strong>Votre nom sur le site :</strong> votre pseudo public OpenFront si vous en avez un, sinon « Gaulois n° … ». Il n'est visible que de vous et de l'encadrement, sauf si vous choisissez de vous montrer au QG, d'y proposer une idée, d'y prévenir les Gaulois de votre salon, d'y faire un pronostic, d'y être parrain, ou de créer votre Gaulois : les membres validés peuvent alors le lire sous ce nom, et il paraît au marché quand vous vendez. Les objets que vous recevez pour votre Gaulois sont annoncés sur le serveur Discord du clan sous votre nom d'utilisateur Discord : voir votre Gaulois du village, plus bas.</li>
        <li><strong>Au QG, l'espace réservé aux membres validés, votre choix « Me montrer », dans l'onglet Le mur.</strong> Il est désactivé au départ et se retire d'un clic. Activé, les autres membres validés voient votre nom sur le site, votre rôle et votre photo de profil Discord, sur le mur et quand vous répondez « Je viens ». Connectés, ils voient aussi cette photo à côté de votre pseudo sur les pages du site : podiums de l'accueil et de la gazette, records, encadrement, votre fiche. Les visiteurs ne la voient jamais : elle n'est écrite dans aucune page publiée. Le site ne recopie pas cette photo : il lit son adresse dans votre connexion Discord, et le navigateur de chaque membre validé la charge depuis les serveurs de Discord. Cette adresse contient votre identifiant Discord : un membre validé peut donc le lire tant que vous vous montrez. Sans photo choisie sur Discord, seule l'initiale de votre nom s'affiche.</li>
        <li><strong>Vos idées dans la boîte à idées du QG :</strong> leur texte, leur date et votre nom sur le site, visibles des membres validés, avec la décision de l'encadrement. Vous retirez une idée quand vous voulez ; l'encadrement peut aussi la retirer. Vos soutiens aux idées des autres sont gardés avec votre compte pour ne compter qu'une fois : le site n'en montre que le nombre, jamais qui soutient quoi.</li>
        <li><strong>Pour les officiers et les admins,</strong> leurs actions d'administration dans un journal : qui, quoi, quand.</li>
        <li><strong>Vos réponses « Je viens » aux événements.</strong> L'encadrement voit qui vient ; sur l'accueil, tout le monde ne voit que le nombre ; au QG, les membres validés voient en plus ceux qui ont choisi de se montrer. Une réponse disparaît quand vous la retirez, quand l'événement est supprimé ou quand vous effacez votre compte.</li>
        <li><strong>Vos appels « Prévenir les Gaulois », au QG.</strong> Le site garde l'identifiant de la partie d'OpenFront que vous avez collée, jamais l'adresse elle-même. Les membres validés connectés voient l'appel sur les pages du site, avec votre pseudo, et votre photo Discord seulement si vous avez choisi de vous montrer, pendant 15 minutes au plus ou jusqu'à ce que vous le retiriez. Un quart d'heure après l'appel, sa ligne est effacée dès qu'un membre validé ouvre une page du site, ou au premier appel qui suit. Les appels ne sont pas sauvegardés. Votre navigateur garde, pour lui seul, votre choix du son et les appels que vous avez fermés. Si l'encadrement a branché un salon Discord du clan, et le formulaire le dit alors, chaque appel y est aussi posté par le site : votre pseudo, le lien du salon et l'heure de fin, avec la mention d'un rôle du clan si vous demandez un ping. Pour l'anti-spam, le site garde l'heure de votre dernier ping, jusqu'à la suivante ou à l'effacement de votre compte. Ce message est effacé si vous retirez l'appel, ou si vous en lancez un autre avant sa fin ; sinon, il reste dans le salon Discord, que ses membres lisent selon les règles de Discord. La réponse de Discord, qui reprend ce message, reste six heures au plus sur le serveur du site. Effacer votre compte ne retire pas ces messages de Discord, où les modérateurs du salon peuvent les supprimer.</li>
        <li><strong>Les outils du QG.</strong> « Ce soir je joue » : l'heure que vous annoncez ; jusqu'à la fin de cette heure, les membres validés voient combien de membres viennent, et votre nom et votre photo Discord seulement si vous vous montrez. Les GG : le site garde qui remercie qui, pour ne compter qu'un merci par semaine, et n'en montre que le nombre, jamais qui remercie qui. Parrain : si vous l'activez, les membres validés voient votre nom sur le site, votre rôle et votre pseudo Discord, pour vous écrire ; votre photo, seulement si vous vous montrez. Pronostic : votre nombre de victoires et votre mise en statères. Votre mise est visible des membres validés sous votre nom dès qu'elle est posée, votre nombre de victoires une fois les pronostics clos, puis ce que la cagnotte vous a versé ; si votre compte est suspendu, votre mise reste dans la cagnotte sous « Compte suspendu », sans votre nom. Votre solde n'est jamais montré, mais une mise dit que vous aviez au moins cette somme. La mise, le gain ou le remboursement restent au journal de vos statères, avec la semaine, jusqu'à l'effacement de votre compte, et vont dans la sauvegarde avec lui ; effacer son compte avant le règlement fait perdre sa mise. Une heure finie, puis les GG et les pronostics à la fin de la semaine qui suit la leur, s'effacent dès qu'un membre validé ouvre le QG. L'onglet « Moi » lit votre pseudo d'aujourd'hui dans la liste du clan et vos chiffres publics, sans rien garder de plus.</li>
        <li id="village" class="scroll-mt-24" data-testid="privacy-village"><strong>Votre Gaulois,</strong> si vous en créez un (c'est la dernière étape de l'inscription, après le lien de votre profil OpenFront : sans lui, le QG, la carte de l'alliance, la forge et le marché restent fermés) : la tenue choisie (peau, cheveux et leur couleur, barbe, yeux, bouche, cicatrice, habits et arme, et le Gaulois unique qu'il porte, s'il en porte un), la date de sa création et celle de son dernier changement, gardées avec votre compte jusqu'à ce que vous la changiez ou effaciez votre compte. Avec la commande /gaulois, vous montrez son image à tout le salon Discord où vous la tapez : le robot retrouve votre compte par votre identifiant Discord, dessine l'image et ne garde rien de plus. Si votre compte est validé et votre pseudo OpenFront public, l'image montre aussi, comme votre fiche, le niveau et le prestige de votre compte et votre série de victoires en cours à partir de 5 d'affilée. L'image le montre devant un lieu du village, sous la lumière de l'heure de Paris : au champ de bataille ou à la taverne dans les 3 heures qui suivent le début d'une partie qui a rapporté des points au clan (seulement si votre compte est validé et votre pseudo OpenFront public), dans la salle de réunion si vous étiez en vocal au dernier relevé (compte validé seulement), dans sa maison de 23 heures à 7 heures, sinon sur la place. Tout le salon voit donc ce lieu : au champ de bataille ou à la taverne, il peut relier votre compte Discord à votre pseudo OpenFront. Une image déjà postée reste sur Discord, où les modérateurs du salon peuvent la retirer. Pour le sentier (les missions du jour de « Mon Gaulois »), le serveur garde 8 jours, pour chaque partie jouée sous le tag du clan, l'empreinte de l'identifiant de chaque joueur présent, jamais l'identifiant, et les jours où le robot vous a vu dans un salon vocal du clan ; et, jusqu'à l'effacement de votre compte, vos jours de visite de « Mon Gaulois », vos pas et les objets reçus aux paliers. Pour les statères, la monnaie de votre Gaulois, le serveur garde, pour chaque partie qui a rapporté des points au clan, l'identifiant de la partie, son heure de début, ses points, le nombre de Gaulois et l'empreinte de l'identifiant OpenFront de chaque Gaulois qui l'a jouée, avec ou sans compte sur le site, et l'heure où sa part a été versée à un compte, jusqu'à la fin du mois qui suit la partie ; si votre compte est validé et que vous avez créé votre Gaulois, il garde aussi chacun de vos crédits (la partie, son heure, ses points, le nombre de Gaulois et les statères reçus) et votre solde, qu'aucune page ne montre à un autre que vous, jusqu'à l'effacement de votre compte ; l'encadrement lit les totaux du village, sans aucun nom (statères distribués, dépensés et gardés, objets achetés, pochettes ouvertes) : quand peu de comptes ont des statères, un total peut redonner votre solde ou vos achats ; la sauvegarde chiffrée garde votre solde et le total de vos crédits, sans la liste de vos parties. Si votre compte est suspendu, il garde le début et la fin de la suspension, pendant laquelle vos parties ne rapportent pas de statères, jusqu'à la fin du mois qui suit sa levée. Les objets que vous achetez à la boutique, tirez d'une pochette surprise ou échangez au marché sont gardés avec votre compte, avec chaque achat et chaque vente ; de même, depuis le 15 novembre 2026, les familiers que vous tirez de la pochette des familiers, l'heure où vous les avez reçus et celui que vous montrez à côté de votre Gaulois : seul vous voyez sur le site ceux que vous avez, et le familier que vous montrez paraît sur l'image de /gaulois quand vous tapez la commande et, depuis le 16 novembre 2026, à côté de votre Gaulois dans la vitrine de « Mon Gaulois » (voir plus bas) ; de même encore, les bannières que vous achetez à la boutique, l'heure de chaque achat et celle que vous montrez sur /gaulois, qui y remplace le décor de votre lieu (le lieu n'est alors plus dit sur l'image) : seul vous voyez celles que vous avez, et celle que vous montrez paraît aussi derrière votre Gaulois dans la vitrine ; de même enfin, les Gaulois uniques que vous achetez à la boutique ou tirez de leur pochette, et l'heure où vous les avez reçus ; une offre au marché montre aux membres validés l'objet, son prix et votre nom du QG. Chaque objet, familier, bannière ou Gaulois unique que vous recevez ainsi, si votre compte est validé, est annoncé par le robot du clan sur un salon du serveur Discord choisi par l'encadrement (le salon des nouvelles, s'il n'en a pas choisi d'autre), qui peut être vu hors du clan, quelques minutes après, et pas plus de 48 heures après : une image avec votre nom d'utilisateur Discord précédé de « @ », celui que le site a relu chez Discord à votre dernière connexion, qui peut dater de plusieurs semaines (s'il est illisible, votre pseudo OpenFront public d'aujourd'hui, ou « Gaulois n° » et le numéro de votre compte), l'objet, le familier, la bannière ou le Gaulois unique, sa rareté, d'où il vient (boutique, pochette surprise, pochette des familiers, pochette des Gaulois uniques ou marché) et son heure. Elle ne dit ni le prix payé, ni votre solde, ni le vendeur ; mais la rareté donne le prix de la boutique (celui d'une bannière est le triple de celui d'un objet de sa rareté, celui d'un Gaulois unique va de 11 500 à 28 000 statères selon sa rareté depuis le 16 novembre 2026, de 500 à 12 500 avant), « pochette des familiers » ou « pochette des Gaulois uniques » dit que vous avez payé le prix de cette pochette (2 000 statères au départ pour les familiers ; pour les Gaulois uniques, 2 000 le 15 novembre 2026, puis 3 000 ; quand cette pochette rend une part de son prix, ce n'est jamais annoncé, mais la somme rendue et son heure restent au journal de vos statères, comme le prix payé, jusqu'à l'effacement de votre compte, et partent dans la sauvegarde chiffrée), donc que vous aviez au moins cette somme, et si vous vendez au marché, un membre qui avait vu votre offre peut, à l'annonce de l'acheteur, en déduire que vous l'avez vendue et à quel prix. Comme les membres validés peuvent lire votre Gaulois et ses objets avec votre nom du QG, et que, si votre pseudo OpenFront est public, il paraît sur les autres images du robot à côté de ce pseudo, qui voit les deux peut relier votre nom Discord à votre nom du QG, et à votre pseudo OpenFront public. Il n'y a pas de réglage pour s'en retirer. Pour les lire, le robot demande au serveur les achats faits depuis son dernier passage, et ne garde, dans le code public du site, que des numéros du journal des statères et l'heure de son dernier envoi, sans nom ni objet. Une image déjà postée reste sur Discord, où les modérateurs du salon peuvent la retirer. Si vous gravez à la forge une de vos parties qui ont rapporté des points au clan sur un objet de votre Gaulois, le serveur garde avec cet objet le jour de la partie, le nombre de Gaulois qui l'ont jouée et ses points, sans l'identifiant ni l'heure de la partie, et l'heure de la gravure, jusqu'à ce que vous effaciez ou remplaciez la plaque, ou effaciez votre compte ; le paiement de chaque gravure (l'objet et l'heure) reste au journal de vos statères jusqu'à l'effacement de votre compte, même une fois la plaque effacée. Vous voyez toujours vos plaques ; les membres validés et l'encadrement peuvent lire, par le serveur du site, celles des objets que porte votre Gaulois, seulement si votre pseudo OpenFront est public, car le jour et les points d'une partie permettraient sinon de retrouver votre compte OpenFront. Dès que vous créez votre Gaulois et que votre compte est validé, les membres validés et l'encadrement peuvent le voir, avec votre nom du QG, le familier et la bannière que vous montrez, dans la vitrine de « Mon Gaulois », où paraissent tous les Gaulois des comptes validés (depuis le 16 novembre 2026 ; avant le 15 novembre 2026, sur la place du village) : il n'y a pas de réglage pour l'en retirer, et le choix de vous montrer ou non aux autres membres, fait dans le QG, ne vaut pas pour votre Gaulois. Seul l'effacement de votre compte l'en retire. Pour le fond de l'image de /gaulois, le robot du clan regarde toutes les 5 minutes si vous êtes dans un salon vocal ouvert à tous du serveur Discord du clan ; un salon privé ne compte pas. Il ne lit que cela : ni vos messages, ni ce que vous dites, ni votre statut. Le site garde seulement « en vocal ou non » et l'heure du relevé, le donne aux membres validés pendant 15 minutes, et l'efface au bout de 24 heures. Le serveur donne aussi aux membres validés l'heure de début de votre dernière partie qui a rapporté des points au clan, si elle a moins de 24 heures et si votre pseudo OpenFront est public, ce qui montre aux membres validés que ce compte du site est le vôtre : elle vient des crédits de statères déjà gardés, sans nouvelle lecture d'OpenFront. Les petites phrases que Claude, l'intelligence artificielle d'Anthropic, écrivait pour les Gaulois de la place ne sont plus demandées depuis le 15 novembre 2026 ; les dernières s'effacent du serveur au bout de 24 heures. Si votre compte est validé, que votre pseudo OpenFront est public et que vous avez créé votre Gaulois, son image paraît à côté de votre pseudo, ou de votre nom dans la partie pour une victoire, sur les images que le robot du clan poste sur Discord (victoires, plus actifs, paliers, bienvenue, Jouer ensemble, gazette, et le salut d'un nouveau venu dans le salon général, où quelques Gaulois tirés au sort parmi les membres le saluent, leur pseudo écrit au-dessus), sur l'image de votre fiche et sur l'image d'aperçu de l'accueil : ces images sont vues hors du clan. Pour les dessiner, le robot demande au serveur les tenues des membres au pseudo public de la liste du clan, par l'empreinte de leur identifiant OpenFront, et ne les garde pas une fois les images faites. Un membre au pseudo caché n'a jamais de Gaulois sur ces images. La loterie du lundi : si votre compte est validé et que vous avez créé votre Gaulois, les membres validés voient, dans l'onglet « La loterie », votre nom sur le site, votre Gaulois, la bannière que vous montrez, vos billets de la semaine (un par point rapporté au clan, arrondi) et ceux que vous avez achetés, puis les gagnants de chaque tirage ; le serveur garde vos achats de billets et chaque tirage huit semaines, et vos pochettes gagnées jusqu'à leur ouverture ; votre journal des statères, lui, garde les billets payés et les lots reçus tant que votre compte existe, comme vos autres mouvements.
</li>
        <li id="carte-alliance" class="scroll-mt-24" data-testid="privacy-alliance"><strong>La carte de l'alliance, sur la page Carte,</strong> réservée aux membres validés et aux joueurs des clans alliés que l'encadrement invite. Pour un joueur invité : son clan, le nom qu'il choisit pour la carte et la date de son entrée ; l'encadrement voit en plus son nom Discord, pour le reconnaître avant de l'accepter, et note qui l'a accepté. Le lien d'invitation n'est gardé que par son empreinte ; l'invitation, avec le pseudo noté par l'encadrement, s'efface 30 jours après avoir servi ou expiré. Le journal de l'encadrement ne garde de votre demande, de son accord ou de son refus, de votre départ ou du retrait de votre accès que votre clan et votre compte, jamais votre nom choisi. Vos messages dans la discussion de l'alliance : leur texte, leur heure, votre nom et votre clan, lus par tous ceux qui ont accès à cette carte, effacés au bout de 30 jours, ou avant par vous ou par l'encadrement. Les troupes que vous déclarez pour votre clan : le nombre, votre nom et l'heure, jusqu'à la déclaration suivante ou l'effacement de votre compte. Les zones : le nom sur la carte de qui a dessiné ou modifié une zone en dernier, joueur allié ou Gaulois, s'affiche à côté d'elle tant qu'il a accès à la carte ; le nom d'une zone qu'un joueur allié dessine reste au journal de l'encadrement. Une zone qu'un joueur allié crée ou modifie attend l'accord de l'encadrement : en attendant, seuls l'encadrement et les joueurs de son clan voient ce dessin, et les autres voient encore la version déjà acceptée s'il y en a une ; refusée, une zone nouvelle est effacée et une zone modifiée retrouve sa version acceptée, et le journal ne garde que son nom, son clan et le compte qui l'a dessinée. Votre navigateur garde, pour lui seul, le numéro du dernier message lu et la langue choisie pour la fenêtre, français ou anglais.</li>
        <li><strong>Votre vote à chaque sondage,</strong> gardé avec votre compte pour qu'il ne compte qu'une fois et que vous puissiez le changer. Aucune page du site ne montre qui a voté quoi, pas même à l'encadrement : seulement les totaux, que seuls les membres validés lisent, au QG. Il disparaît avec le sondage ou avec votre compte.</li>
        <li><strong>Pour l'encadrement, le choix de voir le site comme un joueur,</strong> gardé dans votre navigateur seulement et jamais envoyé au site. « Quitter la vue joueur » ou la déconnexion l'effacent.</li>
        <li><strong>Ce qui reste de l'ancien jeu :</strong> si vous y avez déclaré des dons ou joué, ces données restent dans la base sans être affichées, jusqu'à ce que le clan les supprime.</li>
      </ul>

      <h2 id="qui-peut-lire" class="scroll-mt-24">Où, et qui peut lire</h2>
      <p>Les données sont hébergées chez Supabase, en Europe. La connexion passe par Discord. Chaque membre ne lit que ses propres données ; les officiers et les admins voient ce qu'il leur faut pour valider les comptes et savoir qui vient à un événement. Les membres validés, et eux seuls, lisent le QG : les appels aux salons, les sondages et leurs totaux, les idées, les heures annoncées, les GG, les parrains, les pronostics clos, et les membres qui ont choisi de se montrer. Ils peuvent aussi lire le Gaulois de tout membre validé qui a créé le sien (voir « Votre Gaulois », plus haut). Rien du QG n'est écrit dans les pages publiques du site : le navigateur d'un membre validé connecté le demande au serveur, puis y place les photos de ceux qui se montrent. Les photos de profil viennent des serveurs de Discord : votre navigateur les leur demande, sans leur donner l'adresse de la page. Quand une demande attend, et après chaque sauvegarde, un salon Discord privé de l'encadrement en est prévenu, sans aucun nom ni donnée personnelle. Les appels aux salons, eux, partent avec le pseudo de qui appelle dans le salon Discord que l'encadrement a choisi, s'il en a branché un. Les joueurs des clans alliés invités ne lisent que la carte de l'alliance, avec les membres validés : les alliances, les zones à prendre, les troupes déclarées et la discussion, jamais le QG.</p>
      <p>Dès que la direction a posé sa phrase de passe, une sauvegarde chiffrée est faite chaque lundi. Elle contient votre compte et votre rôle, votre identifiant et votre nom Discord, vos demandes, le journal d'administration, les publications, vos réponses « Je viens », votre choix de vous montrer au QG, vos idées, les Gaulois de la semaine, les alliances, leurs zones, les joueurs alliés et les troupes déclarées, et, du village, votre Gaulois et sa tenue, vos objets, vos familiers, vos bannières et vos Gaulois uniques, vos achats et vos ventes, vos offres au marché, votre solde de statères et le total de vos crédits, sans la liste de vos parties. Les heures annoncées, les GG, les parrains, les pronostics, l'objectif de la semaine, le lien du salon vocal, les messages Discord de l'encadrement, les concours, la discussion de l'alliance, les invitations et les plaques de la forge n'y sont pas. Des sondages, elle ne garde que les totaux, jamais qui a voté quoi ; des soutiens aux idées, que leur nombre. Elle ne contient ni l'empreinte de votre identifiant OpenFront, ni ce que vous avez tapé dans une demande, mot pour l'officier compris. GitHub, une entreprise américaine, la garde 90 jours dans l'onglet Actions du dépôt public du site : n'importe qui peut la télécharger, mais elle reste illisible sans la phrase de passe de la direction. Les sauvegardes de l'ancien jeu s'effacent d'elles-mêmes au bout de 14 jours.</p>

      <h2 id="effacer-ses-donnees" class="scroll-mt-24">Effacer ses données</h2>
      <p>Depuis <a href={`${base}/compte`}>Mon compte</a>, le bouton « Effacer mon compte » supprime tout de suite votre profil et ce qui s'y rattache : vos votes, vos réponses, vos idées et vos soutiens, votre heure annoncée, vos GG, votre pronostic et votre choix de parrain, votre accès à la carte de l'alliance et vos messages dans sa discussion, ancien jeu compris. Dans la liste recopiée, un don reste sans empreinte : plus rien ne le relie à vous. Le journal d'administration garde la trace de l'effacement, sans votre nom. Une copie chiffrée de ce qui a été effacé peut rester jusqu'à 90 jours dans les sauvegardes déjà faites, puis disparaît avec elles.</p>
      <p>Pour toute question, adressez-vous aux officiers sur le <a href={clan.links.discord} rel="noopener">Discord du clan</a>.</p>
    </div>
  </div>
</Base>

<script>
  // Le refus du compte des visites, pour ce navigateur seulement : `src/scripts/visite.ts` ne part plus quand il est posé.
  // Sans stockage, ou sans JavaScript, rien n'est compté de toute façon : le choix ne s'affiche pas.
  import { VISIT_COUNT_KEY, VISIT_COUNT_REFUSED } from "../lib/activite-site";

  const box = document.querySelector<HTMLElement>("[data-visites-choix]");
  const button = document.querySelector<HTMLButtonElement>("[data-visites-bouton]");
  const buttonBox = document.querySelector<HTMLElement>("[data-visites-bouton-boite]");
  const state = document.querySelector<HTMLElement>("[data-visites-etat]");
  // Le navigateur demande déjà de ne pas être suivi : rien n'est compté, le bouton ne servirait à rien.
  const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
  const declined = nav.globalPrivacyControl === true || nav.doNotTrack === "1";

  const refused = () => localStorage.getItem(VISIT_COUNT_KEY) === VISIT_COUNT_REFUSED;
  const show = (changed: boolean) => {
    if (!button || !state) return;
    const off = refused();
    button.textContent = off ? "Compter de nouveau mes visites" : "Ne plus compter mes visites";
    state.textContent = changed ? (off ? "Vos visites ne sont plus comptées dans ce navigateur." : "Vos visites sont de nouveau comptées dans ce navigateur.") : off ? "Vos visites ne sont pas comptées dans ce navigateur." : "";
  };

  try {
    if (declined) {
      if (buttonBox) buttonBox.hidden = true;
      if (state) state.textContent = "Votre navigateur demande de ne pas être suivi : vos visites ne sont pas comptées.";
    } else show(false);
    if (box) box.hidden = false;
    button?.addEventListener("click", () => {
      try {
        if (refused()) localStorage.removeItem(VISIT_COUNT_KEY);
        else localStorage.setItem(VISIT_COUNT_KEY, VISIT_COUNT_REFUSED);
        show(true);
      } catch {
        // Stockage refusé entre-temps : rien ne change.
      }
    });
  } catch {
    // Stockage indisponible : le choix reste masqué.
  }
</script>
