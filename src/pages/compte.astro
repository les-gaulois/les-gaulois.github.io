---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import AccountApp, { PlaceDeLaPorte } from "../components/compte/AccountApp";
import NotOpen from "../components/compte/NotOpen.astro";
import { AUTH_ENABLED } from "../lib/compte/api";
---

<Base title="Mon compte" description="Votre compte sur le site du clan GAL : statut, validation et confidentialité." noindex>
  <div class="wrap">
    <PageHeader title="Mon compte" />
    {/* Les cartes du compte gardent leur colonne (max-w-3xl) ; le vestiaire de l'inscription prend la largeur du site. */}
    <div class="mt-6">
      {/* `fallback` : avant le script, la place de la porte, invisible, pour que le pied de page ne saute pas à son arrivée. */}
      {AUTH_ENABLED ? (
        <AccountApp client:only="preact">
          <PlaceDeLaPorte slot="fallback" />
        </AccountApp>
      ) : (
        <NotOpen />
      )}
    </div>
  </div>
</Base>
