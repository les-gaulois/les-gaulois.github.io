---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import PageHeader from "../components/PageHeader.astro";
import PageJumps from "../components/PageJumps.astro";
import MembersTable from "../components/MembersTable.tsx";
import RankedPlayers from "../components/RankedPlayers.astro";
import ReadingNote from "../components/ReadingNote.astro";
import WinTiers from "../components/WinTiers.astro";
import { clan } from "../../config/clan";
import { loadMembers, loadMeta, loadRanked } from "../lib/data";
import { singlePseudos } from "../lib/members";
import { tierRows } from "../lib/paliers";
import { MAX_AGE_HOURS } from "../lib/freshness";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const src = `${base}/data/members.json`;
const ROLE = { leader: "Chef", officer: "Officier", member: "Membre" } as const;
const list = loadMembers()?.members ?? [];
// Une photo Discord ne va qu'à côté d'un pseudo porté par un seul membre : jamais à côté d'un homonyme (src/scripts/visages.ts).
const faces = singlePseudos(list);
const command = list.filter((m) => m.role !== "member").sort((a, b) => (a.role === "leader" ? -1 : b.role === "leader" ? 1 : 0));
const jumps = [
  { href: "#paliers", label: "Les paliers", show: tierRows(list).length > 0 },
  { href: "#encadrement", label: "L'encadrement", show: command.length > 0 },
  { href: "#classe", label: "Au classé", show: loadRanked() !== null || meta.ranked.lastError !== null },
  { href: "#liste", label: "Toute la liste", show: true },
].filter((jump) => jump.show);
---

<Base title="Membres" description="Les membres du clan GAL sur OpenFront : les paliers, l'encadrement et la liste officielle.">
  <div class="wrap">
    <PageHeader
      title="Membres"
      intro="La liste officielle du clan dans OpenFront. Les membres qui n'ont pas défini de pseudo restent anonymes."
    >
      <div class="mt-4">
        <DataStatus state={meta.members} maxAgeHours={MAX_AGE_HOURS.members} />
      </div>
      <PageJumps links={jumps} />
    </PageHeader>

    <WinTiers />

    {
      command.length > 0 && (
        <section class="card reveal mb-6 scroll-mt-24 p-5" id="encadrement" aria-labelledby="command-title" data-testid="command">
          <h2 id="command-title" class="text-xl">L'encadrement · {command.length}</h2>
          <p class="mt-1 text-sm text-muted">Le chef et les officiers répondent aux demandes d'invitation et choisissent où peindre sur la carte des clans.</p>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {
              command.map((m) => (
                <li class="relative flex min-w-0 items-center gap-3" data-testid="command-member">
                  {/* La photo Discord d'un membre de l'encadrement qui a choisi de se montrer remplace son initiale, pour un membre validé connecté (src/scripts/visages.ts). Toute la ligne mène à la fiche : une cible pour le doigt, pas un mot de 17 pixels. */}
                  <span class="avatar overflow-hidden" aria-hidden="true" data-face={m.username && faces.has(m.username) ? m.username : undefined}>{m.username?.charAt(0) ?? "?"}</span>
                  <span class="min-w-0">
                    {m.username && m.publicId ? (
                      <a class="block truncate after:absolute after:inset-0 after:content-['']" href={`${base}/membres/${encodeURIComponent(m.publicId)}`}>{m.username}</a>
                    ) : (
                      <span class="block truncate font-semibold">Membre anonyme</span>
                    )}
                    <span class="block text-xs text-muted">{ROLE[m.role]}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }

    <RankedPlayers />

    <section class="mt-8 scroll-mt-24" id="liste" aria-labelledby="list-title">
      <h2 id="list-title" class="section-title">Toute la liste</h2>
      <p class="mt-2 max-w-3xl text-sm text-muted" data-testid="members-scope">
        Parties publiques en équipe jouées avec le tag {clan.tag}, sans le classé, le FFA ni Humains contre Nations.
      </p>
      <div class="mb-4">
        <ReadingNote>
          <p>« 0 » signifie aucune partie sous le tag, ce qui ne veut pas dire que le joueur est inactif. « — » signifie pas de données, ou pas de taux sans partie jouée. Un pseudo mène à la fiche du membre.</p>
        </ReadingNote>
      </div>
      <MembersTable client:load src={src} />
      <noscript><p class="card mt-4 p-5">JavaScript est nécessaire pour afficher et trier la liste des membres.</p></noscript>
    </section>
  </div>
</Base>
