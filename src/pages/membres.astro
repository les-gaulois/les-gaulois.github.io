---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import PageHeader from "../components/PageHeader.astro";
import MembersTable from "../components/MembersTable.tsx";
import WinTiers from "../components/WinTiers.astro";
import { loadMeta } from "../lib/data";
import { MAX_AGE_HOURS } from "../lib/freshness";

const meta = loadMeta();
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/data/members.json`;
---

<Base title="Membres" description="Liste officielle des membres du clan GAL sur OpenFront.">
  <div class="wrap">
    <PageHeader
      title="Membres"
      intro="La liste officielle du clan dans OpenFront. Les membres qui n'ont pas défini de pseudo restent anonymes."
    >
      <div class="mt-4">
        <DataStatus state={meta.members} maxAgeHours={MAX_AGE_HOURS.members} />
      </div>
    </PageHeader>
    <WinTiers />
    <section class="card mb-6 p-4 text-sm text-muted" aria-label="Comment lire ces chiffres">
      <p>
        Les chiffres comptent les <strong class="text-white">parties publiques en équipe jouées avec le tag GAL</strong>, sans le classé, le FFA ni Humains contre Nations.
        « 0 » signifie aucune partie sous le tag, ce qui ne veut pas dire que le joueur est inactif. « — » signifie pas de données, ou pas de taux sans partie jouée.
        Un pseudo mène à la fiche du membre.
      </p>
    </section>
    <MembersTable client:load src={src} />
    <noscript><p class="card mt-4 p-5">JavaScript est nécessaire pour afficher et trier la liste des membres.</p></noscript>
  </div>
</Base>
