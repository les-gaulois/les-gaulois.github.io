---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import GauloisPortrait from "../components/GauloisPortrait.astro";
import PageHeader from "../components/PageHeader.astro";
import PageJumps from "../components/PageJumps.astro";
import RankedPlayers from "../components/RankedPlayers.astro";
import ReadingNote from "../components/ReadingNote.astro";
import WinTiers from "../components/WinTiers.astro";
import { loadMembers, loadMeta, loadRanked } from "../lib/data";
import { portraitDuGaulois } from "../lib/gaulois-site";
import { singlePseudos } from "../lib/members";
import { tierRows } from "../lib/paliers";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const ROLE = { leader: "Chef", officer: "Officier", member: "Membre" } as const;
const list = loadMembers()?.members ?? [];
// Une photo Discord ne va qu'à côté d'un pseudo porté par un seul membre : jamais à côté d'un homonyme (src/scripts/visages.ts).
const faces = singlePseudos(list);
const command = list.filter((m) => m.role !== "member").sort((a, b) => (a.role === "leader" ? -1 : b.role === "leader" ? 1 : 0));
const showRanked = loadRanked() !== null || meta.ranked.lastError !== null;
const jumps = [
  { href: "#paliers", label: "Les paliers", show: tierRows(list).length > 0 },
  { href: "#encadrement", label: "L'encadrement", show: command.length > 0 },
  { href: "#classe", label: "Au classé", show: showRanked },
].filter((jump) => jump.show);
// La liste officielle a son onglet, « La liste » (src/pages/liste.astro), depuis le 12 novembre 2026.
---

<Base title="Membres" description="Les membres du clan GAL sur OpenFront : les paliers de victoires, l'encadrement et la présence au classé.">
  {/* Un ancien lien vers la liste, en bas de cette page jusqu'au 12 novembre 2026 (un favori, un lien copié), mène à son onglet. */}
  <script is:inline define:vars={{ liste: `${base}/liste` }}>
    if (location.hash === "#liste") location.replace(liste);
  </script>
  <div class="wrap">
    {/* Une date et un repli pour toute la page : la liste des membres (paliers, encadrement) et le classé. */}
    <PageHeader title="Membres">
      <div class="mt-4">
        <DataStatus sources={showRanked ? ["members", "ranked"] : ["members"]} />
      </div>
      <PageJumps links={jumps} />
    </PageHeader>

    <WinTiers rendu="bloc" />

    {
      command.length > 0 && (
        <section class="card reveal mb-section scroll-mt-24 p-5" id="encadrement" aria-labelledby="command-title" data-testid="command">
          <h2 id="command-title" class="text-xl">L'encadrement · {command.length}</h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {
              command.map((m) => (
                <li class="relative flex min-w-0 items-center gap-3" data-testid="command-member">
                  {/* La photo Discord d'un membre de l'encadrement qui a choisi de se montrer remplace son initiale, pour un membre validé connecté (src/scripts/visages.ts). Toute la ligne mène à la fiche : une cible pour le doigt, pas un mot de 17 pixels. */}
                  {/* Le Gaulois de qui a créé le sien prend la place de l'initiale (src/lib/gaulois-site.ts). */}
                  {m.username && portraitDuGaulois(m.publicId) ? (
                    <GauloisPortrait portrait={portraitDuGaulois(m.publicId)} />
                  ) : (
                    <span class="avatar overflow-hidden" aria-hidden="true" data-face={m.username && faces.has(m.username) ? m.username : undefined}>{m.username?.charAt(0) ?? "?"}</span>
                  )}
                  <span class="min-w-0">
                    {m.username && m.publicId ? (
                      <a class="pseudo block truncate after:absolute after:inset-0 after:content-['']" href={`${base}/membres/${encodeURIComponent(m.publicId)}`}>{m.username}</a>
                    ) : (
                      <span class="block truncate italic text-muted">Membre anonyme</span>
                    )}
                    <span class="block text-xs text-muted">{ROLE[m.role]}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </section>
      )
    }

    <RankedPlayers rendu="bloc" />
    <ReadingNote page>
      <WinTiers rendu="note" />
      <RankedPlayers rendu="note" />
    </ReadingNote>
  </div>
</Base>
