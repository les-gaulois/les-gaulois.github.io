---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import Empty from "../components/Empty.astro";
import GroupPlay from "../components/GroupPlay.astro";
import PageHeader from "../components/PageHeader.astro";
import { loadMeta, loadSessions } from "../lib/data";
import { fmtDay, fmtDec1, fmtInt } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { HEATMAP_DAYS, bestSlots, buildHeatmap } from "../lib/sessions";
import { WEEKDAYS_FR } from "../lib/time";

const meta = loadMeta();
const map = buildHeatmap(loadSessions(), meta.sessions.coveredUntil);
const slots = bestSlots(map);
const DAYS = WEEKDAYS_FR;
const HOURS = Array.from({ length: 24 }, (_, h) => h);

// Rampe à une seule teinte, du plus sombre au plus clair sur le fond marine.
const RAMP = ["#1b2a5c", "#21408f", "#2360d0", "#4c86f5", "#8db0ff", "#d6e4ff"];
function cell(n: number) {
  if (!map || map.max === 0 || n === 0) return { background: "transparent", color: "#a9b4d0" };
  const step = Math.min(RAMP.length - 1, Math.floor((n / map.max) * RAMP.length));
  return { background: RAMP[step], color: step >= 3 ? "#0a1230" : "#ffffff" };
}
const count = (d: number, h: number) => map?.grid[d]?.[h] ?? 0;
const tip = (d: number, h: number) => `${DAYS[d]} ${h} h : ${fmtInt(count(d, h))} partie${count(d, h) > 1 ? "s" : ""}`;
---

<Base title="Quand jouer" description="Quand trouver des Gaulois pour jouer : parties enregistrées par jour et par heure de Paris, et résultats selon la taille du groupe.">
  <div class="wrap">
    <PageHeader
      title="Quand jouer"
      intro="Les moments où le clan joue le plus, en heure de Paris. Ce sont des parties enregistrées, pas des joueurs connectés."
    >
      <div class="mt-4">
        <DataStatus state={meta.sessions} maxAgeHours={MAX_AGE_HOURS.sessions} />
      </div>
    </PageHeader>

    {
      !map || map.total === 0 ? (
        <Empty title="Pas de données">Aucune partie enregistrée n'est disponible sur cette période.</Empty>
      ) : (
        <>
          <p class="tnum text-sm text-muted">
            {fmtInt(map.total)} parties, du {fmtDay(map.from)} au {fmtDay(map.to)} ({HEATMAP_DAYS} jours). Parties publiques en équipe jouées avec le tag : ni FFA, ni classé, ni Humains contre Nations.
          </p>

          <section class="mt-6" aria-labelledby="slots-title">
            <h2 id="slots-title" class="section-title">Meilleurs créneaux pour jouer ensemble</h2>
            {slots.length === 0 ? (
              <p class="card mt-4 p-5 text-muted">Pas assez de parties pour dégager un créneau.</p>
            ) : (
              <ol class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
                {slots.map((s, i) => (
                  <li class:list={["card p-4", i === 0 && "card-accent"]} data-testid="best-slot" data-tilt="4">
                    <p class="font-display text-lg font-bold">{DAYS[s.weekday]}</p>
                    <p class="tnum font-display text-2xl font-extrabold">{s.hour} h – {(s.hour + 1) % 24} h</p>
                    <p class="tnum mt-1 text-sm text-muted">{fmtInt(s.games)} parties, {fmtDec1(s.avgPlayers)} joueurs du clan en moyenne</p>
                    <div class="meter mt-3" aria-hidden="true"><i style={{ "--v": `${(s.games / map.max) * 100}%` }}></i></div>
                  </li>
                ))}
              </ol>
            )}
            <p class="mt-2 text-xs text-muted">Classés par nombre de parties enregistrées, puis par joueurs du clan par partie. Minimum : 5 parties.</p>
          </section>

          <section class="mt-10" aria-labelledby="heat-title">
            <h2 id="heat-title" class="section-title">Parties par jour et par heure</h2>
            <div class="mt-3 flex items-center gap-2 text-xs text-muted" aria-hidden="true">
              <span>Moins</span>
              {RAMP.map((c) => <i class="inline-block h-3 w-6 rounded-sm" style={{ background: c }} />)}
              <span>Plus</span>
            </div>

            {/* Grand écran : une ligne par jour. */}
            <div class="card mt-3 hidden p-3 lg:block">
              <table class="tnum w-full table-fixed border-separate border-spacing-0.5 text-xs" data-testid="heatmap" data-ripple-group>
                <caption class="sr-only">Nombre de parties enregistrées par jour de la semaine et par heure de Paris</caption>
                <thead>
                  <tr>
                    <td class="w-20"></td>
                    {HOURS.map((h) => <th scope="col" class="pb-1 font-medium text-muted">{h}<span class="sr-only"> h</span></th>)}
                  </tr>
                </thead>
                <tbody>
                  {DAYS.map((name, d) => (
                    <tr>
                      <th scope="row" class="pr-2 text-left text-sm font-semibold">{name}</th>
                      {HOURS.map((h) => (
                        <td class="heat-cell h-9 rounded text-center" data-ripple="scale" style={{ ...cell(count(d, h)), "--d": d, "--h": h }} title={tip(d, h)}>{count(d, h)}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {/* Petit écran : une ligne par heure, pour éviter tout défilement horizontal. */}
            <div class="card mt-3 p-2 lg:hidden">
              <table class="tnum w-full table-fixed border-separate border-spacing-0.5 text-xs" data-ripple-group>
                <caption class="sr-only">Nombre de parties enregistrées par heure de Paris et par jour de la semaine</caption>
                <thead>
                  <tr>
                    <td class="w-9"></td>
                    {DAYS.map((name) => <th scope="col" class="pb-1 font-semibold"><abbr title={name} class="no-underline">{name.slice(0, 3)}</abbr></th>)}
                  </tr>
                </thead>
                <tbody>
                  {HOURS.map((h) => (
                    <tr>
                      <th scope="row" class="pr-1 text-right font-medium text-muted">{h} h</th>
                      {DAYS.map((_, d) => (
                        <td class="heat-cell h-8 rounded text-center" data-ripple="scale" style={{ ...cell(count(d, h)), "--d": d, "--h": h }} title={tip(d, h)}>{count(d, h)}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </>
      )
    }
    <div class="mt-10">
      <GroupPlay />
    </div>
  </div>
</Base>
