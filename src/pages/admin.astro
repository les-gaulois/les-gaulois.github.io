---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import AdminApp from "../components/compte/AdminApp";
import NotOpen from "../components/compte/NotOpen.astro";
import { AUTH_ENABLED } from "../lib/compte/api";
---

<Base title="Administration" description="Espace des officiers et des admins du clan GAL." noindex theme="rouge">
  <div class="wrap">
    <PageHeader title="Administration" />
    <div class="mt-6">
      {AUTH_ENABLED ? <AdminApp client:only="preact" /> : <NotOpen />}
    </div>
  </div>
</Base>
