---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import PageJumps from "../components/PageJumps.astro";
import GrowthChart from "../components/GrowthChart.tsx";
import { clan } from "../../config/clan";

const entries = (await getCollection("guide")).sort((a, b) => a.data.order - b.data.order);
const guides = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const chapterEntries = (await getCollection("guideClan")).sort((a, b) => a.data.order - b.data.order);
const chapters = await Promise.all(chapterEntries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const jumps = [
  { href: "#guide-title", label: "Guide par mode" },
  { href: "#guide-clan-title", label: "Le guide du clan" },
];
---

<Base title="Guides" description="Pour débuter ou progresser sur OpenFront : stratégies par mode et guide du clan sur le combat et l'économie.">
  <div class="wrap">
    <PageHeader title="Les guides">
      <PageJumps links={jumps} />
    </PageHeader>

    <section aria-labelledby="guide-title">
      <h2 id="guide-title" class="section-title scroll-mt-24">Guide par mode</h2>
      <div class="mt-4 space-y-3">
        {
          guides.map(({ entry, Content }) => (
            <details class="card guide-fold scroll-mt-24 p-5" id={`guide-${entry.id}`} data-testid="guide-card" data-tilt="0">
              <summary><h3 class="text-xl">{entry.data.title}</h3></summary>
              {entry.data.draft ? (
                <p class="mt-2 text-sm text-muted">
                  Ce guide reste à rédiger par le clan.{" "}
                  <a href={clan.links.discord} rel="noopener">En attendant, posez vos questions sur le Discord.</a>
                </p>
              ) : (
                <div class:list={["guide-body mt-2 text-muted", entry.data.wide ? "guide-columns" : "max-w-3xl"]}>
                  <Content />
                </div>
              )}
            </details>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-muted" data-testid="guide-sources">
        Stratégies traduites et adaptées du <a href="https://openfront.wiki/Main_Page" rel="noopener">wiki OpenFront</a>, sous licence{" "}
        <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr" rel="noopener">CC BY-SA 4.0</a> : ce texte adapté reste sous la même licence. Formats et chiffres vérifiés sur le{" "}
        <a href="https://github.com/openfrontio/OpenFrontIO" rel="noopener">code public du jeu</a>, v0.35.12, le 6 novembre 2026.
      </p>
    </section>

    <section class="mt-12" aria-labelledby="guide-clan-title">
      <h2 id="guide-clan-title" class="section-title scroll-mt-24">Le guide du clan</h2>
      <p class="mt-2 max-w-3xl text-muted">Commencez par les chapitres 1 à 5. Le chapitre 9 aide à éviter les erreurs d'alliance.</p>
      <nav class="card mt-4 p-5" aria-label="Chapitres du guide du clan" data-tilt="0">
        <ol class="guide-toc">
          {chapters.map(({ entry }) => <li><a href={`#chapitre-${entry.id}`}>{entry.data.title}</a></li>)}
        </ol>
      </nav>
      <div class="mt-3 space-y-3">
        {
          chapters.map(({ entry, Content }) => (
            <details class="card guide-fold scroll-mt-24 p-5" id={`chapitre-${entry.id}`} data-testid="guide-chapter" data-tilt="0">
              <summary><h3 class="text-xl"><span class="tnum">{entry.data.order}.</span> {entry.data.title}</h3></summary>
              <div class:list={["guide-body mt-3 text-muted", entry.data.wide ? "guide-columns" : "max-w-3xl"]}>
                {entry.data.growthChart && <GrowthChart client:load />}
                <Content />
              </div>
            </details>
          ))
        }
      </div>
      <p class="mt-3 text-xs text-muted">
        Guide Gaulois [GAL], octobre 2026, écrit sur la v0.35.2 du jeu et vérifié le 6 novembre 2026 sur la v0.35.12. Texte réservé au clan : sa copie et sa diffusion à d'autres clans sont interdites.
      </p>
    </section>

  </div>
</Base>

<script>
  // Le calculateur et les outils ont changé de page : les anciens liens y mènent encore.
  if (["#calculateur", "#outils-section", "#outils"].includes(location.hash)) {
    location.replace(`${import.meta.env.BASE_URL.replace(/\/$/, "")}/outils${location.hash}`);
  }
  // Un lien du sommaire ouvre le chapitre visé, même déjà visité. Sans script, le chapitre s'ouvre d'un clic.
  function openChapter(hash: string): void {
    const target = hash ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
    if (target instanceof HTMLDetailsElement) target.open = true;
  }
  addEventListener("hashchange", () => openChapter(location.hash));
  openChapter(location.hash);
  for (const link of document.querySelectorAll<HTMLAnchorElement>('main a[href^="#"]')) {
    link.addEventListener("click", () => openChapter(link.hash));
  }
</script>
