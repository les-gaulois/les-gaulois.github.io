---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import IconePartie from "../components/compte/IconePartie";
import CroissanceValeurs from "../components/guide/CroissanceValeurs.astro";
import GuideBloc from "../components/guide/GuideBloc.astro";
import { ancreDuChapitre, commandeDuChapitre, morceauxGras, motsComposes, numeroDuChapitre, parGroupe, titreEnDeux } from "../lib/guide";

// Le guide du clan : un chapitre par fichier de content/guide-clan/, dans l'ordre de leur numéro.
const entries = (await getCollection("guideClan")).sort((a, b) => a.data.order - b.data.order);
const total = entries.length;
const chapitres = await Promise.all(
  entries.map(async (entry, index) => ({
    ...entry.data,
    id: entry.id,
    index,
    ancre: ancreDuChapitre(entry.id),
    numero: numeroDuChapitre(index + 1),
    commande: commandeDuChapitre(entry.id),
    enDeux: titreEnDeux(entry.data.title),
    // Un chapitre peut n'avoir que son en-tête : alors, rien à déplier.
    aDuTexte: Boolean(entry.body?.trim()),
    Content: (await render(entry)).Content,
  })),
);
const groupes = parGroupe(chapitres);
// Une ligne d'un bloc peut renvoyer au chapitre qui l'explique : un nom de fichier mal écrit arrête la construction.
for (const c of chapitres) {
  for (const p of c.points) {
    if (p.renvoi && !chapitres.some((autre) => autre.id === p.renvoi)) throw new Error(`${c.id} : le renvoi « ${p.renvoi} » ne nomme aucun chapitre`);
  }
}
const premier = chapitres[0];
---

{/* `console` : depuis le 12 novembre 2026, à la demande du pilote (« comme la Carte »), le guide est dans le style Terminal du
    QG et de la Carte, en bleu (docs/DESIGN.md, « Le guide du clan »). Ses lignes de commande (« gal@guide:~$ ./bases ») sont
    écrites dans la page, décoratives et cachées aux lecteurs d'écran. */}
<Base
  title="Guide du clan"
  description="Le guide du clan GAL pour débuter sur OpenFront : combat, économie et alliances, un chapitre à la fois, avec des essais à manipuler."
  ambiance="console"
>
  <div class="wrap">
    <PageHeader title="Le guide du clan" intro="Commencez par les chapitres 1 à 5. Le chapitre 9 aide à éviter les erreurs d'alliance.">
      {/* Décorative : le titre dit déjà où l'on est. */}
      <p slot="avant-titre" class="console-invite" aria-hidden="true">
        <span class="console-hote">gal@guide</span>:~$<span class="console-commande">&nbsp;./guide</span><span class="console-curseur"></span>
      </p>
    </PageHeader>

    {/* Un chapitre à la fois, dans une fenêtre de terminal, avec son sommaire (docs/DESIGN.md, « Le guide du clan »).
        Sans JavaScript, la page donne tous les chapitres à la suite : rien n'est caché tant que le script n'a pas pris la main. */}
    <div class="guide fx-block" data-guide>
      <nav class="guide-plan" aria-label="Chapitres du guide du clan" data-guide-plan>
        {/* Sur téléphone, le sommaire se replie sous ce bouton, qui dit le chapitre ouvert. Sans script, il reste caché et le sommaire, ouvert. */}
        <button type="button" class="guide-plan-bouton" data-guide-bouton aria-expanded="false" aria-controls="guide-plan-liste">
          <span class="guide-etiquette">Chapitres</span>
          <span class="guide-plan-ici" data-guide-ici>{premier && `${premier.numero} · ${premier.court}`}</span>
          <svg class="guide-plan-fleche" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 6l5 5 5-5"></path>
          </svg>
        </button>
        <div class="guide-plan-liste" id="guide-plan-liste">
          <p class="guide-plan-racine" aria-hidden="true">~/guide</p>
          {
            groupes.map((g) => (
              <div class="guide-plan-groupe">
                <p class="guide-etiquette" id={`guide-groupe-${g.id}`}>
                  {g.nom}
                </p>
                <ul aria-labelledby={`guide-groupe-${g.id}`}>
                  {g.chapitres.map((c) => (
                    <li>
                      <a class="guide-plan-lien" href={`#${c.ancre}`} data-guide-lien={c.ancre}>
                        <IconePartie nom={c.icone} classe="guide-plan-icone" />
                        <span class="guide-plan-numero tnum">{c.numero}</span>
                        <span>{c.court}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </nav>

      <div class="guide-ecran">
        {
          chapitres.map((c) => {
            const avant = chapitres[c.index - 1];
            const apres = chapitres[c.index + 1];
            const { Content } = c;
            return (
              <section class="guide-chapitre" id={c.ancre} aria-labelledby={`titre-${c.id}`} data-guide-chapitre data-court={`${c.numero} · ${c.court}`} data-testid="guide-chapter">
                {/* La barre de la fenêtre : son nom et l'avancée dans le guide. Décorative : le titre et « Chapitre 3 sur 11 » le disent. */}
                <p class="guide-barre" aria-hidden="true">
                  <span class="guide-barre-nom">■ {c.commande}</span>
                  <span class="guide-avance">
                    <span class="guide-jalons">
                      {chapitres.map((autre) => (
                        <i class:list={{ "guide-jalon-fait": autre.index <= c.index }} />
                      ))}
                    </span>
                    <span class="tnum">
                      {c.numero}/{numeroDuChapitre(total)}
                    </span>
                  </span>
                </p>

                <div class="guide-corps">
                  {/* La ligne de commande du chapitre, la voix de la machine : elle s'écrit quand il s'ouvre. Décorative. */}
                  <p class="guide-commande" aria-hidden="true">
                    <span class="console-hote">gal@guide</span>:~$ ./{c.commande}
                  </p>
                  <header class="guide-tete">
                    <IconePartie nom={c.icone} classe="guide-icone" />
                    <div class="min-w-0">
                      <p class="guide-etiquette">
                        Chapitre {c.index + 1} sur {total}
                      </p>
                      {/* Un mot composé (« Aide-mémoire ») ne se coupe pas à son trait d'union. */}
                      <h2 id={`titre-${c.id}`} class="guide-titre" tabindex="-1" data-guide-titre>
                        {motsComposes(c.enDeux.titre).map((m) => (m.insecable ? <span class="guide-insecable">{m.texte}</span> : m.texte))}
                      </h2>
                      {c.enDeux.precision && <p class="guide-precision">{c.enDeux.precision}</p>}
                    </div>
                  </header>

                  {c.chapeau && <p class="guide-chapeau">{c.chapeau}</p>}
                  {c.essentiel.length > 0 && (
                    <ul class="guide-essentiel">
                      {c.essentiel.map((phrase) => (
                        <li>{morceauxGras(phrase).map((m) => (m.gras ? <strong>{m.texte}</strong> : m.texte))}</li>
                      ))}
                    </ul>
                  )}

                  {c.bloc && <GuideBloc bloc={c.bloc} titre={c.blocTitre} texte={c.blocTexte} points={c.points} chapitres={chapitres} />}

                  {c.retenir && (
                    <p class="guide-retenir">
                      <strong>{c.retenir.titre}.</strong> {c.retenir.texte}
                    </p>
                  )}

                  {c.aDuTexte && c.ouvert && (
                    <div class="guide-body guide-texte">
                      <Content />
                    </div>
                  )}
                  {c.aDuTexte && !c.ouvert && (
                    <details class="fold guide-details">
                      <summary>Détails et formules</summary>
                      <div class="guide-body">
                        <Content />
                        {c.bloc === "croissance" && <CroissanceValeurs />}
                      </div>
                    </details>
                  )}
                </div>

                <p class="guide-pas">
                  {avant && (
                    <a class="btn btn-ghost" href={`#${avant.ancre}`} rel="prev" data-testid="guide-avant">
                      Précédent
                    </a>
                  )}
                  {apres && (
                    <a class="btn btn-ghost guide-pas-suite" href={`#${apres.ancre}`} rel="next" data-testid="guide-apres">
                      Suivant : {apres.court}
                    </a>
                  )}
                </p>
              </section>
            );
          })
        }
      </div>
    </div>

    {/* Avant le premier affichage : un seul chapitre reste ouvert, celui que nomme l'adresse ou le premier, et le sommaire
        se replie sur téléphone. Ce script suit aussi l'adresse : si src/scripts/guide.ts ne se charge pas, « Précédent »,
        « Suivant » et les liens des chapitres ouvrent encore le bon chapitre. guide.ts ajoute le reste : le sommaire du
        téléphone, le chapitre marqué, la page et le focus qui suivent. Sans JavaScript du tout, la page reste entière. */}
    <script is:inline>
      (() => {
        const guide = document.querySelector("[data-guide]");
        if (!guide) return;
        const chapitres = [...guide.querySelectorAll("[data-guide-chapitre]")];
        const montrer = () => {
          let nomme = null;
          try {
            nomme = location.hash.length > 1 ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
          } catch {
            // Une adresse mal écrite : comme une adresse sans chapitre.
          }
          if (nomme && !nomme.matches("[data-guide-chapitre]")) nomme = null;
          // Une autre ancre (« Aller au contenu ») garde le chapitre ouvert ; sans ancre, le premier.
          const cible = nomme || (location.hash.length > 1 && guide.querySelector(".guide-ouvert")) || chapitres[0];
          for (const chapitre of chapitres) chapitre.classList.toggle("guide-ouvert", chapitre === cible);
        };
        if (chapitres.length === 0) return;
        montrer();
        guide.classList.add("guide-pas-a-pas");
        addEventListener("hashchange", montrer);
      })();
    </script>

    <p class="mt-4 text-xs text-muted" data-testid="guide-source">
      Guide Gaulois [GAL], octobre 2026, écrit sur la v0.35.2 du jeu et vérifié le 6 novembre 2026 sur la v0.35.12. Texte réservé au clan : sa copie et sa diffusion à d'autres clans sont interdites.
    </p>
  </div>
</Base>

<script>
  import "../scripts/guide";
</script>
