---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import DirectionApp from "../components/compte/DirectionApp";
import NotOpen from "../components/compte/NotOpen.astro";
import { AUTH_ENABLED } from "../lib/compte/api";
import { loadGazetteSendState, loadMeta } from "../lib/data";

// L'état de la collecte et de la gazette au moment de la construction. Son âge se calcule dans le navigateur.
const health = { meta: loadMeta(), gazette: loadGazetteSendState() };
---

<Base title="Direction" description="L'espace des officiers et des chefs du clan GAL." noindex theme="rouge">
  <div class="wrap">
    <PageHeader title="Direction" />
    <div class="mt-6">
      {AUTH_ENABLED ? <DirectionApp client:only="preact" health={health} /> : <NotOpen />}
    </div>
  </div>
</Base>
