---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import LogoMatrice from "../components/LogoMatrice";
import DirectionApp from "../components/compte/DirectionApp";
import NotOpen from "../components/compte/NotOpen.astro";
import { AUTH_ENABLED } from "../lib/compte/api";
import { loadGazetteSendState, loadMeta } from "../lib/data";
import { logoMatriceDepuisImage } from "../lib/logo-matrice-image";

// L'état de la collecte et de la gazette au moment de la construction. Son âge se calcule dans le navigateur.
const health = { meta: loadMeta(), gazette: loadGazetteSendState() };
// Le logo du guerrier en mode Matrix : en grand dans l'en-tête, en petit dans le menu des parties (docs/DESIGN.md).
const logoGrand = await logoMatriceDepuisImage(48);
const logoPetit = await logoMatriceDepuisImage(24);
---

{/* `espace` : tout y est plus grand, voir global.css. `console` : le poste de commandement en style Terminal, voir docs/DESIGN.md.
    `--console-hote` : la machine des lignes de commande (« gal@direction:~$ ./annonces »). */}
<Base title="Direction" description="L'espace des officiers et des chefs du clan GAL." noindex theme="rouge" ambiance="console">
  <div class="wrap console-tete" style='--console-hote: "direction"'>
    <PageHeader title="Direction" compact>
      {/* Décorative : le titre dit déjà où l'on est. */}
      <p slot="avant-titre" class="console-invite" aria-hidden="true">
        <span class="console-hote">gal@direction</span>:~$<span class="console-commande">&nbsp;./direction</span><span class="console-curseur"></span>
      </p>
    </PageHeader>
    {logoGrand && <LogoMatrice data={logoGrand} id="logo-tete" class="console-logo-tete" />}
    <div class="espace">
      {AUTH_ENABLED ? <DirectionApp client:only="preact" health={health} logo={logoPetit ?? undefined} /> : <NotOpen />}
    </div>
  </div>
</Base>
