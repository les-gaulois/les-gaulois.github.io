---
import Base from "../layouts/Base.astro";
import NotOpen from "../components/compte/NotOpen.astro";
import VillageApp from "../components/village/VillageApp";
import DemoDuJeu from "../components/village/DemoDuJeu";
import BarreDuJeu from "../components/jeu/BarreDuJeu.astro";
import PiedDuJeu from "../components/jeu/PiedDuJeu.astro";
import sharp from "sharp";
import { ecrire, enCapitales } from "../lib/jeu/ecriture";
import { feuilleDuKit } from "../lib/jeu/kit-css";
import GauloisPortrait from "../components/GauloisPortrait.astro";
import { AUTH_ENABLED } from "../lib/compte/api";
import { BANNIERES_MEMBRES_FILE, bannieresDuCache, fondsDesLignes } from "../lib/bannieres-joueurs";
import { loadMembers } from "../lib/data";
import { fmtDayAndTime, fmtInt } from "../lib/format";
import { gauloisLusLe } from "../lib/gaulois-joueurs";
import { gauloisDuSite, portraitDuGaulois } from "../lib/gaulois-site";
import { RARETES_DES_OBJETS } from "../lib/gaulois";
import { tenueOf } from "../lib/gaulois-sprite";
import { rareteDuCadre } from "../lib/village/vitrine";
import { vitrinePublique } from "../lib/village/vitrine-publique";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// La vitrine des visiteurs (revue du 18 novembre 2026) : les Gaulois déjà créés par les membres au pseudo public, relevés
// avant la construction comme sur les fiches (src/lib/village/vitrine-publique.ts). Avec le serveur, la page la cache
// d'abord, et « Mon Gaulois » ne la montre qu'à qui n'est pas connecté (VillageApp.tsx).
const vitrine = vitrinePublique(loadMembers()?.members ?? [], (id) => portraitDuGaulois(id) !== null);
const releve = gauloisLusLe();
// Chaque carte de la vitrine des visiteurs, en écran de jeu (21 novembre 2026) : comme celles des membres, la bannière choisie
// derrière le Gaulois (relevée comme sur la liste du clan, src/lib/bannieres-joueurs.ts) et le cadre de la rareté la plus
// haute qu'il porte (src/lib/village/vitrine.ts), un fait du catalogue, jamais un score.
const fonds = fondsDesLignes(bannieresDuCache(BANNIERES_MEMBRES_FILE, vitrine.map((g) => g.id)));
const tenues = gauloisDuSite();
const cartes = vitrine.map((g) => {
  const tenue = tenueOf(tenues, g.id);
  const rarete = tenue ? rareteDuCadre(tenue) : null;
  return { ...g, banniere: fonds[g.id]?.image ?? null, rarete, rareteDite: rarete ? RARETES_DES_OBJETS[rarete].nom.toLowerCase() : null };
});
// Les images du kit en pixels (src/lib/jeu/kit-css.ts), servies à part et gardées en cache : leur version est dans l'adresse.
const kit = await feuilleDuKit();
// Le titre de la vitrine des visiteurs, en ruban : un mot en pixels du kit, dessiné ici à la construction (la page est écrite
// sans script), crème à l'ombre comme les rubans de « Mon Gaulois ».
const titreEnPixels = await (async () => {
  const p = ecrire(enCapitales("Les Gaulois du clan"), "#f6f1e3", "rgba(4,7,22,.75)");
  const image = await sharp(Buffer.from(p.data.buffer, p.data.byteOffset, p.data.byteLength), { raw: { width: p.width, height: p.height, channels: 4 } }).png().toBuffer();
  const url = `url("data:image/png;base64,${image.toString("base64")}")`;
  return `--i:${url};--i-sombre:${url};--w:${p.width};--h:${p.height}`;
})();
---

{/* Le Gaulois de chaque membre (13 novembre 2026, demande du pilote) : il l'habille en pixels, et son Gaulois paraît sur
    les images du clan que le robot poste sur Discord ; la commande /gaulois y mène. Le monde du village en pixels (place,
    chantier, grand feu, intérieurs, almanach) est retiré depuis le 15 novembre 2026, à la demande du pilote (« enlève la
    partie villages ») ; l'adresse /village reste, pour les liens déjà donnés. Un visiteur voit le Gaulois de départ et la
    porte. Un compte connecté finit d'abord son inscription (lien OpenFront, puis Gaulois au vestiaire seul :
    src/lib/compte/arrivee.ts), puis a ses onglets, comme au QG : « Le vestiaire » (« Mon Gaulois » jusqu'au 18 novembre 2026 : ce qui est à lui),
    « La forge » et « La boutique » (la bourse, la pochette surprise, les rayons et le marché des membres). La boutique a
    eu sa page, /boutique, le matin du 15 novembre 2026 ; le pilote l'a voulue ici l'après-midi : /boutique renvoie à
    l'onglet, et /village#marche l'ouvre au marché. Tout vient du serveur : la page ne contient que la porte, et, dessous, la
    vitrine des visiteurs, écrite au build (18 novembre 2026). Depuis le 21 novembre 2026, c'est un écran de jeu plein écran
    (cadre de jeu de Base.astro, maquette validée par le pilote) : la barre du jeu remplace l'en-tête du site, « Ma carte »
    ouvre le jeu, et le menu du jeu mène aux autres parties (VillageApp.tsx). */}
<Base cadre="jeu" title="Mon Gaulois" description="Le jeu des Gaulois du clan GAL : la carte de chaque membre et ses chiffres de clan, son Gaulois en pixels à habiller, le pass, la forge, la boutique, les boosters, la vitrine et la loterie, avec les statères des points rapportés au clan.">
  <link slot="tete" rel="stylesheet" href={`${base}/village/kit.css?v=${kit.version}`} />
  <BarreDuJeu slot="barre-jeu" />
  <PiedDuJeu slot="pied-jeu" />
  <div class="jeu-contenu">
    {
      AUTH_ENABLED ? (
        <VillageApp client:only="preact" />
      ) : (
        <section class="jeu-ecran jeu-n9" aria-labelledby="vestiaire-titre">
          <h2 id="vestiaire-titre" class="section-title-sm">Votre Gaulois</h2>
          <div class="mt-8">
            <NotOpen />
          </div>
        </section>
      )
    }
    {/* La démonstration du jeu pour les visiteurs (21 novembre 2026, choix du pilote) : un booster d'essai, puis « Rejoins le
        clan pour jouer ». Sans le serveur, elle est toujours là ; avec lui, « Mon Gaulois » ne la montre qu'aux visiteurs. */}
    <div class="demo-jeu-place" data-demo-visiteur hidden={AUTH_ENABLED}>
      <DemoDuJeu client:only="preact" rejoindre={`${base}/rejoindre`} connexion={AUTH_ENABLED ? `${base}/compte` : null} />
    </div>
    {
      vitrine.length > 0 && (
        <section class="vitrine-publique jeu-panneau jeu-n9" aria-labelledby="vitrine-publique-titre" data-vitrine-publique data-testid="vitrine-publique" hidden={AUTH_ENABLED}>
          <h2 id="vitrine-publique-titre" class="vitrine-publique-titre">
            <span class="jeu-ruban jeu-n9">
              <span class="sr-only">Les Gaulois du clan</span>
              <span class="jeu-px" aria-hidden="true"><i style={titreEnPixels} /></span>
            </span>
          </h2>
          <p class="vitrine-publique-releve tnum">
            {vitrine.length > 1 ? `${fmtInt(vitrine.length)} Gaulois déjà habillés par leur membre` : "1 Gaulois déjà habillé par son membre"}{releve && `, ${vitrine.length > 1 ? "relevés" : "relevé"} le ${fmtDayAndTime(releve)}`}.
          </p>
          <ul class="vitrine-publique-cartes">
            {cartes.map((g) => (
              <li>
                <a class="vitrine-publique-case" href={`${base}/membres/${encodeURIComponent(g.id)}`} data-rarete={g.rarete ?? undefined} data-testid="vitrine-publique-gaulois">
                  <span class="vitrine-publique-image">
                    {g.banniere && <img class="vitrine-publique-fond" src={`${base}${g.banniere}`} alt="" loading="lazy" decoding="async" />}
                    <GauloisPortrait id={g.id} pose="pied" taille={2} />
                  </span>
                  <span class="pseudo">{g.pseudo}</span>
                  {/* Le cadre dit la rareté portée en couleur : elle est aussi écrite, pour les lecteurs d'écran. */}
                  {g.rareteDite && <span class="sr-only">, rareté portée : {g.rareteDite}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
