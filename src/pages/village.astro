---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import NotOpen from "../components/compte/NotOpen.astro";
import VillageApp from "../components/village/VillageApp";
import GauloisPortrait from "../components/GauloisPortrait.astro";
import { AUTH_ENABLED } from "../lib/compte/api";
import { loadMembers } from "../lib/data";
import { fmtDayAndTime, fmtInt } from "../lib/format";
import { gauloisLusLe } from "../lib/gaulois-joueurs";
import { portraitDuGaulois } from "../lib/gaulois-site";
import { vitrinePublique } from "../lib/village/vitrine-publique";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// La vitrine des visiteurs (revue du 18 novembre 2026) : les Gaulois déjà créés par les membres au pseudo public, relevés
// avant la construction comme sur les fiches (src/lib/village/vitrine-publique.ts). Avec le serveur, la page la cache
// d'abord, et « Mon Gaulois » ne la montre qu'à qui n'est pas connecté (VillageApp.tsx).
const vitrine = vitrinePublique(loadMembers()?.members ?? [], (id) => portraitDuGaulois(id) !== null);
const releve = gauloisLusLe();
---

{/* Le Gaulois de chaque membre (13 novembre 2026, demande du pilote) : il l'habille en pixels, et son Gaulois paraît sur
    les images du clan que le robot poste sur Discord ; la commande /gaulois y mène. Le monde du village en pixels (place,
    chantier, grand feu, intérieurs, almanach) est retiré depuis le 15 novembre 2026, à la demande du pilote (« enlève la
    partie villages ») ; l'adresse /village reste, pour les liens déjà donnés. Un visiteur voit le Gaulois de départ et la
    porte. Un compte connecté finit d'abord son inscription (lien OpenFront, puis Gaulois au vestiaire seul :
    src/lib/compte/arrivee.ts), puis a ses onglets, comme au QG : « Le vestiaire » (« Mon Gaulois » jusqu'au 18 novembre 2026 : ce qui est à lui),
    « La forge » et « La boutique » (la bourse, la pochette surprise, les rayons et le marché des membres). La boutique a
    eu sa page, /boutique, le matin du 15 novembre 2026 ; le pilote l'a voulue ici l'après-midi : /boutique renvoie à
    l'onglet, et /village#marche l'ouvre au marché. Tout vient du serveur : la page ne contient que la porte, et, dessous, la
    vitrine des visiteurs, écrite au build (18 novembre 2026). */}
<Base title="Mon Gaulois" description="Le Gaulois en pixels de chaque membre du clan GAL : il l'habille, grave ses parties à la forge et achète à la boutique avec les statères des points rapportés au clan, et le voit sur les images du clan sur Discord.">
  <div class="wrap">
    <PageHeader title="Mon Gaulois" />
    <div class="mt-8">
      {
        AUTH_ENABLED ? (
          <VillageApp client:only="preact" />
        ) : (
          <section aria-labelledby="vestiaire-titre">
            <h2 id="vestiaire-titre" class="section-title-sm">Votre Gaulois</h2>
            <div class="mt-8">
              <NotOpen />
            </div>
          </section>
        )
      }
    </div>
    {
      vitrine.length > 0 && (
        <section class="mt-section" aria-labelledby="vitrine-publique-titre" data-vitrine-publique data-testid="vitrine-publique" hidden={AUTH_ENABLED}>
          <h2 id="vitrine-publique-titre" class="section-title-sm">Les Gaulois du clan</h2>
          <p class="info-discrete tnum mt-2">
            {vitrine.length > 1 ? `${fmtInt(vitrine.length)} Gaulois déjà habillés par leur membre` : "1 Gaulois déjà habillé par son membre"}{releve && `, ${vitrine.length > 1 ? "relevés" : "relevé"} le ${fmtDayAndTime(releve)}`}.
          </p>
          <ul class="vitrine-publique mt-6">
            {vitrine.map((g) => (
              <li>
                <a class="card vitrine-publique-case" href={`${base}/membres/${encodeURIComponent(g.id)}`} data-testid="vitrine-publique-gaulois">
                  <GauloisPortrait id={g.id} pose="pied" taille={2} />
                  <span class="pseudo">{g.pseudo}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>
