---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import MapNamesCredit from "../components/MapNamesCredit.astro";
import MyPlace from "../components/MyPlace.tsx";
import NewsBoard from "../components/NewsBoard";
import SinceLastVisit from "../components/SinceLastVisit.tsx";
import { AUTH_ENABLED } from "../lib/compte/api";
import { clan } from "../../config/clan";
import { bestGameOf, bestGameSentence, yesterdayOf } from "../lib/belle-partie";
import { brandFile } from "../lib/brand";
import { objectiveFor } from "../lib/clanmap/economy";
import { loadAnnouncements, loadClanMapFilm, loadEvents, loadGames, loadHistory, loadLeaderboard, loadMembers, loadMemberWeeks, loadMeta, loadSessions, loadTerritoryReadings } from "../lib/data";
import { fmtDate, fmtDateTime, fmtDay, fmtDayAndTime, fmtDec1, fmtInt, fmtPct, fmtRank, fmtScore } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { editionLead, gazetteEditions, weekLabel } from "../lib/gazette";
import { clanJournal } from "../lib/journal";
import { mapLabel } from "../lib/map-names";
import { bestSlots, buildHeatmap, dailySeries, slotsOfDay } from "../lib/sessions";
import { findClan, neighbours, winRate, withOfficialRanks } from "../lib/stats";
import { parisParts, WEEKDAYS_FR } from "../lib/time";
import { loadVisitSnapshot } from "../lib/visite-snapshot";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const leaderboard = loadLeaderboard();
const clans = leaderboard ? withOfficialRanks(leaderboard.clans) : [];
const me = findClan(clans, clan.tag);
const near = neighbours(clans, clan.tag);
const rate = me ? winRate(me.wins, me.games) : null;
const hasLogo = brandFile("vertical") !== null;
const hasBanner = brandFile("banner") !== null;
const announcements = loadAnnouncements();
const now = new Date();
const events = loadEvents().filter((e) => e.start >= now.toISOString());

const cards = [
  { label: "Rang", value: me ? fmtRank(me.rank) : null, hint: `sur ${leaderboard?.clans.length ?? "—"} clans listés` },
  { label: "Score", value: me ? fmtScore(me.weightedWins) : null, count: me?.weightedWins, decimals: 2, hint: "victoires pondérées" },
  { label: "Parties", value: me ? fmtInt(me.games) : null, count: me?.games, hint: "sur 90 jours" },
  { label: "Victoires", value: me ? fmtInt(me.wins) : null, count: me?.wins, hint: "sur 90 jours" },
  { label: "Taux de victoire", value: rate === null ? null : fmtPct(rate), hint: "victoires ÷ parties" },
];

// Chaque bloc résume une page et y renvoie : uniquement des données collectées.
const sessions = loadSessions();
const games = loadGames();
const members = loadMembers();
const film = loadClanMapFilm();
const onMap = film?.galSummary ?? null;
const objective = objectiveFor(film?.standings ?? [], clan.tag);
const gazette = gazetteEditions({ sessions, history: loadHistory(), territory: loadTerritoryReadings(), weekTops: loadMemberWeeks().tops, members, archiveStart: clan.archiveStart, completeThrough: meta.sessions.completeThrough })[0] ?? null;

const recent = dailySeries(sessions, clan.archiveStart, meta.sessions.coveredUntil).slice(-14);
const recentMax = Math.max(1, ...recent.map((d) => d.games));
const recentGames = recent.reduce((n, d) => n + d.games, 0);
const recentWins = recent.reduce((n, d) => n + d.wins, 0);
const { rows: journal } = clanJournal({ sessions, games, coveredUntil: meta.sessions.coveredUntil, tag: clan.tag, officialTags: clans.map((c) => c.clanTag) });
const lastGames = journal.slice(0, 5);
// La belle partie d'hier : le plus de Gaulois ensemble la veille de la collecte, règle dans src/lib/belle-partie.ts.
const bestYesterday = meta.sessions.coveredUntil ? bestGameOf(journal, yesterdayOf(meta.sessions.coveredUntil)) : null;
const creditMaps = lastGames.some((game) => game.map !== null) || (bestYesterday?.map ?? null) !== null;

const heat = buildHeatmap(sessions, meta.sessions.coveredUntil);
const weekday = parisParts(now).weekday;
const todaySlots = slotsOfDay(heat, weekday, 3);
const slots = todaySlots.length > 0 ? todaySlots : bestSlots(heat, 3);
const dayName = (WEEKDAYS_FR[weekday] ?? "").toLowerCase();

// Le même relevé que sur la page Carte, où il fait reprendre le film.
const snapshot = loadVisitSnapshot();
---

<Base>
  <section class="relative overflow-hidden">
    <div class="wrap relative grid items-center gap-6 pb-8 pt-6 md:grid-cols-[3fr_2fr] md:gap-10 md:pb-10 md:pt-10">
      <div class="reveal order-2 md:order-1">
        <span class="tribar mb-6"></span>
        <h1 class="text-[2.75rem] !leading-[0.95] sm:text-6xl md:text-5xl lg:text-6xl">{clan.tagline}</h1>
        {clan.description && <p class="mt-5 max-w-md text-lg text-muted">{clan.description}</p>}
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={clan.links.discord} class="btn btn-lg btn-primary" rel="noopener">Rejoindre le Discord</a>
          <a href={clan.links.openfront} class="btn btn-lg btn-secondary" rel="noopener">Jouer à OpenFront</a>
        </div>
        <p class="mt-4 text-sm text-muted" data-fx-hint hidden>
          Bougez la souris et cliquez sur le fond : clic gauche pour une vague bleue, clic droit pour une vague rouge.
        </p>
      </div>
      <div class="fx-stage reveal relative order-1 flex justify-center md:order-2">
        <div class="hero-glow" aria-hidden="true"></div>
        {
          hasLogo ? (
            <div class="float relative w-36 sm:w-56 md:w-full md:max-w-sm">
              <img
                src={`${base}/generated/logo-vertical-720.webp`}
                width="720"
                height="720"
                alt="Logo du clan GAL, Les Gaulois : un guerrier gaulois de profil, un casque à plumes tricolore et le lettrage GAL."
                class="h-auto w-full"
                draggable="false"
                data-fx-logo
              />
            </div>
          ) : (
            <div class="relative text-center" aria-hidden="true">
              <p class="font-display text-8xl font-black leading-none tracking-tight sm:text-9xl">{clan.tag}</p>
              <p class="mt-3 font-display text-xl font-bold tracking-[0.3em] sm:text-3xl">LES GAULOIS</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <div class="wrap grid grid-cols-1 gap-6">
    {snapshot && <SinceLastVisit client:load snapshot={snapshot} gazetteHref={`${base}/gazette`} />}

    {
      AUTH_ENABLED ? (
        <NewsBoard client:idle announcements={announcements} events={events} now={Date.now()} live />
      ) : (
        <NewsBoard announcements={announcements} events={events} now={Date.now()} />
      )
    }

    <section class="stage stage-blue reveal" aria-labelledby="stats-title">
      <h2 id="stats-title" class="section-title section-title-sm">Le clan au classement officiel</h2>
      <div class="mt-6 grid grid-cols-2 gap-x-6 gap-y-6 md:grid-cols-3 lg:grid-cols-5">
        {
          cards.map((c) => (
            <div data-testid="stat-card">
              <p class="text-sm font-semibold text-muted">{c.label}</p>
              {c.value === null ? (
                <p class="mt-2 font-display text-lg font-bold">Pas de données</p>
              ) : (
                <p class="tnum mt-1 font-display text-3xl font-extrabold sm:text-4xl" data-count={c.count} data-decimals={c.decimals ?? 0}>
                  {c.value}
                </p>
              )}
              <p class="mt-1 text-xs text-muted">{c.hint}</p>
              {
                c.label === "Taux de victoire" && rate !== null && (
                  <div class="meter mt-3" aria-hidden="true">
                    <i style={{ "--v": `${rate}%` }}></i>
                  </div>
                )
              }
            </div>
          ))
        }
      </div>
      {
        leaderboard && !me && (
          <p class="mt-6 font-semibold text-warn">
            [{clan.tag}] ne figure pas dans la liste officielle au {fmtDateTime(leaderboard.end)} : le clan est hors classement.
          </p>
        )
      }
      {
        me && near && (near.above || near.below) && (
          <ul class="tnum mt-6 flex flex-wrap gap-x-8 gap-y-1 font-semibold" data-testid="home-race">
            {near.above && <li>{fmtScore(near.above.gap)} de retard sur [{near.above.clan.clanTag}], {fmtRank(near.above.clan.rank)}</li>}
            {near.below && <li>{fmtScore(near.below.gap)} d'avance sur [{near.below.clan.clanTag}], {fmtRank(near.below.clan.rank)}</li>}
          </ul>
        )
      }
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`${base}/classement`} class="btn btn-secondary">Voir le classement complet</a>
        {me && near && <a href={`${base}/rivaux`} class="btn btn-ghost" data-testid="home-rivals">Voir nos rivaux</a>}
      </div>
      <div class="mt-6">
        <DataStatus state={meta.leaderboard} maxAgeHours={MAX_AGE_HOURS.leaderboard} asOf={leaderboard?.end} asOfLabel="Classement arrêté au" />
        {
          leaderboard && (
            <p class="mt-1 text-sm text-muted">
              Période du classement : {fmtDate(leaderboard.start)} au {fmtDate(leaderboard.end)}. Parties publiques en équipe, sans le classé.
            </p>
          )
        }
      </div>
    </section>

    <div class="grid gap-6 lg:grid-cols-2">
      {
        gazette && (
          <section class="stage stage-night reveal flex flex-col" aria-labelledby="gazette-title" data-testid="home-gazette">
            <h2 id="gazette-title" class="section-title section-title-sm">La gazette du clan</h2>
            <p class="mt-4 text-sm font-semibold text-muted">Semaine {weekLabel(gazette)}</p>
            <p class="mt-1 text-lg text-muted">{editionLead(gazette, clan.tag)}</p>
            <p class="mt-3 text-sm text-muted">Une nouvelle édition paraît chaque lundi.</p>
            <a href={`${base}/gazette`} class="btn btn-ghost mt-6 self-start">Lire la gazette</a>
          </section>
        )
      }

      <section class="stage stage-night reveal scroll-mt-24" id="ma-place" aria-labelledby="place-title" data-testid="my-place">
        <h2 id="place-title" class="section-title section-title-sm">Ma place dans le clan</h2>
        <p class="mt-3 text-muted">Votre rang aux victoires sous le tag, votre palier et le prochain joueur à dépasser.</p>
        <div class="mt-4">
          <MyPlace client:idle src={`${base}/data/members.json`} />
        </div>
        <noscript><p class="mt-3 text-sm text-muted">JavaScript est nécessaire pour chercher un pseudo. La liste complète reste sur la page <a href={`${base}/membres`}>Membres</a>.</p></noscript>
      </section>
    </div>

    {
      film && onMap && onMap.pixels > 0 && (
        <section class="stage stage-night reveal grid items-center gap-8 md:grid-cols-2" aria-labelledby="map-title">
          <div>
            <h2 id="map-title" class="section-title section-title-sm">{fmtInt(onMap.pixels)} pixels sur la carte</h2>
            <p class="mt-4 max-w-md text-lg text-muted">
              Le territoire peint par le clan sur la carte officielle d'OpenFront{onMap.rank !== null && `, ${fmtRank(onMap.rank)} au ${fmtDate(film.fetchedAt)}`}. Ce n'est pas le classement des clans.
            </p>
            {
              objective?.above && (
                <p class="tnum mt-3 max-w-md font-semibold" data-testid="home-objective">
                  Prochain objectif : dépasser [{objective.above.tag}], encore {fmtInt(objective.above.pixels - objective.me.pixels + 1)} pixels.
                </p>
              )
            }
            <a href={`${base}/carte`} class="btn btn-ghost mt-6">Voir le film de la conquête</a>
          </div>
          <img
            src={`${base}/generated/carte/finale-800.webp`}
            srcset={`${base}/generated/carte/finale-800.webp 800w, ${base}/generated/carte/finale-1400.webp 1400w`}
            sizes="(min-width: 768px) 560px, calc(100vw - 5rem)"
            width="1400"
            height={Math.round((1400 * film.rows) / film.cols)}
            loading="lazy"
            alt="La carte officielle des clans, où chaque clan occupe un territoire de sa couleur."
            class="h-auto w-full rounded-2xl"
          />
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section class="stage stage-indigo reveal grid gap-8 md:grid-cols-2" aria-labelledby="progress-title">
          <div>
            <h2 id="progress-title" class="section-title section-title-sm">{fmtInt(recentGames)} parties en 14 jours</h2>
            <p class="mt-3 max-w-md text-lg text-muted">
              {fmtInt(recentWins)} victoires, soit {fmtPct(winRate(recentWins, recentGames))}. Parties publiques en équipe jouées avec le tag.
            </p>
            {
              bestYesterday && (
                <p class="tnum mt-4 text-sm" data-testid="home-best-game">
                  <strong>La belle partie d'hier.</strong> {bestGameSentence(bestYesterday)}
                </p>
              )
            }
            {
              lastGames.length > 0 && (
                <ul class="tnum mt-4 divide-y divide-white/10 text-sm" data-testid="home-games">
                  {lastGames.map((game) => (
                    <li class="flex flex-wrap items-baseline justify-between gap-x-4 py-1.5">
                      <span class="min-w-0">{fmtDayAndTime(game.at)}{game.map !== null && <span class="text-muted"> sur {mapLabel(game.map)}</span>}</span>
                      <span class="ml-auto font-semibold">{game.won ? "Victoire" : "Défaite"}</span>
                    </li>
                  ))}
                </ul>
              )
            }
            {creditMaps && <MapNamesCredit />}
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={`${base}/parties`} class="btn btn-ghost">Voir les dernières parties</a>
              <a href={`${base}/progression`} class="btn btn-ghost">Voir la progression</a>
            </div>
          </div>
          <div class="panel self-center">
            <div class="fx-bars flex h-44 items-end" aria-hidden="true" data-ripple-group>
              {
                recent.map((d, i) => (
                  <div class="flex h-full flex-1 flex-col justify-end px-0.5" title={`${fmtDay(d.date)} : ${fmtInt(d.games)} parties, ${fmtInt(d.wins)} victoires`}>
                    <div class="fx-grow flex flex-col gap-0.5" data-ripple="glow" style={{ height: `${(d.games / recentMax) * 100}%`, opacity: d.partial ? 0.55 : 1, "--i": i }}>
                      {d.losses > 0 && <div class="min-h-px rounded-t bg-loss" style={{ flexGrow: d.losses, flexBasis: 0 }} />}
                      {d.wins > 0 && <div class:list={["min-h-px bg-win", d.losses === 0 && "rounded-t"]} style={{ flexGrow: d.wins, flexBasis: 0 }} />}
                    </div>
                  </div>
                ))
              }
            </div>
            <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-muted">
              <span class="flex items-center gap-1.5"><i class="inline-block size-3 rounded-sm bg-win" aria-hidden="true"></i>Victoires</span>
              <span class="flex items-center gap-1.5"><i class="inline-block size-3 rounded-sm bg-loss" aria-hidden="true"></i>Défaites</span>
              <span class="tnum ml-auto">{fmtDay(recent[0]?.date ?? "")} au {fmtDay(recent[recent.length - 1]?.date ?? "")}</span>
            </div>
          </div>
        </section>
      )
    }

    {
      slots.length > 0 && (
        <section class="stage stage-wine reveal grid items-center gap-8 md:grid-cols-2" aria-labelledby="slots-title">
          <div>
            <h2 id="slots-title" class="section-title section-title-sm">{todaySlots.length > 0 ? `Quand jouer le ${dayName}` : "Quand le clan joue le plus"}</h2>
            <p class="mt-4 max-w-md text-lg text-muted">
              Les créneaux avec le plus de parties enregistrées sur 90 jours, en heure de Paris. Ce sont des parties, pas des joueurs connectés.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href={clan.links.discord} class="btn btn-secondary" rel="noopener">Trouver un groupe sur Discord</a>
              <a href={`${base}/activite`} class="btn btn-ghost">Voir quand jouer</a>
            </div>
          </div>
          <ol class="panel space-y-3">
            {
              slots.map((s) => (
                <li data-testid="home-slot">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                    <span class="font-display text-xl font-extrabold uppercase">{WEEKDAYS_FR[s.weekday]} {s.hour} h</span>
                    <span class="tnum text-sm text-muted">{fmtInt(s.games)} parties · {fmtDec1(s.avgPlayers)} joueurs du clan</span>
                  </div>
                  <div class="meter mt-2" aria-hidden="true">
                    <i style={{ "--v": `${(s.games / (slots[0]?.games ?? s.games)) * 100}%` }}></i>
                  </div>
                </li>
              ))
            }
          </ol>
        </section>
      )
    }

    <section class="stage stage-night reveal grid items-center gap-8 md:grid-cols-2" aria-labelledby="join-title">
      <div>
        <h2 id="join-title" class="section-title section-title-sm">Rejoignez les Gaulois</h2>
        <p class="mt-4 max-w-md text-lg text-muted">
          {clan.join.inviteOnly ? "Le clan fonctionne sur invitation : demandez-la dans le jeu, puis retrouvez-nous sur Discord." : "Rejoignez le clan dans le jeu, puis retrouvez-nous sur Discord."}
          {members && <span data-testid="home-members"> {fmtInt(members.total)} membres dans la liste officielle.</span>}
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={`${base}/rejoindre`} class="btn btn-lg btn-secondary">Voir les étapes</a>
          <a href={`${base}/debuter`} class="btn btn-lg btn-ghost">Lire les guides</a>
        </div>
      </div>
      {
        hasBanner && (
          <img
            src={`${base}/generated/banner-1600.webp`}
            srcset={`${base}/generated/banner-800.webp 800w, ${base}/generated/banner-1600.webp 1600w`}
            sizes="(min-width: 768px) 560px, calc(100vw - 5rem)"
            width="1672"
            height="941"
            loading="lazy"
            alt="Bannière du clan GAL, Les Gaulois."
            class="h-auto w-full rounded-2xl"
          />
        )
      }
    </section>
  </div>
</Base>
