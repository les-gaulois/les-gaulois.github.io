---
import { createHash } from "node:crypto";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import ClanWeek from "../components/ClanWeek.astro";
import DataStatus from "../components/DataStatus.astro";
import MyPlace from "../components/MyPlace.tsx";
import NewsBoard from "../components/NewsBoard";
import SinceLastVisit from "../components/SinceLastVisit.tsx";
import { AUTH_ENABLED } from "../lib/compte/api";
import { clan } from "../../config/clan";
import { ACCUEIL_IMAGE, accueilFacts, accueilImageAlt, accueilRanking } from "../lib/accueil-image";
import { bestGameOf, bestGameSentence, yesterdayOf } from "../lib/belle-partie";
import { brandFile } from "../lib/brand";
import { loadAnnouncements, loadClanMapFilm, loadEvents, loadGames, loadHistory, loadLeaderboard, loadMembers, loadMemberWeeks, loadMeta, loadSessions, loadTerritoryReadings } from "../lib/data";
import { fmtDateTime, fmtInt, fmtPct, fmtRank, fmtScore } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { gazetteEditions } from "../lib/gazette";
import { clanJournal } from "../lib/journal";
import { ME_KEY } from "../lib/moi";
import { clanRecords } from "../lib/results";
import { findClan, neighbours, winRate, withOfficialRanks } from "../lib/stats";
import { recentRecordLines, recentTerritoryRecord } from "../lib/vie-du-clan";
import { milestonesSinceMonday } from "../lib/week-players";
import { loadVisitSnapshot } from "../lib/visite-snapshot";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const leaderboard = loadLeaderboard();
const clans = leaderboard ? withOfficialRanks(leaderboard.clans) : [];
const me = findClan(clans, clan.tag);
const near = neighbours(clans, clan.tag);
const rate = me ? winRate(me.wins, me.games) : null;
const hasLogo = brandFile("vertical") !== null;
const hasBanner = brandFile("banner") !== null;
const announcements = loadAnnouncements();
const now = new Date();
const events = loadEvents().filter((e) => e.start >= now.toISOString());

const cards = [
  { label: "Rang", value: me ? fmtRank(me.rank) : null, hint: `sur ${leaderboard?.clans.length ?? "—"} clans listés` },
  { label: "Score", value: me ? fmtScore(me.weightedWins) : null, count: me?.weightedWins, decimals: 2, hint: "victoires pondérées" },
  { label: "Parties", value: me ? fmtInt(me.games) : null, count: me?.games, hint: "sur 90 jours" },
  { label: "Victoires", value: me ? fmtInt(me.wins) : null, count: me?.wins, hint: "sur 90 jours" },
  { label: "Taux de victoire", value: rate === null ? null : fmtPct(rate), hint: "victoires ÷ parties" },
];

// Chaque bloc résume une page et y renvoie : uniquement des données collectées. La carte, les dernières parties
// et les créneaux ont chacun leur page : l'accueil ne les recopie plus depuis le 12 novembre 2026.
const sessions = loadSessions();
const games = loadGames();
const members = loadMembers();
const film = loadClanMapFilm();
const onMap = film?.galSummary ?? null;
const memberWeeks = loadMemberWeeks();
const gazette = gazetteEditions({ sessions, history: loadHistory(), territory: loadTerritoryReadings(), weekTops: memberWeeks.tops, members, archiveStart: clan.archiveStart, completeThrough: meta.sessions.completeThrough })[0] ?? null;
// Le fil du clan : les paliers franchis depuis le relevé du lundi, et les records des sept derniers jours. Règles dans src/lib/vie-du-clan.ts.
const currentMilestones = milestonesSinceMonday(memberWeeks.reading, members);
const recordLines = recentRecordLines(clanRecords(sessions), meta.sessions.coveredUntil);
const territoryRecord = recentTerritoryRecord(onMap?.peak ?? null, film?.fetchedAt ?? null);

// La belle partie d'hier : le plus de Gaulois ensemble la veille de la collecte, règle dans src/lib/belle-partie.ts.
const { rows: journal } = clanJournal({ sessions, games, coveredUntil: meta.sessions.coveredUntil, tag: clan.tag, officialTags: clans.map((c) => c.clanTag) });
const bestYesterday = meta.sessions.coveredUntil ? bestGameOf(journal, yesterdayOf(meta.sessions.coveredUntil)) : null;

// Le même relevé que sur la page Carte, où il fait reprendre le film.
const snapshot = loadVisitSnapshot();

// L'image d'aperçu d'un lien vers l'accueil : le rang et le podium de la semaine, dessinés au build (scripts/generate-accueil-image.ts).
// Son adresse change avec son contenu, pour que Discord ne garde pas l'ancienne. Sans elle, celle du site.
const imageFile = join("public", ACCUEIL_IMAGE);
const imageFacts = accueilFacts(accueilRanking(leaderboard, clan.tag), gazette);
const hasImage = imageFacts !== null && existsSync(imageFile);
const image = hasImage ? `${base}/${ACCUEIL_IMAGE}?v=${createHash("sha256").update(readFileSync(imageFile)).digest("hex").slice(0, 12)}` : undefined;
const imageAlt = hasImage && imageFacts ? accueilImageAlt(imageFacts, clan.tag, clan.name) : undefined;
---

<Base image={image} imageAlt={imageAlt}>
  <section class="relative overflow-hidden">
    <div class="wrap relative grid items-center gap-6 pb-8 pt-6 md:grid-cols-[3fr_2fr] md:gap-10 md:pb-10 md:pt-10">
      <div class="reveal order-2 md:order-1">
        <span class="tribar mb-6"></span>
        <h1 class="text-[2.75rem] !leading-[0.95] sm:text-6xl md:text-5xl lg:text-6xl xl:text-7xl">{clan.tagline}</h1>
        {clan.description && <p class="mt-5 max-w-md text-lg text-muted">{clan.description}</p>}
        {/* Deux gestes qui servent d'abord aux membres : retrouver le clan sur Discord et lancer une partie. L'appel à rejoindre le clan est en bas de page. */}
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={clan.links.discord} class="btn btn-lg btn-primary" rel="noopener">Aller sur le Discord</a>
          <a href={clan.links.openfront} class="btn btn-lg btn-secondary" rel="noopener">Jouer à OpenFront</a>
        </div>
        <p class="mt-4 text-sm text-muted" data-fx-hint hidden>Cliquez sur le fond : clic gauche en bleu, clic droit en rouge.</p>
      </div>
      <div class="fx-stage reveal relative order-1 flex justify-center md:order-2">
        <div class="hero-glow" aria-hidden="true"></div>
        {
          hasLogo ? (
            <div class="float relative w-36 sm:w-56 md:w-full md:max-w-sm">
              <img
                src={`${base}/generated/logo-vertical-720.webp`}
                width="720"
                height="720"
                alt="Logo du clan GAL, Les Gaulois : un guerrier gaulois de profil, un casque à plumes tricolore et le lettrage GAL."
                class="h-auto w-full"
                draggable="false"
                data-fx-logo
              />
            </div>
          ) : (
            <div class="relative text-center" aria-hidden="true">
              <p class="font-display text-8xl font-black leading-none tracking-tight sm:text-9xl">{clan.tag}</p>
              <p class="mt-3 font-display text-xl font-bold tracking-[0.3em] sm:text-3xl">LES GAULOIS</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <div class="wrap grid grid-cols-1 gap-6">
    {snapshot && <SinceLastVisit client:load snapshot={snapshot} gazetteHref={`${base}/gazette`} />}

    {
      AUTH_ENABLED ? (
        <NewsBoard client:idle announcements={announcements} events={events} now={Date.now()} live />
      ) : (
        <NewsBoard announcements={announcements} events={events} now={Date.now()} />
      )
    }

    {/* Le clan au classement officiel, d'abord : le rang dit tout de suite où en est GAL. */}
    <section class="stage stage-blue reveal" id="classement-clan" aria-labelledby="stats-title">
      <h2 id="stats-title" class="section-title section-title-sm">Le clan au classement officiel</h2>
      {/* Les chiffres en grand, sans case : un filet à gauche de chacun. La rangée passe à la ligne quand la place manque. */}
      <div class="kpi-row mt-8">
        {
          cards.map((c) => (
            <div class="kpi" data-testid="stat-card">
              <p class="kpi-label">{c.label}</p>
              {c.value === null ? (
                <p class="mt-2 font-display text-lg font-bold">Pas de données</p>
              ) : (
                <p class="kpi-value" data-count={c.count} data-decimals={c.decimals ?? 0}>
                  {c.value}
                </p>
              )}
              <p class="kpi-hint">{c.hint}</p>
              {
                c.label === "Taux de victoire" && rate !== null && (
                  <div class="meter mt-3" aria-hidden="true">
                    <i style={{ "--v": `${rate}%` }}></i>
                  </div>
                )
              }
            </div>
          ))
        }
      </div>
      {
        leaderboard && !me && (
          <p class="mt-6 font-semibold text-warn">
            [{clan.tag}] ne figure pas dans la liste officielle au {fmtDateTime(leaderboard.end)} : le clan est hors classement.
          </p>
        )
      }
      {
        me && near && (near.above || near.below) && (
          <ul class="tnum mt-6 flex flex-wrap gap-x-8 gap-y-1 font-semibold" data-testid="home-race">
            {near.above && <li>{fmtScore(near.above.gap)} de retard sur [{near.above.clan.clanTag}], {fmtRank(near.above.clan.rank)}</li>}
            {near.below && <li>{fmtScore(near.below.gap)} d'avance sur [{near.below.clan.clanTag}], {fmtRank(near.below.clan.rank)}</li>}
          </ul>
        )
      }
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`${base}/classement`} class="btn btn-secondary">Voir le classement complet</a>
        {me && near && <a href={`${base}/rivaux`} class="btn btn-ghost" data-testid="home-rivals">Voir nos rivaux</a>}
      </div>
      <div class="mt-6">
        <DataStatus state={meta.leaderboard} maxAgeHours={MAX_AGE_HOURS.leaderboard} asOf={leaderboard?.end} asOfLabel="Classement arrêté au" />
      </div>
    </section>

    {/* Ce que les membres viennent de faire : le résumé de la dernière gazette, et ce qui s'est passé depuis. */}
    {gazette && <ClanWeek edition={gazette} currentMilestones={currentMilestones} records={recordLines} territoryRecord={territoryRecord} bestGame={bestYesterday ? bestGameSentence(bestYesterday) : null} creditMaps={(bestYesterday?.map ?? null) !== null} live={AUTH_ENABLED} />}

    {/* Ce qui est à chacun : sa place dans le clan, et la porte de la face privée. */}
    <div class:list={["grid gap-6", AUTH_ENABLED && "lg:grid-cols-2"]} id="rangee-moi" data-testid="home-me-row">
      {/*
        « C'est moi » : le membre qui a retenu son pseudo (src/lib/moi.ts) retrouve sa place, et la porte du QG, avant le classement.
        Premier enfant de la rangée, ce script la déplace avant que la page la remplisse : « Ma place » ne se réveille qu'une fois,
        à sa vraie place, et l'ordre de la page reste celui qu'on voit et qu'on parcourt au clavier. Sans stockage ni JavaScript, rien ne bouge.
      */}
      <script is:inline define:vars={{ meKey: ME_KEY }}>
        try {
          if (localStorage.getItem(meKey)) {
            const row = document.getElementById("rangee-moi");
            const ranking = document.getElementById("classement-clan");
            if (row && ranking) ranking.before(row);
          }
        } catch {
          // Stockage indisponible : l'ordre reste celui de tous.
        }
      </script>
      <section class="stage stage-night reveal scroll-mt-24" id="ma-place" aria-labelledby="place-title" data-testid="my-place">
        <h2 id="place-title" class="section-title section-title-sm">Ma place dans le clan</h2>
        <div class="mt-4">
          <MyPlace client:idle src={`${base}/data/members.json`} />
        </div>
        <noscript><p class="mt-3 text-sm text-muted">JavaScript est nécessaire pour chercher un pseudo. La liste complète reste sur la page <a href={`${base}/membres`}>Membres</a>.</p></noscript>
      </section>

      {/* La porte de la face privée : le contenu du QG n'est pas dans cette page, le serveur ne le donne qu'aux membres validés. */}
      {
        AUTH_ENABLED && (
          <section class="stage stage-night reveal flex flex-col items-start" aria-labelledby="qg-title" data-testid="home-qg">
            <h2 id="qg-title" class="section-title section-title-sm">Le QG des membres</h2>
            <p class="mt-3 max-w-xl text-muted">Salons, sondages, idées et mur des membres : réservé aux membres de GAL.</p>
            {/* Vide dans la page publiée : pour un membre validé connecté, ce qui l'attend au QG (src/scripts/visages.ts). */}
            <p class="tnum mt-3 font-semibold" data-qg-waiting data-testid="home-qg-waiting" hidden></p>
            <a href={`${base}/qg`} class="btn btn-secondary mt-6">Entrer dans le QG</a>
          </section>
        )
      }
    </div>

    <section class="stage stage-night reveal grid items-center gap-8 md:grid-cols-2" aria-labelledby="join-title" data-testid="home-join">
      <div>
        <h2 id="join-title" class="section-title section-title-sm">Rejoignez les Gaulois</h2>
        <p class="mt-4 max-w-md text-lg text-muted">
          {clan.join.inviteOnly ? "Demandez une invitation dans le jeu, puis venez sur Discord." : "Rejoignez le clan dans le jeu, puis venez sur Discord."}
          {members && <span data-testid="home-members"> {fmtInt(members.total)} membres.</span>}
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={`${base}/rejoindre`} class="btn btn-lg btn-secondary">Voir les étapes</a>
          <a href={`${base}/debuter`} class="btn btn-lg btn-ghost">Lire les guides</a>
        </div>
      </div>
      {
        hasBanner && (
          <img
            src={`${base}/generated/banner-1600.webp`}
            srcset={`${base}/generated/banner-800.webp 800w, ${base}/generated/banner-1600.webp 1600w`}
            sizes="(min-width: 768px) 560px, calc(100vw - 5rem)"
            width="1672"
            height="941"
            loading="lazy"
            alt="Bannière du clan GAL, Les Gaulois."
            class="h-auto w-full rounded-2xl"
          />
        )
      }
    </section>
  </div>
</Base>
