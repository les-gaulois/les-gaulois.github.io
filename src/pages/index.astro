---
import Base from "../layouts/Base.astro";
import ClanWeek from "../components/ClanWeek.astro";
import DataStatus from "../components/DataStatus.astro";
import MapNamesCredit from "../components/MapNamesCredit.astro";
import MyPlace from "../components/MyPlace.tsx";
import NewsBoard from "../components/NewsBoard";
import SinceLastVisit from "../components/SinceLastVisit.tsx";
import { AUTH_ENABLED } from "../lib/compte/api";
import { clan } from "../../config/clan";
import { bestGameOf, bestGameSentence, yesterdayOf } from "../lib/belle-partie";
import { brandFile } from "../lib/brand";
import { countAxis } from "../lib/chart";
import { objectiveFor } from "../lib/clanmap/economy";
import { loadAnnouncements, loadClanMapFilm, loadEvents, loadGames, loadHistory, loadLeaderboard, loadMembers, loadMemberWeeks, loadMeta, loadSessions, loadTerritoryReadings } from "../lib/data";
import { fmtDate, fmtDateTime, fmtDay, fmtDayAndTime, fmtDec1, fmtInt, fmtPct, fmtRank, fmtScore } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { gazetteEditions } from "../lib/gazette";
import { clanJournal } from "../lib/journal";
import { mapLabel } from "../lib/map-names";
import { clanRecords } from "../lib/results";
import { bestSlots, buildHeatmap, dailySeries, slotsOfDay } from "../lib/sessions";
import { findClan, neighbours, winRate, withOfficialRanks } from "../lib/stats";
import { parisParts, WEEKDAYS_FR } from "../lib/time";
import { recentRecordLines, recentTerritoryRecord } from "../lib/vie-du-clan";
import { milestonesSinceMonday } from "../lib/week-players";
import { loadVisitSnapshot } from "../lib/visite-snapshot";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const leaderboard = loadLeaderboard();
const clans = leaderboard ? withOfficialRanks(leaderboard.clans) : [];
const me = findClan(clans, clan.tag);
const near = neighbours(clans, clan.tag);
const rate = me ? winRate(me.wins, me.games) : null;
const hasLogo = brandFile("vertical") !== null;
const hasBanner = brandFile("banner") !== null;
const announcements = loadAnnouncements();
const now = new Date();
const events = loadEvents().filter((e) => e.start >= now.toISOString());

const cards = [
  { label: "Rang", value: me ? fmtRank(me.rank) : null, hint: `sur ${leaderboard?.clans.length ?? "—"} clans listés` },
  { label: "Score", value: me ? fmtScore(me.weightedWins) : null, hint: "victoires pondérées" },
  { label: "Parties", value: me ? fmtInt(me.games) : null, hint: "sur 90 jours" },
  { label: "Victoires", value: me ? fmtInt(me.wins) : null, hint: "sur 90 jours" },
  { label: "Taux de victoire", value: rate === null ? null : fmtPct(rate), hint: "victoires ÷ parties" },
];

// Chaque bloc résume une page et y renvoie : uniquement des données collectées.
const sessions = loadSessions();
const games = loadGames();
const members = loadMembers();
const film = loadClanMapFilm();
const onMap = film?.galSummary ?? null;
const objective = objectiveFor(film?.standings ?? [], clan.tag);
const memberWeeks = loadMemberWeeks();
const gazette = gazetteEditions({ sessions, history: loadHistory(), territory: loadTerritoryReadings(), weekTops: memberWeeks.tops, members, archiveStart: clan.archiveStart, completeThrough: meta.sessions.completeThrough })[0] ?? null;
// Le fil du clan : les paliers franchis depuis le relevé du lundi, et les records des sept derniers jours. Règles dans src/lib/vie-du-clan.ts.
const currentMilestones = milestonesSinceMonday(memberWeeks.reading, members);
const recordLines = recentRecordLines(clanRecords(sessions), meta.sessions.coveredUntil);
const territoryRecord = recentTerritoryRecord(onMap?.peak ?? null, film?.fetchedAt ?? null);

const recent = dailySeries(sessions, clan.archiveStart, meta.sessions.coveredUntil).slice(-14);
const recentGames = recent.reduce((n, d) => n + d.games, 0);
const recentWins = recent.reduce((n, d) => n + d.wins, 0);
// L'axe du graphique : des graduations rondes, écrites, de 0 au haut de l'axe (src/lib/chart.ts).
const axis = countAxis(Math.max(0, ...recent.map((d) => d.games)));
const middle = Math.floor((recent.length - 1) / 2);
const { rows: journal } = clanJournal({ sessions, games, coveredUntil: meta.sessions.coveredUntil, tag: clan.tag, officialTags: clans.map((c) => c.clanTag) });
const lastGames = journal.slice(0, 5);
// La belle partie d'hier : le plus de Gaulois ensemble la veille de la collecte, règle dans src/lib/belle-partie.ts.
const bestYesterday = meta.sessions.coveredUntil ? bestGameOf(journal, yesterdayOf(meta.sessions.coveredUntil)) : null;
const creditMaps = lastGames.some((game) => game.map !== null);

const heat = buildHeatmap(sessions, meta.sessions.coveredUntil);
const weekday = parisParts(now).weekday;
const todaySlots = slotsOfDay(heat, weekday, 3);
const slots = todaySlots.length > 0 ? todaySlots : bestSlots(heat, 3);
const dayName = (WEEKDAYS_FR[weekday] ?? "").toLowerCase();

// Le même relevé que sur la page Carte, où il fait reprendre le film.
const snapshot = loadVisitSnapshot();
---

<Base>
  {/* L'ouverture : le nom du clan, une phrase, une seule action mise en avant. Compacte sur téléphone : les chiffres arrivent dans le premier écran. */}
  <section class="wrap grid items-center gap-8 pb-9 pt-7 md:grid-cols-[3fr_2fr] md:gap-12 md:pb-14 md:pt-14" aria-labelledby="hero-title">
    <div>
      <span class="tribar mb-5 md:mb-7"></span>
      <h1 id="hero-title" class="page-title">{clan.tagline}</h1>
      {clan.description && <p class="mt-4 max-w-xl text-lg text-muted md:mt-6 md:text-xl">{clan.description}</p>}
      <div class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-3 md:mt-8">
        <a href={clan.links.discord} class="btn btn-lg btn-primary" rel="noopener">Rejoindre le Discord</a>
        <a href={clan.links.openfront} rel="noopener" class="inline-flex min-h-11 items-center font-semibold text-white underline decoration-line-strong decoration-2 underline-offset-[6px] hover:decoration-white">Jouer à OpenFront</a>
      </div>
    </div>
    {
      hasLogo ? (
        // Sur téléphone, le badge de l'en-tête suffit : le grand logo n'est ni affiché ni téléchargé.
        <picture class="hidden justify-center md:flex">
          <source media="(max-width: 47.99rem)" srcset="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
          <img
            src={`${base}/generated/logo-vertical-720.webp`}
            width="720"
            height="720"
            alt="Logo du clan GAL, Les Gaulois : un guerrier gaulois de profil, un casque à plumes tricolore et le lettrage GAL."
            class="h-auto w-full max-w-[19rem] lg:max-w-[21rem]"
            fetchpriority="high"
          />
        </picture>
      ) : (
        <div class="hidden text-center md:block" aria-hidden="true">
          <p class="font-display text-8xl font-extrabold leading-none">{clan.tag}</p>
          <p class="mt-3 font-display text-2xl font-semibold">Les Gaulois</p>
        </div>
      )
    }
  </section>

  <div class="wrap">
    {/* Sans rien à dire, ces deux blocs ne laissent aucune trace : leur îlot ne prend pas de place. */}
    {snapshot && <SinceLastVisit client:load snapshot={snapshot} gazetteHref={`${base}/gazette`} />}
    {
      AUTH_ENABLED ? (
        <NewsBoard client:idle announcements={announcements} events={events} now={Date.now()} live />
      ) : (
        <NewsBoard announcements={announcements} events={events} now={Date.now()} />
      )
    }

    {/* Ce que les membres viennent de faire : le résumé de la dernière gazette, et ce qui s'est passé depuis. */}
    {gazette && <ClanWeek edition={gazette} currentMilestones={currentMilestones} records={recordLines} territoryRecord={territoryRecord} bestGame={bestYesterday ? bestGameSentence(bestYesterday) : null} creditMaps={(bestYesterday?.map ?? null) !== null} />}

    {/* Ce qui est à chacun : sa place dans le clan, et la porte de la face privée. Deux colonnes séparées par un filet. */}
    <div class:list={["band grid gap-12", AUTH_ENABLED && "lg:grid-cols-2 lg:gap-0"]}>
      <section class:list={["scroll-mt-24", AUTH_ENABLED && "lg:pr-12"]} id="ma-place" aria-labelledby="place-title" data-testid="my-place">
        <h2 id="place-title" class="section-title-sm">Ma place dans le clan</h2>
        <p class="mt-3 max-w-xl text-muted">Votre rang aux victoires sous le tag, votre palier et le prochain joueur à dépasser.</p>
        <div class="mt-5 max-w-md">
          <MyPlace client:idle src={`${base}/data/members.json`} />
        </div>
        <noscript><p class="mt-3 text-sm text-muted">JavaScript est nécessaire pour chercher un pseudo. La liste complète reste sur la page <a href={`${base}/membres`}>Membres</a>.</p></noscript>
      </section>

      {/* La porte de la face privée : le contenu du QG n'est pas dans cette page, le serveur ne le donne qu'aux membres validés. */}
      {
        AUTH_ENABLED && (
          <section class="flex flex-col items-start lg:border-l lg:border-line lg:pl-12" aria-labelledby="qg-title" data-testid="home-qg">
            <h2 id="qg-title" class="section-title-sm">Le QG des membres</h2>
            <p class="mt-3 max-w-xl text-muted">Les sondages et les décisions du clan, la boîte à idées et le mur des membres. Réservé aux membres de GAL reconnus par un officier.</p>
            <a href={`${base}/qg`} class="btn btn-secondary mt-6">Entrer dans le QG</a>
          </section>
        )
      }
    </div>

    {/* Le tableau de score : les chiffres du classement officiel, sans cadre, séparés par des filets. */}
    <section class="band" aria-labelledby="stats-title">
      <h2 id="stats-title" class="section-title">Le clan au classement officiel</h2>
      <dl class="mt-7 grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-3 lg:mt-9 lg:grid-cols-5 lg:gap-x-0">
        {
          cards.map((c) => (
            <div class="min-w-0 lg:border-l lg:border-line lg:px-6 lg:first:border-l-0 lg:first:pl-0" data-testid="stat-card">
              <dt class="label">{c.label}</dt>
              <dd class="mt-2">
                {c.value === null ? (
                  <span class="block font-display text-xl font-extrabold">Pas de données</span>
                ) : (
                  <span class="figure block text-[2rem] sm:text-4xl lg:text-[2rem] xl:text-[2.5rem]" data-testid="stat-value">
                    {c.value}
                  </span>
                )}
                <span class="mt-2 block text-xs text-muted">{c.hint}</span>
                {c.label === "Taux de victoire" && rate !== null && (
                  <span class="meter mt-3 block max-w-40" aria-hidden="true">
                    <i style={{ "--v": `${rate}%` }} />
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      {
        leaderboard && !me && (
          <p class="mt-7 font-semibold text-warn">
            [{clan.tag}] ne figure pas dans la liste officielle au {fmtDateTime(leaderboard.end)} : le clan est hors classement.
          </p>
        )
      }
      {
        me && near && (near.above || near.below) && (
          <ul class="tnum mt-8 flex flex-wrap gap-x-10 gap-y-1 text-lg font-semibold" data-testid="home-race">
            {near.above && <li>{fmtScore(near.above.gap)} de retard sur [{near.above.clan.clanTag}], {fmtRank(near.above.clan.rank)}</li>}
            {near.below && <li>{fmtScore(near.below.gap)} d'avance sur [{near.below.clan.clanTag}], {fmtRank(near.below.clan.rank)}</li>}
          </ul>
        )
      }
      <p class="mt-5 flex flex-wrap gap-x-7">
        <a href={`${base}/classement`} class="link">Voir le classement complet</a>
        {me && near && <a href={`${base}/rivaux`} class="link" data-testid="home-rivals">Voir nos rivaux</a>}
      </p>
      <div class="mt-6">
        <DataStatus state={meta.leaderboard} maxAgeHours={MAX_AGE_HOURS.leaderboard} asOf={leaderboard?.end} asOfLabel="Classement arrêté au" />
        {
          leaderboard && (
            <p class="mt-1 text-sm text-muted">
              Période du classement : {fmtDate(leaderboard.start)} au {fmtDate(leaderboard.end)}. Parties publiques en équipe, sans le classé.
            </p>
          )
        }
      </div>
    </section>

    {/* La carte d'abord : l'image porte la section. */}
    {
      film && onMap && onMap.pixels > 0 && (
        <section class="band grid items-center gap-8 md:grid-cols-[7fr_5fr] md:gap-12" aria-labelledby="map-title">
          <div class="md:order-2">
            <h2 id="map-title" class="section-title-sm">{fmtInt(onMap.pixels)} pixels sur la carte</h2>
            <p class="mt-4 text-lg text-muted">
              Le territoire peint par le clan sur la carte officielle d'OpenFront{onMap.rank !== null && `, ${fmtRank(onMap.rank)} au ${fmtDate(film.fetchedAt)}`}. Ce n'est pas le classement des clans.
            </p>
            {
              objective?.above && (
                <p class="tnum mt-4 font-semibold" data-testid="home-objective">
                  Prochain objectif : dépasser [{objective.above.tag}], encore {fmtInt(objective.above.pixels - objective.me.pixels + 1)} pixels.
                </p>
              )
            }
            <p class="mt-3"><a href={`${base}/carte`} class="link">Voir le film de la conquête</a></p>
          </div>
          <img
            src={`${base}/generated/carte/finale-800.webp`}
            srcset={`${base}/generated/carte/finale-800.webp 800w, ${base}/generated/carte/finale-1400.webp 1400w`}
            sizes="(min-width: 75rem) 640px, (min-width: 768px) 56vw, calc(100vw - 2rem)"
            width="1400"
            height={Math.round((1400 * film.rows) / film.cols)}
            loading="lazy"
            alt="La carte officielle des clans, où chaque clan occupe un territoire de sa couleur."
            class="h-auto w-full rounded-lg md:order-1"
          />
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section class="band" aria-labelledby="progress-title" data-testid="home-parties">
          <h2 id="progress-title" class="section-title">{fmtInt(recentGames)} parties en 14 jours</h2>
          <p class="mt-3 max-w-2xl text-lg text-muted">
            {fmtInt(recentWins)} victoires, soit {fmtPct(winRate(recentWins, recentGames))}. Parties publiques en équipe jouées avec le tag.
          </p>
          <div class="mt-8 grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-14">
            {/* Le graphique : un axe gradué, la légende au-dessus, le détail de chaque jour au survol et dans un tableau pour les lecteurs d'écran. */}
            <figure class="m-0 min-w-0">
              <figcaption class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
                <span class="flex items-center gap-2"><i class="inline-block size-3.5 rounded-sm bg-win" aria-hidden="true" />Victoires</span>
                <span class="flex items-center gap-2"><i class="inline-block size-3.5 rounded-sm bg-loss" aria-hidden="true" />Défaites</span>
                <span class="tnum ml-auto text-muted">{fmtDay(recent[0]?.date ?? "")} au {fmtDay(recent[recent.length - 1]?.date ?? "")}</span>
              </figcaption>
              <div class="relative mt-4 h-48 pl-10" aria-hidden="true">
                {axis.ticks.map((tick) => (
                  <div class="absolute inset-x-0 border-t border-line" style={{ bottom: `${(tick / axis.max) * 100}%` }}>
                    <span class="tnum absolute -top-2.5 left-0 bg-navy pr-2 text-xs text-muted">{fmtInt(tick)}</span>
                  </div>
                ))}
                <div class="absolute inset-y-0 left-10 right-0 flex items-end">
                  {recent.map((d) => (
                    <div class="flex h-full flex-1 items-end px-px" title={`${fmtDay(d.date)}${d.partial ? " (en cours)" : ""} : ${fmtInt(d.games)} parties, ${fmtInt(d.wins)} victoires, ${fmtInt(d.losses)} défaites`}>
                      {d.games > 0 && (
                        <div class="bar-stack" style={{ height: `${(d.games / axis.max) * 100}%`, opacity: d.partial ? 0.55 : 1 }}>
                          {d.losses > 0 && <div class="min-h-px bg-loss" style={{ flexGrow: d.losses, flexBasis: 0 }} />}
                          {d.wins > 0 && <div class="min-h-px bg-win" style={{ flexGrow: d.wins, flexBasis: 0 }} />}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
              <div class="tnum relative mt-2 h-5 pl-10 text-xs text-muted" aria-hidden="true">
                <div class="flex">
                  {recent.map((d, i) => (
                    <div class="relative flex-1">
                      {(i === 0 || i === middle || i === recent.length - 1) && (
                        <span class:list={["absolute top-0 whitespace-nowrap", i === 0 ? "left-0" : i === recent.length - 1 ? "right-0" : "left-1/2 -translate-x-1/2"]}>{fmtDay(d.date)}</span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
              {recent.some((d) => d.partial) && <p class="mt-2 text-xs text-muted">Barre plus pâle : période encore en cours.</p>}
              {/* Un tableau ne se laisse pas réduire par sr-only : c'est son bloc qui est masqué, sinon il élargit la page. */}
              <div class="sr-only">
              <table>
                <caption>Parties, victoires et défaites par jour, sur les 14 derniers jours</caption>
                <thead>
                  <tr><th scope="col">Jour</th><th scope="col">Parties</th><th scope="col">Victoires</th><th scope="col">Défaites</th></tr>
                </thead>
                <tbody>
                  {recent.map((d) => (
                    <tr><td>{fmtDay(d.date)}{d.partial ? " (en cours)" : ""}</td><td>{fmtInt(d.games)}</td><td>{fmtInt(d.wins)}</td><td>{fmtInt(d.losses)}</td></tr>
                  ))}
                </tbody>
              </table>
              </div>
            </figure>

            <div class="min-w-0">
              {
                lastGames.length > 0 && (
                  <ul class="tnum divide-y divide-line border-y border-line text-sm" data-testid="home-games">
                    {lastGames.map((game) => (
                      <li class="flex flex-wrap items-baseline justify-between gap-x-4 py-2.5">
                        <span class="min-w-0">{fmtDayAndTime(game.at)}{game.map !== null && <span class="text-muted"> sur {mapLabel(game.map)}</span>}</span>
                        <span class="ml-auto flex items-center gap-2 font-semibold">
                          <i class:list={["inline-block size-2.5 rounded-full", game.won ? "bg-win" : "bg-loss"]} aria-hidden="true" />
                          {game.won ? "Victoire" : "Défaite"}
                        </span>
                      </li>
                    ))}
                  </ul>
                )
              }
              {creditMaps && <MapNamesCredit />}
              <p class="mt-4 flex flex-wrap gap-x-7">
                <a href={`${base}/parties`} class="link">Voir les dernières parties</a>
                <a href={`${base}/progression`} class="link">Voir la progression</a>
              </p>
            </div>
          </div>
        </section>
      )
    }

    {
      slots.length > 0 && (
        <section class="band grid gap-8 md:grid-cols-[5fr_7fr] md:gap-14" aria-labelledby="slots-title">
          <div>
            <h2 id="slots-title" class="section-title-sm">{todaySlots.length > 0 ? `Quand jouer le ${dayName}` : "Quand le clan joue le plus"}</h2>
            <p class="mt-4 text-lg text-muted">
              Les créneaux avec le plus de parties enregistrées sur 90 jours, en heure de Paris. Ce sont des parties, pas des joueurs connectés.
            </p>
            <p class="mt-3 flex flex-wrap gap-x-7">
              <a href={clan.links.discord} rel="noopener" class="link">Trouver un groupe sur Discord</a>
              <a href={`${base}/activite`} class="link">Voir quand jouer</a>
            </p>
          </div>
          <ol class="divide-y divide-line border-y border-line self-start">
            {
              slots.map((s) => (
                <li class="py-4" data-testid="home-slot">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <span class="font-display text-2xl font-semibold">{WEEKDAYS_FR[s.weekday]} {s.hour} h</span>
                    <span class="tnum text-sm text-muted">{fmtInt(s.games)} parties · {fmtDec1(s.avgPlayers)} joueurs du clan</span>
                  </div>
                  <div class="meter mt-3" aria-hidden="true">
                    <i style={{ "--v": `${(s.games / (slots[0]?.games ?? s.games)) * 100}%` }} />
                  </div>
                </li>
              ))
            }
          </ol>
        </section>
      )
    }

    <section class="band grid items-center gap-8 md:grid-cols-2 md:gap-14" aria-labelledby="join-title">
      <div>
        <h2 id="join-title" class="section-title">Rejoignez les Gaulois</h2>
        <p class="mt-4 max-w-md text-lg text-muted">
          {clan.join.inviteOnly ? "Le clan fonctionne sur invitation : demandez-la dans le jeu, puis retrouvez-nous sur Discord." : "Rejoignez le clan dans le jeu, puis retrouvez-nous sur Discord."}
          {members && <span data-testid="home-members"> {fmtInt(members.total)} membres dans la liste officielle.</span>}
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={`${base}/rejoindre`} class="btn btn-secondary">Voir les étapes</a>
          <a href={`${base}/debuter`} class="link">Lire les guides</a>
        </div>
      </div>
      {
        hasBanner && (
          <img
            src={`${base}/generated/banner-1600.webp`}
            srcset={`${base}/generated/banner-800.webp 800w, ${base}/generated/banner-1600.webp 1600w`}
            sizes="(min-width: 75rem) 560px, (min-width: 768px) 48vw, calc(100vw - 2rem)"
            width="1672"
            height="941"
            loading="lazy"
            alt="Bannière du clan GAL, Les Gaulois."
            class="h-auto w-full rounded-lg"
          />
        )
      }
    </section>
  </div>
</Base>
