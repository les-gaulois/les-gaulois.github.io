---
import { createHash } from "node:crypto";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import AccueilBooster from "../components/accueil/AccueilBooster.astro";
import AccueilParcours from "../components/accueil/AccueilParcours.astro";
import CartesPodium from "../components/CartesPodium.astro";
import DataStatus from "../components/DataStatus.astro";
import Invite from "../components/Invite.astro";
import GuerrierRelief from "../components/GuerrierRelief.astro";
import MyPlace from "../components/MyPlace.tsx";
import NewsBoard from "../components/NewsBoard";
import SinceLastVisit from "../components/SinceLastVisit.tsx";
import { AUTH_ENABLED } from "../lib/compte/api";
import { nombresDuJeu, type GauloisMontre } from "../lib/accueil-jeu";
import { EMPLACEMENTS_OBJETS, OBJETS } from "../lib/gaulois";
import { gauloisLusLe } from "../lib/gaulois-joueurs";
import { tenueOf } from "../lib/gaulois-sprite";
import { feuilleDuKit } from "../lib/jeu/kit-css";
import { CADRES } from "../lib/village/cadres";
import { rareteDuCadre } from "../lib/village/vitrine";
import { vitrinePublique } from "../lib/village/vitrine-publique";
import { BANNIERES } from "../../supabase/functions/code-discord/bannieres/index";
import { FAMILIERS } from "../../supabase/functions/code-discord/familiers/index";
import { MODELES } from "../../supabase/functions/code-discord/modeles/index";
import { clan } from "../../config/clan";
import { ACCUEIL_IMAGE, accueilFacts, accueilImageAlt, accueilRanking } from "../lib/accueil-image";
import { BANNIERES_MEMBRES_FILE, bannieresDuCache, fondsDesLignes } from "../lib/bannieres-joueurs";
import { brandFile } from "../lib/brand";
import { loadAnnouncements, loadEvents, loadHistory, loadLeaderboard, loadMembers, loadMemberWeeks, loadMeta, loadSessions, loadTerritoryReadings } from "../lib/data";
import { fmtDateTime, fmtInt, fmtPct, fmtRank, fmtScore } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { gazetteEditions, playersPeriod, weekLabel } from "../lib/gazette";
import { cartesDuPodium, legendeDuPodium } from "../lib/cartes-podium";
import { FAMILIERS_MEMBRES_FILE, familiersDuCache } from "../lib/familiers-joueurs";
import { FINITIONS_MEMBRES_FILE, finitionsDuCache } from "../lib/finitions-joueurs";
import { gauloisDuSite, portraitDuGaulois } from "../lib/gaulois-site";
import { ME_KEY } from "../lib/moi";
import { findClan, neighbours, winRate, withOfficialRanks } from "../lib/stats";
import { loadVisitSnapshot } from "../lib/visite-snapshot";
import { logoMatriceDepuisImage } from "../lib/logo-matrice-image";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Le logo du guerrier en mode Matrix, plus fin qu'au QG (72 colonnes) : c'est le grand visuel de l'accueil. Sans le
// fichier du logo, l'accueil garde le logo vertical.
const logoHeros = await logoMatriceDepuisImage(72);
const meta = loadMeta();
const leaderboard = loadLeaderboard();
const clans = leaderboard ? withOfficialRanks(leaderboard.clans) : [];
const me = findClan(clans, clan.tag);
const near = neighbours(clans, clan.tag);
const rate = me ? winRate(me.wins, me.games) : null;
const hasLogo = brandFile("vertical") !== null;
const announcements = loadAnnouncements();
const now = new Date();
const events = loadEvents().filter((e) => e.start >= now.toISOString());

const cards = [
  { label: "Rang", value: me ? fmtRank(me.rank) : null, hint: `sur ${leaderboard?.clans.length ?? "—"} clans listés` },
  { label: "Score", value: me ? fmtScore(me.weightedWins) : null, count: me?.weightedWins, decimals: 2, hint: "victoires pondérées" },
  { label: "Parties", value: me ? fmtInt(me.games) : null, count: me?.games, hint: "sur 90 jours" },
  { label: "Victoires", value: me ? fmtInt(me.wins) : null, count: me?.wins, hint: "sur 90 jours" },
  { label: "Taux de victoire", value: rate === null ? null : fmtPct(rate), hint: "part des parties gagnées" },
];

// Chaque bloc résume une page et y renvoie : uniquement des données collectées. La carte, les dernières parties
// et les créneaux ont chacun leur page : l'accueil ne les recopie plus depuis le 12 novembre 2026. Le 22 novembre 2026,
// à la demande du pilote, l'accueil perd aussi les portes de la Carte et du village, « Les Gaulois de la semaine »
// et l'appel à rejoindre ; il a demandé dans le même message des maquettes pour y mettre en valeur le jeu des Gaulois.
const sessions = loadSessions();
const members = loadMembers();
const memberWeeks = loadMemberWeeks();
const gazette = gazetteEditions({ sessions, history: loadHistory(), territory: loadTerritoryReadings(), weekTops: memberWeeks.tops, members, archiveStart: clan.archiveStart, completeThrough: meta.sessions.completeThrough })[0] ?? null;
// Le grand visuel de l'accueil : les cartes du podium de la semaine, quand au moins un de ses joueurs a créé son Gaulois
// (src/lib/cartes-podium.ts). Sinon, le guerrier en relief reste.
const fondsDuPodium = fondsDesLignes(bannieresDuCache(BANNIERES_MEMBRES_FILE, (gazette?.players ?? []).map((p) => p.id)));
const finitionsDuPodium = finitionsDuCache(FINITIONS_MEMBRES_FILE, (gazette?.players ?? []).map((p) => p.id));
const familiersDuPodium = familiersDuCache(FAMILIERS_MEMBRES_FILE, (gazette?.players ?? []).map((p) => p.id));
const cartesPodium = cartesDuPodium(gazette?.players, portraitDuGaulois, (id) => fondsDuPodium[id]?.image ?? null, (id) => finitionsDuPodium.get(id) ?? null, (id) => familiersDuPodium.get(id) ?? null);
const legendeCartes = gazette ? legendeDuPodium(playersPeriod(gazette), weekLabel(gazette)) : "";

// Le jeu des Gaulois, sous le haut de la page (22 novembre 2026, maquettes « Le booster sur la table » et « Du commun au
// divin » retenues par le pilote) : les Gaulois déjà créés par les membres au pseudo public, relevés avant la construction
// comme la vitrine des visiteurs de « Mon Gaulois », avec la rareté la plus haute qu'ils portent et leur bannière, et les
// nombres du catalogue du jeu (src/lib/accueil-jeu.ts).
const tenues = gauloisDuSite();
const vitrine = vitrinePublique(members?.members ?? [], (id) => portraitDuGaulois(id) !== null);
const fondsDeLaVitrine = fondsDesLignes(bannieresDuCache(BANNIERES_MEMBRES_FILE, vitrine.map((g) => g.id)));
const gauloisDuJeu: GauloisMontre[] = vitrine.flatMap((g) => {
  const portrait = portraitDuGaulois(g.id);
  const tenue = tenueOf(tenues, g.id);
  return portrait ? [{ ...g, portrait, rarete: tenue ? rareteDuCadre(tenue) : null, banniere: fondsDeLaVitrine[g.id]?.image ?? null }] : [];
});
const nombres = nombresDuJeu({
  objets: EMPLACEMENTS_OBJETS.flatMap((e) => Object.values(OBJETS[e])),
  familiers: FAMILIERS.length,
  uniques: MODELES.length,
  bannieres: BANNIERES.length,
  cadres: CADRES.length,
});
// Les images du kit en pixels de « Mon Gaulois » (cadres, rubans, boutons, icônes), la même feuille, gardée en cache.
const kit = await feuilleDuKit();

// Le même relevé que sur la page Carte, où il fait reprendre le film.
const snapshot = loadVisitSnapshot();

// L'image d'aperçu d'un lien vers l'accueil : le rang et le podium de la semaine, dessinés au build (scripts/generate-accueil-image.ts).
// Son adresse change avec son contenu, pour que Discord ne garde pas l'ancienne. Sans elle, celle du site.
const imageFile = join("public", ACCUEIL_IMAGE);
const imageFacts = accueilFacts(accueilRanking(leaderboard, clan.tag), gazette);
const hasImage = imageFacts !== null && existsSync(imageFile);
const image = hasImage ? `${base}/${ACCUEIL_IMAGE}?v=${createHash("sha256").update(readFileSync(imageFile)).digest("hex").slice(0, 12)}` : undefined;
const imageAlt = hasImage && imageFacts ? accueilImageAlt(imageFacts, clan.tag, clan.name) : undefined;
---

<Base image={image} imageAlt={imageAlt}>
  <link slot="tete" rel="stylesheet" href={`${base}/village/kit.css?v=${kit.version}`} />
  <section class="relative overflow-hidden">
    {/* Avec les cartes du podium, les deux colonnes sont égales : trois cartes demandent plus de largeur que le guerrier. */}
    <div class:list={["wrap relative grid items-center gap-4 pb-16 pt-5 md:gap-10 md:pb-12 md:pt-10", cartesPodium ? "md:grid-cols-2" : "md:grid-cols-[3fr_2fr]"]}>
      <div class="reveal order-2 md:order-1">
        <span class="tribar mb-4 md:mb-6"></span>
        <Invite path="/" />
        <h1 class="text-[2.6rem] sm:text-6xl md:text-5xl lg:text-6xl xl:text-7xl">{clan.tagline}</h1>
        {clan.description && <p class="mt-5 max-w-md text-lg text-muted">{clan.description}</p>}
        {/* Deux gestes qui servent d'abord aux membres : retrouver le clan sur Discord et lancer une partie. Rejoindre le clan a sa page, dans le menu. */}
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={clan.links.discord} class="btn btn-lg btn-primary" rel="noopener">Aller sur le Discord</a>
          {/* À côté du bouton principal, le second bouton est en contour : plein, en marine, il pesait autant que lui. */}
          <a href={clan.links.openfront} class="btn btn-lg btn-ghost" rel="noopener">Jouer à OpenFront</a>
        </div>
        <p class="mt-4 text-sm text-muted" data-fx-hint hidden>Cliquez sur le fond : clic gauche en bleu, clic droit en rouge.</p>
      </div>
      <div class="fx-stage reveal relative order-1 flex justify-center md:order-2">
        <div class="hero-glow" aria-hidden="true"></div>
        {
          cartesPodium ? (
            <CartesPodium cartes={cartesPodium} legende={legendeCartes} />
          ) : logoHeros ? (
            <GuerrierRelief
              data={logoHeros}
              id="logo-accueil"
              class="w-56 sm:w-72 md:w-full md:max-w-lg"
              label="Logo du clan GAL, Les Gaulois : un guerrier gaulois de profil, au casque à plumes tricolore, dessiné en caractères."
            />
          ) : hasLogo ? (
            <div class="float relative w-36 sm:w-56 md:w-full md:max-w-sm">
              <img
                src={`${base}/generated/logo-vertical-720.webp`}
                width="720"
                height="720"
                alt="Logo du clan GAL, Les Gaulois : un guerrier gaulois de profil, un casque à plumes tricolore et le lettrage GAL."
                class="h-auto w-full"
                draggable="false"
                data-fx-logo
              />
            </div>
          ) : (
            <div class="relative text-center" aria-hidden="true">
              <p class="font-display text-8xl font-black leading-none tracking-tight sm:text-9xl">{clan.tag}</p>
              <p class="mt-3 font-display text-xl font-bold tracking-[0.3em] sm:text-3xl">LES GAULOIS</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {/* Ce qui vient d'arriver, quand il y en a : le résumé depuis la dernière visite, les annonces et les événements de l'équipe.
      Sans eux, ce bloc est vide et ne prend pas de place (25-accueil-jeu.css). */}
  <div class="wrap accueil-avant grid grid-cols-1 gap-8">
    {snapshot && <SinceLastVisit client:load snapshot={snapshot} gazetteHref={`${base}/gazette`} />}

    {
      AUTH_ENABLED ? (
        <NewsBoard client:idle announcements={announcements} events={events} now={Date.now()} live />
      ) : (
        <NewsBoard announcements={announcements} events={events} now={Date.now()} />
      )
    }
  </div>

  {/* Le jeu des Gaulois (22 novembre 2026, demande du pilote : « le but de cette accueil est de donner envie au joueur de
      s'empresser de créer son gaulois ») : un booster d'essai à ouvrir tout de suite, puis ce qu'un Gaulois devient en jouant. */}
  <AccueilBooster gaulois={gauloisDuJeu} releve={gauloisLusLe()} nombres={nombres} />
  <AccueilParcours gaulois={gauloisDuJeu} />
  <script>
    import "../scripts/accueil-jeu";
  </script>

  {/* Entre deux parties, de l'air (jeton --spacing-section de 01-socle.css) ; la rangée « Ma place » et QG garde sa gouttière. */}
  <div class="wrap accueil-apres grid grid-cols-1 gap-section">
    {/* Le clan au classement officiel : le rang dit tout de suite où en est GAL. */}
    <section class="stage stage-blue reveal" id="classement-clan" aria-labelledby="stats-title">
      <h2 id="stats-title" class="section-title section-title-sm">Le clan au classement officiel</h2>
      {/* Les chiffres en grand, sans case : un filet à gauche de chacun. La rangée passe à la ligne quand la place manque. */}
      <div class="kpi-row mt-8">
        {
          cards.map((c) => (
            <div class="kpi" data-testid="stat-card">
              <p class="kpi-label">{c.label}</p>
              {c.value === null ? (
                <p class="mt-2 font-display text-lg font-bold">Pas de données</p>
              ) : (
                <p class="kpi-value" data-count={c.count} data-decimals={c.decimals ?? 0}>
                  {c.value}
                </p>
              )}
              <p class="kpi-hint">{c.hint}</p>
              {
                c.label === "Taux de victoire" && rate !== null && (
                  <div class="meter mt-3" aria-hidden="true">
                    <i style={{ "--v": `${rate}%` }}></i>
                  </div>
                )
              }
            </div>
          ))
        }
      </div>
      {
        leaderboard && !me && (
          <p class="mt-6 font-semibold text-warn">
            [{clan.tag}] ne figure pas dans la liste officielle au {fmtDateTime(leaderboard.end)} : le clan est hors classement.
          </p>
        )
      }
      {/* Les écarts avec les voisins ont leur page (en tête du classement, et leur histoire dans Nos rivaux) : l'accueil y renvoie sans les recopier. */}
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`${base}/classement`} class="btn btn-secondary">Voir le classement complet</a>
        {me && near && <a href={`${base}/rivaux`} class="btn btn-ghost" data-testid="home-rivals">Voir nos rivaux</a>}
      </div>
      <div class="mt-6">
        <DataStatus state={meta.leaderboard} maxAgeHours={MAX_AGE_HOURS.leaderboard} asOf={leaderboard?.end} asOfLabel="Classement arrêté au" />
      </div>
    </section>

    {/* Ce qui est à chacun : sa place dans le clan, et la porte de la face privée. */}
    <div class:list={["grid gap-x-6 gap-y-section", AUTH_ENABLED && "lg:grid-cols-2"]} id="rangee-moi" data-testid="home-me-row">
      {/*
        « C'est moi » : le membre qui a retenu son pseudo (src/lib/moi.ts) retrouve sa place, et la porte du QG, avant le classement.
        Premier enfant de la rangée, ce script la déplace avant que la page la remplisse : « Ma place » ne se réveille qu'une fois,
        à sa vraie place, et l'ordre de la page reste celui qu'on voit et qu'on parcourt au clavier. Sans stockage ni JavaScript, rien ne bouge.
      */}
      <script is:inline define:vars={{ meKey: ME_KEY }}>
        try {
          if (localStorage.getItem(meKey)) {
            const row = document.getElementById("rangee-moi");
            const ranking = document.getElementById("classement-clan");
            if (row && ranking) ranking.before(row);
          }
        } catch {
          // Stockage indisponible : l'ordre reste celui de tous.
        }
      </script>
      <section class="stage stage-night reveal scroll-mt-24" id="ma-place" aria-labelledby="place-title" data-testid="my-place">
        <h2 id="place-title" class="section-title section-title-sm">Ma place dans le clan</h2>
        <div class="mt-4">
          <MyPlace client:idle src={`${base}/data/members.json`} />
        </div>
        <noscript><p class="mt-3 text-sm text-muted">JavaScript est nécessaire pour chercher un pseudo.</p></noscript>
      </section>

      {/* La porte de la face privée : le contenu du QG n'est pas dans cette page, le serveur ne le donne qu'aux membres validés. */}
      {
        AUTH_ENABLED && (
          <section class="stage stage-night reveal flex flex-col items-start" aria-labelledby="qg-title" data-testid="home-qg">
            <h2 id="qg-title" class="section-title section-title-sm">Le QG des membres</h2>
            <p class="mt-3 max-w-xl text-muted">Salons, sondages, idées et mur des membres : réservé aux membres de GAL.</p>
            {/* Vide dans la page publiée : pour un membre validé connecté, ce qui l'attend au QG (src/scripts/visages.ts). */}
            <p class="tnum mt-3 font-semibold" data-qg-waiting data-testid="home-qg-waiting" hidden></p>
            <a href={`${base}/qg`} class="btn btn-secondary mt-6">Entrer dans le QG</a>
          </section>
        )
      }
    </div>
  </div>
</Base>
