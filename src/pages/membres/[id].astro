---
import Base from "../../layouts/Base.astro";
import DataStatus from "../../components/DataStatus.astro";
import FlammeSerie from "../../components/FlammeSerie.astro";
import MapNamesCredit from "../../components/MapNamesCredit.astro";
import { NiveauEmblem } from "../../components/NiveauEmblem";
import { AXES, TITRE_DE_L_AXE } from "../../lib/rejeu/bilan-ecran";
import { classementDuSite } from "../../lib/rejeu/utiles-site";
import CarteDeMembre from "../../components/CarteDeMembre.astro";
import PageHeader from "../../components/PageHeader.astro";
import ReadingNote from "../../components/ReadingNote.astro";
import { clan } from "../../../config/clan";
import { banniereParId } from "../../../supabase/functions/code-discord/bannieres/index";
import { BANNIERES_MEMBRES_FILE, bannieresDuCache } from "../../lib/bannieres-joueurs";
import { FINITIONS_MEMBRES_FILE, finitionsDuCache } from "../../lib/finitions-joueurs";
import { portraitDuGaulois } from "../../lib/gaulois-site";
import { loadCompagnonsDeFlamme, loadMemberGames, loadMemberResultsOnce, loadMembers, loadMeta, loadRecordsPersonnels, loadSeriesEnCours, loadSessionIndex } from "../../lib/data";
import { fmtCount, fmtDate, fmtDateTime, fmtInt, fmtPct } from "../../lib/format";
import { ficheFacts, ficheImageAlt } from "../../lib/fiche-image";
import { ficheImageVersion } from "../../lib/fiches-discord";
import { mapLabel } from "../../lib/map-names";
import { accountLabel } from "../../lib/niveau";
import { gamesOf, rateOf, recentGamesTitle, singlePseudos } from "../../lib/members";
import { nextTier, tierOf } from "../../lib/paliers";
import { formatLabel } from "../../lib/results";
import type { StoredMember } from "../../lib/schemas";
import { groupSentence, groupStats, winRateOf } from "../../lib/seul-groupe";
import { GROUP_LABELS, GROUP_SIZES } from "../../lib/simulateur";
import { datesDeLaSerie, datesDuRecord, flammeAllumee, phraseDesCompagnons, serieEnMots } from "../../lib/serie-en-cours";
import { parisParts } from "../../lib/time";

/** Une fiche par membre avec pseudo : un anonyme n'en a pas, et son identifiant n'est écrit nulle part. */
export function getStaticPaths() {
  return (loadMembers()?.members ?? []).flatMap((member) => (member.username && member.publicId ? [{ params: { id: member.publicId }, props: { member } }] : []));
}

interface Props {
  member: StoredMember;
}
const { member } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const username = member.username ?? "";
const games = gamesOf(member);
const rate = rateOf(member);
const recent = loadMemberGames()[member.publicId ?? ""] ?? null;
const recentTitle = recent && games ? recentGamesTitle(recent, games) : null;
const wins = member.team?.wins ?? 0;
const tier = tierOf(wins);
const next = nextTier(wins);
const joinedOn = parisParts(member.joinedAt).date;
const ROLE = { leader: "Chef du clan", officer: "Officier du clan", member: null } as const;
const RESULT = { victory: "Victoire", defeat: "Défaite" } as const;
const atDay = (date: string) => fmtDate(`${date}T12:00:00Z`);
// L'image d'aperçu du lien, dessinée au build (scripts/generate-fiches.ts) : sans elle, celle du site.
const list = loadMembers();
// Sa série en cours (`serie-en-cours.ts`) : la flamme ne s'allume qu'à 5 victoires d'affilée.
const serie = member.publicId ? (loadSeriesEnCours().get(member.publicId) ?? null) : null;
// Son record personnel (`serie-en-cours.ts`) : sa plus longue série, celle des podiums ; la flamme passe à l'or quand la
// série en cours bat une ancienne flamme.
const record = member.publicId ? (loadRecordsPersonnels().get(member.publicId) ?? null) : null;
const facts = list ? ficheFacts(list.members, member, serie, record) : null;
// Les compagnons de flamme (conception de Claude Fable 5.2) : cinq noms au plus, en liens vers leur fiche ; le reste, et les
// Gaulois sans pseudo public, dans « et d'autres Gaulois ». Aucun nombre. La phrase est préparée en morceaux (`phraseDesCompagnons`).
const compagnons = phraseDesCompagnons(member.publicId && flammeAllumee(serie) ? (loadCompagnonsDeFlamme().get(member.publicId) ?? null) : null);
// Toujours ses dates, les mêmes qu'au podium de Records : une série de septembre ne se lit pas comme d'aujourd'hui.
const recordLigne = record
  ? `${datesDuRecord(record).replace(/^./, (c) => c.toUpperCase())}${record.courante ? ", sans défaite sous le tag depuis" : ""}, sur ses parties lues depuis le ${fmtDate(record.luesDepuis)}`
  : null;
// « 7 victoires d'affilée », ou « Au moins 7 victoires d'affilée » en tête de ligne.
const serieLigne = flammeAllumee(serie) ? serieEnMots(serie).replace(/^a/, "A") : null;
// Son adresse porte la version de son dessin : quand l'image change, Discord ne montre pas celle qu'il a gardée.
const imageVersion = facts !== null && member.publicId !== null ? ficheImageVersion(member.publicId) : null;
const hasImage = imageVersion !== null;
const image = hasImage ? `${base}/generated/fiches/${member.publicId}.png?v=${imageVersion}` : undefined;
// Une photo Discord ne va qu'à côté d'un pseudo porté par un seul membre : jamais à côté d'un homonyme (src/scripts/visages.ts).
const face = list && singlePseudos(list.members).has(username) ? username : undefined;
const imageAlt = hasImage && facts && list ? ficheImageAlt(facts, clan.tag, list.fetchedAt) : undefined;
// Seul ou en groupe : ses parties de sa liste officielle, rangées selon le nombre de Gaulois de la session du clan (src/lib/seul-groupe.ts).
const groupe = member.publicId ? groupStats(loadMemberResultsOnce()[member.publicId], loadSessionIndex()) : null;
const groupLine = groupe ? groupSentence(groupe, username, fmtPct) : null;
// La bannière que son Gaulois montre, relevée avant la construction comme pour la liste (src/lib/bannieres-joueurs.ts) : le
// serveur décide de qui en montre une. Sans relevé, la fiche reste comme avant. Elle est le fond des scènes de la fiche, à
// la place de leur bleu (demande du pilote, 17 novembre 2026) : « .stage-banniere » de 01-socle.css.
const banniere = banniereParId(member.publicId ? bannieresDuCache(BANNIERES_MEMBRES_FILE, [member.publicId]).get(member.publicId)?.id : null);
// La rareté dite en toutes lettres à qui ne voit pas le cadre, comme sur la liste (MembersTable.tsx).
const RARETE_DITE = { commun: "commune", "peu-commun": "peu commune", epique: "épique", mystique: "mystique", legendaire: "légendaire" } as const;
const fond = banniere
  ? { classe: " stage-banniere", style: `--banniere: url("${base}/bannieres/${encodeURIComponent(banniere.id)}.png")`, id: banniere.id, rarete: banniere.rarete }
  : { classe: "", style: undefined, id: undefined, rarete: undefined };
// Sa carte (demande du pilote, 17 novembre 2026 : mettre en valeur les effets des cartes) : son Gaulois devant sa bannière
// et la finition qu'il montre, relevés avant la construction (src/lib/finitions-joueurs.ts). Sans Gaulois créé : pas de carte.
const portraitDeCarte = portraitDuGaulois(member.publicId);
const finitionDeCarte = member.publicId ? (finitionsDuCache(FINITIONS_MEMBRES_FILE, [member.publicId]).get(member.publicId) ?? null) : null;
// Son utilité dans les parties à revoir (demande du pilote, 17 novembre 2026 : « l'utilité sur la fiche du membre, sa moyenne
// et ses titres ») : sa ligne du classement « Les plus utiles » (src/lib/rejeu/utiles-site.ts), s'il y est. Le pseudo doit
// désigner ce membre et lui seul : le classement est rangé par pseudo. Sans ligne : rien, ce n'est pas zéro.
const utiles = classementDuSite();
const utilite = member.publicId && utiles.ids.get(username) === member.publicId ? (utiles.lignes.find((l) => l.nom === username) ?? null) : null;
const utiliteTitres = utilite ? AXES.filter((a) => utilite.titres[a] > 0).map((a) => `${TITRE_DE_L_AXE[a]} ${fmtInt(utilite.titres[a])} fois`) : [];
const tiles = member.team
  ? [
      { label: "Victoires", value: fmtInt(member.team.wins) },
      { label: "Défaites", value: fmtInt(member.team.losses) },
      { label: "Parties", value: fmtInt(games) },
      { label: "Taux de victoire", value: fmtPct(rate) },
    ]
  : [];
---

<Base title={username} description={`Fiche de ${username}, membre du clan ${clan.tag} : ses parties d'équipe sous le tag.`} noindex image={image} imageAlt={imageAlt}>
  <div class="wrap">
    <PageHeader title={username} lettrine={false} intro={`Membre de [${clan.tag}] depuis le ${fmtDate(member.joinedAt)}.`}>
      {/* Sa carte, décorative : à droite de ses informations, comme sur le podium de l'accueil. */}
      {portraitDeCarte && (
        <CarteDeMembre
          portrait={portraitDeCarte}
          banniere={banniere ? `/bannieres/${encodeURIComponent(banniere.id)}.png` : null}
          finition={finitionDeCarte}
          nom={username}
          mot={member.team ? fmtCount(member.team.wins, "victoire") : null}
        />
      )}
      {/* Vide pour un visiteur : sa photo Discord, s'il a choisi de se montrer, pour un membre validé connecté (src/scripts/visages.ts). */}
      <span class="face-slot face-slot-lg mt-4" aria-hidden="true" data-face={face} hidden></span>
      {ROLE[member.role] && <p class="mt-2 font-semibold" data-testid="member-role">{ROLE[member.role]}</p>}
      {/* Le fond des scènes ne se lit pas : son nom et sa rareté sont dits une fois, à qui ne voit pas l'image. */}
      {banniere && <p class="sr-only" data-testid="member-banner">Les blocs de sa fiche ont pour fond la bannière de son Gaulois, « {banniere.nom} », {RARETE_DITE[banniere.rarete]}.</p>}
      {/* La flamme de série (src/lib/serie-en-cours.ts) : à partir de 5 victoires d'affilée sous le tag, au dernier relevé. Elle
          vient avant le niveau, qui est tout le jeu ; deux blocs à part. Sous 5, ou sans données : rien. */}
      {
        serie && serieLigne && (
          <div class="mt-4 flex items-center gap-4" data-testid="member-streak" data-record={record?.doree ? "" : undefined}>
            <span class="flex w-24 shrink-0 justify-center">
              <FlammeSerie doree={record?.doree ?? false} />
            </span>
            <p class="min-w-0">
              <span class="block font-display text-2xl font-bold">
                {serieLigne}
                {record?.doree && ", son record"}
              </span>
              <span class="block text-sm text-muted">Victoires {datesDeLaSerie(serie)}, sans défaite sous le tag depuis, au dernier relevé du {fmtDateTime(serie.releve)}</span>
              {
                compagnons && (
                  <span class="mt-1 block text-sm leading-relaxed text-muted [overflow-wrap:anywhere]" data-testid="member-streak-mates">
                    {compagnons.intro}
                    {compagnons.noms.map((c) => (
                      <Fragment>
                        {c.avant}
                        <a class="pseudo pseudo-phrase" href={`${base}/membres/${encodeURIComponent(c.id)}`}>{c.username}</a>
                      </Fragment>
                    ))}
                    {compagnons.fin}
                  </span>
                )
              }
            </p>
          </div>
        )
      }
      {
        member.account && (
          <div class="mt-4 flex items-center gap-4" data-testid="member-level">
            <NiveauEmblem account={member.account} size="lg" />
            <p>
              <span class="block font-display text-2xl font-bold">{accountLabel(member.account)}</span>
              <span class="block text-sm text-muted">Son compte OpenFront, tout le jeu confondu</span>
            </p>
          </div>
        )
      }
      {/* Son utilité dans les parties à revoir : à part des stats du clan, avec le lien vers le classement qui l'explique. */}
      {
        utilite && (
          <div class="mt-4 flex items-center gap-4" data-testid="member-utilite">
            <span class="flex w-24 shrink-0 justify-center font-display text-4xl font-bold tnum">{fmtInt(utilite.utilite)}</span>
            <p class="min-w-0">
              <span class="block font-display text-2xl font-bold">d'utilité, rang {fmtInt(utiles.rangs.get(username)!)} des plus utiles</span>
              <span class="block text-sm text-muted">
                Moyenne sur ses {fmtInt(utilite.parties)} parties à revoir, 100 étant la part moyenne d'un Gaulois{utiliteTitres.length > 0 && ` ; ${utiliteTitres.join(", ")}`}{utiles.fait && `, à jour du ${fmtDateTime(utiles.fait)}`}.{" "}
                <a class="link" href={`${base}/utiles`}>Les plus utiles</a>
              </span>
            </p>
          </div>
        )
      }
      {/* Une seule date pour la fiche. Ses dernières parties ont leur propre relevé : une panne s'y signale ici, avec son nom. */}
      <div class="mt-4">
        <DataStatus sources={games !== null && games > 0 && meta.memberGames.lastError ? ["members", "memberGames"] : ["members"]} />
      </div>
    </PageHeader>

    <section class={`stage stage-blue reveal${fond.classe}`} style={fond.style} data-banniere={fond.id} data-rarete={fond.rarete} aria-labelledby="member-stats-title" data-testid="member-stats">
      <h2 id="member-stats-title" class="section-title">Ses parties sous le tag</h2>
      {
        !member.team ? (
          <p class="mt-6 font-display text-lg font-bold">Pas de données</p>
        ) : games === 0 ? (
          <p class="mt-6 font-display text-lg font-bold" data-testid="member-no-game">Aucune partie sous le tag</p>
        ) : (
          <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-6 md:grid-cols-4">
            {tiles.map((t) => (
              <div data-testid="member-stat">
                <dt class="text-sm font-semibold text-muted">{t.label}</dt>
                <dd class="tnum mt-1 font-display text-3xl font-extrabold">{t.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        games !== null && games > 0 && (
          <div class="mt-6 max-w-xl" data-testid="member-tier">
            <p class="font-display text-xl font-bold">{tier === null ? "Pas encore de palier" : `Palier atteint : ${fmtCount(tier, "victoire")}`}</p>
            {next ? (
              <>
                <p class="tnum mt-1 text-sm text-muted">Prochain palier : {fmtCount(next.wins, "victoire")}, encore {fmtInt(next.missing)}.</p>
                <div class="meter mt-2" aria-hidden="true"><i style={{ "--v": `${((wins - next.from) / (next.wins - next.from)) * 100}%` }}></i></div>
              </>
            ) : (
              <p class="mt-1 text-sm text-muted">C'est le dernier palier du site.</p>
            )}
          </div>
        )
      }
      {/* Le record personnel : sa plus longue série sous le tag, la même qu'aux podiums de Records. Chacun se mesure à lui-même. */}
      {
        record && recordLigne && games !== null && games > 0 && (
          <div class="mt-6 max-w-xl" data-testid="member-best-streak">
            <p class="tnum font-display text-xl font-bold">Meilleure série : {serieEnMots(record)}</p>
            <p class="mt-1 text-sm text-muted">{recordLigne}</p>
          </div>
        )
      }
    </section>

    {
      groupe && (
        <section class={`stage stage-indigo reveal mt-section${fond.classe}`} style={fond.style} data-banniere={fond.id} data-rarete={fond.rarete} aria-labelledby="member-group-title" data-testid="member-group">
          <h2 id="member-group-title" class="section-title">Seul ou en groupe</h2>
          {groupLine && (
            <p class="mt-4 max-w-3xl text-lg" data-testid="member-group-line">
              {groupLine}
            </p>
          )}
          <div class="mt-6 overflow-x-auto" tabindex="0" role="region" aria-label="Seul ou en groupe : victoires selon le nombre de Gaulois">
            <table class="tnum w-full max-w-2xl text-left [overflow-wrap:normal]">
              <thead>
                <tr class="text-sm text-muted">
                  <th scope="col" class="py-2 pr-4 font-semibold">Gaulois dans la partie</th>
                  <th scope="col" class="py-2 pr-4 font-semibold">Parties</th>
                  <th scope="col" class="py-2 pr-4 font-semibold">Victoires</th>
                  <th scope="col" class="py-2 font-semibold">Taux</th>
                </tr>
              </thead>
              <tbody>
                {GROUP_SIZES.map((size) => (
                  <tr class="whitespace-nowrap border-t border-line" data-testid="member-group-row">
                    <th scope="row" class="py-2 pr-4 text-left font-semibold">{GROUP_LABELS[size]}</th>
                    <td class="py-2 pr-4">{fmtInt(groupe.bySize[size].games)}</td>
                    <td class="py-2 pr-4">{fmtInt(groupe.bySize[size].wins)}</td>
                    <td class="py-2">{fmtPct(winRateOf(groupe.bySize[size]))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {groupe.byFormat.length > 0 && (
            <details class="fold mt-4 max-w-2xl" data-testid="member-group-formats">
              <summary>Par format</summary>
              <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Victoires par format">
                <table class="tnum mt-2 w-full text-left [overflow-wrap:normal]">
                  <thead>
                    <tr class="text-sm text-muted">
                      <th scope="col" class="py-2 pr-4 font-semibold">Format</th>
                      <th scope="col" class="py-2 pr-4 font-semibold">Parties</th>
                      <th scope="col" class="py-2 pr-4 font-semibold">Victoires</th>
                      <th scope="col" class="py-2 font-semibold">Taux</th>
                    </tr>
                  </thead>
                  <tbody>
                    {groupe.byFormat.map((row) => (
                      <tr class="whitespace-nowrap border-t border-line">
                        <th scope="row" class="py-2 pr-4 text-left font-semibold">{row.format}</th>
                        <td class="py-2 pr-4">{fmtInt(row.games)}</td>
                        <td class="py-2 pr-4">{fmtInt(row.wins)}</td>
                        <td class="py-2">{fmtPct(winRateOf(row))}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}
        </section>
      )
    }

    {
      games !== null && games > 0 && (
        <section class={`stage stage-night reveal mt-section${fond.classe}`} style={fond.style} data-banniere={fond.id} data-rarete={fond.rarete} aria-labelledby="member-recent-title" data-testid="member-recent">
          <h2 id="member-recent-title" class="section-title">Ses dernières parties</h2>
          {recent && recentTitle ? (
            <>
              <p class="mt-4 text-lg text-muted" data-testid="member-recent-title">{recentTitle}</p>
                <div class="panel mt-4 !p-0">
                  <table class="data-table tnum w-full text-sm">
                    <caption class="sr-only">Ses dernières parties sous le tag, de la plus récente à la plus ancienne</caption>
                    <thead>
                      <tr>
                        <th scope="col">Jour</th>
                        <th scope="col">Carte</th>
                        <th scope="col" class="hidden sm:table-cell">Format</th>
                        <th scope="col" class="whitespace-nowrap">Résultat</th>
                      </tr>
                    </thead>
                    <tbody>
                      {recent.recent.map((game) => (
                        <tr data-testid="member-game">
                          <td>{atDay(game.date)}</td>
                          <td>
                            {mapLabel(game.map)}
                            <span class="block text-xs text-muted sm:hidden">{game.teams === null ? "—" : formatLabel(game.teams)}</span>
                          </td>
                          <td class="hidden sm:table-cell">{game.teams === null ? "—" : formatLabel(game.teams)}</td>
                          <td class="whitespace-nowrap font-semibold">{RESULT[game.result]}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              <p class="info-discrete mt-4 max-w-3xl">Relevé le {atDay(recent.readOn)}{recent.seen !== games && " : ses parties les plus récentes n'y sont pas encore"}.</p>
              <MapNamesCredit />
            </>
          ) : (
            <>
              <p class="mt-4 font-display text-lg font-bold">Pas de données</p>
              <p class="mt-1 text-sm text-muted">Ses dernières parties ne sont pas disponibles.</p>
            </>
          )}
        </section>
      )
    }

    {/* Les précisions des trois blocs, chacune sous le nom de son bloc, en un seul repli en bas de la fiche. */}
    <ReadingNote page>
      <ReadingNote bloc="Ses parties sous le tag">
        <p>
          Parties publiques en équipe jouées avec le tag {clan.tag}, sans le classé, le FFA ni Humains contre Nations.{games === 0 && " Cela ne veut pas dire que ce joueur est inactif."}{games !== null && games > 0 && <> <a href={`${base}/membres`}>Les paliers</a> sont choisis par le site. Ils comptent des victoires, donc d'abord des parties jouées : ils ne disent pas qui joue le mieux.</>}
        </p>
      </ReadingNote>
      {
        groupe && (
          <ReadingNote bloc="Seul ou en groupe">
            <p>
              Parties sous le tag du {fmtDate(groupe.from)} au {fmtDate(groupe.to)}, retrouvées dans les sessions du clan : {fmtInt(groupe.matched)}
              {groupe.complete ? "." : " ; les plus anciennes ne sont pas encore relues."} Le nombre de Gaulois compte tous les joueurs sous le tag dans la partie, avec ou sans pseudo. Un lien, pas une preuve : le taux dépend aussi du format, de l'heure et des adversaires.
            </p>
          </ReadingNote>
        )
      }
      {
        games !== null && games > 0 && recent && recentTitle && (
          <ReadingNote bloc="Ses dernières parties">
            <p>
              Le résultat est celui qu'OpenFront compte pour ce joueur : s'il quitte la partie avant la fin, une victoire de son équipe peut compter comme une défaite pour lui. La fiche n'affiche que le jour, mais la page <a href={`${base}/parties`}>Dernières parties</a> permet souvent de retrouver cette partie, avec son heure et son lien vers OpenFront.{recent.recent.some((game) => game.date < joinedOn) && " Certaines parties sont antérieures à son arrivée dans la liste officielle."}
            </p>
          </ReadingNote>
        )
      }
    </ReadingNote>

    <div class="reveal mt-section flex flex-col gap-3 sm:flex-row">
      <button type="button" class="btn btn-secondary" data-copy-link data-testid="copy-link" hidden>Copier le lien de cette fiche</button>
      <a href={`${base}/liste`} class="btn btn-ghost">Retour à la liste</a>
      <a href={`https://openfront.io/#modal=profile&publicID=${encodeURIComponent(member.publicId ?? "")}`} class="btn btn-ghost" rel="noopener">Son profil sur OpenFront</a>
    </div>
    <p class="mt-3 text-sm text-muted" role="status" data-copy-status data-testid="copy-status"></p>
  </div>
</Base>

<script>
  // Copier le lien de la fiche pour le coller sur Discord : l'aperçu y montre l'image de la fiche. Sans presse-papiers, le bouton reste caché.
  const button = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  if (button && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      const link = location.href.split("#")[0] ?? location.href;
      try {
        await navigator.clipboard.writeText(link);
        status.textContent = "Lien copié.";
      } catch {
        status.textContent = `Le lien de cette fiche : ${link}`;
      }
    });
  }
</script>
