---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Base from "../../layouts/Base.astro";
import DataStatus from "../../components/DataStatus.astro";
import MapNamesCredit from "../../components/MapNamesCredit.astro";
import PageHeader from "../../components/PageHeader.astro";
import ReadingNote from "../../components/ReadingNote.astro";
import { clan } from "../../../config/clan";
import { loadMemberGames, loadMemberResultsOnce, loadMembers, loadMeta, loadSessionIndex } from "../../lib/data";
import { fmtCount, fmtDate, fmtInt, fmtPct } from "../../lib/format";
import { ficheFacts, ficheImageAlt } from "../../lib/fiche-image";
import { MAX_AGE_HOURS } from "../../lib/freshness";
import { mapLabel } from "../../lib/map-names";
import { gamesOf, rateOf, recentGamesTitle, singlePseudos } from "../../lib/members";
import { nextTier, tierOf } from "../../lib/paliers";
import { formatLabel } from "../../lib/results";
import type { StoredMember } from "../../lib/schemas";
import { groupSentence, groupStats, winRateOf } from "../../lib/seul-groupe";
import { GROUP_LABELS, GROUP_SIZES } from "../../lib/simulateur";
import { parisParts } from "../../lib/time";

/** Une fiche par membre avec pseudo : un anonyme n'en a pas, et son identifiant n'est écrit nulle part. */
export function getStaticPaths() {
  return (loadMembers()?.members ?? []).flatMap((member) => (member.username && member.publicId ? [{ params: { id: member.publicId }, props: { member } }] : []));
}

interface Props {
  member: StoredMember;
}
const { member } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const username = member.username ?? "";
const games = gamesOf(member);
const rate = rateOf(member);
const recent = loadMemberGames()[member.publicId ?? ""] ?? null;
const recentTitle = recent && games ? recentGamesTitle(recent, games) : null;
const wins = member.team?.wins ?? 0;
const tier = tierOf(wins);
const next = nextTier(wins);
const joinedOn = parisParts(member.joinedAt).date;
const ROLE = { leader: "Chef du clan", officer: "Officier du clan", member: null } as const;
const RESULT = { victory: "Victoire", defeat: "Défaite" } as const;
const atDay = (date: string) => fmtDate(`${date}T12:00:00Z`);
// L'image d'aperçu du lien, dessinée au build (scripts/generate-fiches.ts) : sans elle, celle du site.
const list = loadMembers();
const facts = list ? ficheFacts(list.members, member) : null;
const hasImage = facts !== null && member.publicId !== null && existsSync(join("public", "generated", "fiches", `${member.publicId}.png`));
const image = hasImage ? `${base}/generated/fiches/${member.publicId}.png` : undefined;
// Une photo Discord ne va qu'à côté d'un pseudo porté par un seul membre : jamais à côté d'un homonyme (src/scripts/visages.ts).
const face = list && singlePseudos(list.members).has(username) ? username : undefined;
const imageAlt = hasImage && facts && list ? ficheImageAlt(facts, clan.tag, list.fetchedAt) : undefined;
// Seul ou en groupe : ses parties de sa liste officielle, rangées selon le nombre de Gaulois de la session du clan (src/lib/seul-groupe.ts).
const groupe = member.publicId ? groupStats(loadMemberResultsOnce()[member.publicId], loadSessionIndex()) : null;
const groupLine = groupe ? groupSentence(groupe, username, fmtPct) : null;
const tiles = member.team
  ? [
      { label: "Victoires", value: fmtInt(member.team.wins) },
      { label: "Défaites", value: fmtInt(member.team.losses) },
      { label: "Parties", value: fmtInt(games) },
      { label: "Taux de victoire", value: fmtPct(rate) },
    ]
  : [];
---

<Base title={username} description={`Fiche de ${username}, membre du clan ${clan.tag} : ses parties d'équipe sous le tag.`} noindex image={image} imageAlt={imageAlt}>
  <div class="wrap">
    <PageHeader title={username} lettrine={false} intro={`Membre de [${clan.tag}] depuis le ${fmtDate(member.joinedAt)}.`}>
      {/* Vide pour un visiteur : sa photo Discord, s'il a choisi de se montrer, pour un membre validé connecté (src/scripts/visages.ts). */}
      <span class="face-slot face-slot-lg mt-4" aria-hidden="true" data-face={face} hidden></span>
      {ROLE[member.role] && <p class="mt-2 font-semibold" data-testid="member-role">{ROLE[member.role]}</p>}
      <div class="mt-4">
        <DataStatus state={meta.members} maxAgeHours={MAX_AGE_HOURS.members} />
      </div>
    </PageHeader>

    <section class="stage stage-blue reveal" aria-labelledby="member-stats-title" data-testid="member-stats">
      <h2 id="member-stats-title" class="section-title">Ses parties sous le tag</h2>
      {
        !member.team ? (
          <p class="mt-6 font-display text-lg font-bold">Pas de données</p>
        ) : games === 0 ? (
          <p class="mt-6 font-display text-lg font-bold" data-testid="member-no-game">Aucune partie sous le tag</p>
        ) : (
          <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-6 md:grid-cols-4">
            {tiles.map((t) => (
              <div data-testid="member-stat">
                <dt class="text-sm font-semibold text-muted">{t.label}</dt>
                <dd class="tnum mt-1 font-display text-3xl font-extrabold">{t.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        games !== null && games > 0 && (
          <div class="mt-6 max-w-xl" data-testid="member-tier">
            <p class="font-display text-xl font-bold">{tier === null ? "Pas encore de palier" : `Palier atteint : ${fmtCount(tier, "victoire")}`}</p>
            {next ? (
              <>
                <p class="tnum mt-1 text-sm text-muted">Prochain palier : {fmtCount(next.wins, "victoire")}, encore {fmtInt(next.missing)}.</p>
                <div class="meter mt-2" aria-hidden="true"><i style={{ "--v": `${((wins - next.from) / (next.wins - next.from)) * 100}%` }}></i></div>
              </>
            ) : (
              <p class="mt-1 text-sm text-muted">C'est le dernier palier du site.</p>
            )}
          </div>
        )
      }
      <ReadingNote>
        <p>
          Parties publiques en équipe jouées avec le tag {clan.tag}, sans le classé, le FFA ni Humains contre Nations.{games === 0 && " Cela ne veut pas dire que ce joueur est inactif."}{games !== null && games > 0 && <> <a href={`${base}/membres`}>Les paliers</a> sont choisis par le site. Ils comptent des victoires, donc d'abord des parties jouées : ils ne disent pas qui joue le mieux.</>}
        </p>
      </ReadingNote>
    </section>

    {
      groupe && (
        <section class="stage stage-indigo reveal mt-6" aria-labelledby="member-group-title" data-testid="member-group">
          <h2 id="member-group-title" class="section-title">Seul ou en groupe</h2>
          {groupLine && (
            <p class="mt-4 max-w-3xl text-lg font-semibold" data-testid="member-group-line">
              {groupLine}
            </p>
          )}
          <div class="mt-6 overflow-x-auto" tabindex="0" role="region" aria-label="Seul ou en groupe : victoires selon le nombre de Gaulois">
            <table class="tnum w-full max-w-2xl text-left [overflow-wrap:normal]">
              <thead>
                <tr class="text-sm text-muted">
                  <th scope="col" class="py-2 pr-4 font-semibold">Gaulois dans la partie</th>
                  <th scope="col" class="py-2 pr-4 font-semibold">Parties</th>
                  <th scope="col" class="py-2 pr-4 font-semibold">Victoires</th>
                  <th scope="col" class="py-2 font-semibold">Taux</th>
                </tr>
              </thead>
              <tbody>
                {GROUP_SIZES.map((size) => (
                  <tr class="whitespace-nowrap border-t border-line" data-testid="member-group-row">
                    <th scope="row" class="py-2 pr-4 text-left font-semibold">{GROUP_LABELS[size]}</th>
                    <td class="py-2 pr-4">{fmtInt(groupe.bySize[size].games)}</td>
                    <td class="py-2 pr-4">{fmtInt(groupe.bySize[size].wins)}</td>
                    <td class="py-2">{fmtPct(winRateOf(groupe.bySize[size]))}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {groupe.byFormat.length > 0 && (
            <details class="fold mt-4 max-w-2xl" data-testid="member-group-formats">
              <summary class="font-semibold">Par format</summary>
              <div class="overflow-x-auto" tabindex="0" role="region" aria-label="Victoires par format">
                <table class="tnum mt-2 w-full text-left [overflow-wrap:normal]">
                  <thead>
                    <tr class="text-sm text-muted">
                      <th scope="col" class="py-2 pr-4 font-semibold">Format</th>
                      <th scope="col" class="py-2 pr-4 font-semibold">Parties</th>
                      <th scope="col" class="py-2 pr-4 font-semibold">Victoires</th>
                      <th scope="col" class="py-2 font-semibold">Taux</th>
                    </tr>
                  </thead>
                  <tbody>
                    {groupe.byFormat.map((row) => (
                      <tr class="whitespace-nowrap border-t border-line">
                        <th scope="row" class="py-2 pr-4 text-left font-semibold">{row.format}</th>
                        <td class="py-2 pr-4">{fmtInt(row.games)}</td>
                        <td class="py-2 pr-4">{fmtInt(row.wins)}</td>
                        <td class="py-2">{fmtPct(winRateOf(row))}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          )}
          <ReadingNote>
            <p>
              Parties sous le tag du {fmtDate(groupe.from)} au {fmtDate(groupe.to)}, retrouvées dans les sessions du clan : {fmtInt(groupe.matched)}
              {groupe.complete ? "." : " ; les plus anciennes ne sont pas encore relues."} Le nombre de Gaulois compte tous les joueurs sous le tag dans la partie, avec ou sans pseudo. Un lien, pas une preuve : le taux dépend aussi du format, de l'heure et des adversaires.
            </p>
          </ReadingNote>
        </section>
      )
    }

    {
      games !== null && games > 0 && (
        <section class="stage stage-night reveal mt-6" aria-labelledby="member-recent-title" data-testid="member-recent">
          <h2 id="member-recent-title" class="section-title">Ses dernières parties</h2>
          {recent && recentTitle ? (
            <>
              <p class="mt-4 text-lg text-muted" data-testid="member-recent-title">{recentTitle}</p>
                <div class="panel mt-4 !p-0">
                  <table class="data-table tnum w-full text-sm">
                    <caption class="sr-only">Ses dernières parties sous le tag, de la plus récente à la plus ancienne</caption>
                    <thead>
                      <tr>
                        <th scope="col">Jour</th>
                        <th scope="col">Carte</th>
                        <th scope="col" class="hidden sm:table-cell">Format</th>
                        <th scope="col" class="whitespace-nowrap">Résultat</th>
                      </tr>
                    </thead>
                    <tbody>
                      {recent.recent.map((game) => (
                        <tr data-testid="member-game">
                          <td>{atDay(game.date)}</td>
                          <td>
                            {mapLabel(game.map)}
                            <span class="block text-xs text-muted sm:hidden">{game.teams === null ? "—" : formatLabel(game.teams)}</span>
                          </td>
                          <td class="hidden sm:table-cell">{game.teams === null ? "—" : formatLabel(game.teams)}</td>
                          <td class="whitespace-nowrap font-semibold">{RESULT[game.result]}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              <p class="mt-4 max-w-3xl text-sm text-muted">Relevé le {atDay(recent.readOn)}{recent.seen !== games && " : ses parties les plus récentes n'y sont pas encore"}.</p>
              <ReadingNote>
                <p>
                  Le résultat est celui qu'OpenFront compte pour ce joueur : s'il quitte la partie avant la fin, une victoire de son équipe peut compter comme une défaite pour lui. La fiche n'affiche que le jour, mais la page <a href={`${base}/parties`}>Dernières parties</a> permet souvent de retrouver cette partie, avec son heure et son lien vers OpenFront.{recent.recent.some((game) => game.date < joinedOn) && " Certaines parties sont antérieures à son arrivée dans la liste officielle."}
                </p>
              </ReadingNote>
              <MapNamesCredit />
            </>
          ) : (
            <>
              <p class="mt-4 font-display text-lg font-bold">Pas de données</p>
              <p class="mt-1 text-sm text-muted">Ses dernières parties ne sont pas disponibles.</p>
            </>
          )}
          {
            meta.memberGames.lastError && (
              <div class="mt-4">
                <DataStatus state={meta.memberGames} maxAgeHours={MAX_AGE_HOURS.memberGames} />
              </div>
            )
          }
        </section>
      )
    }

    <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row">
      <button type="button" class="btn btn-secondary" data-copy-link data-testid="copy-link" hidden>Copier le lien de cette fiche</button>
      <a href={`${base}/liste`} class="btn btn-ghost">Retour à la liste</a>
      <a href={`https://openfront.io/#modal=profile&publicID=${encodeURIComponent(member.publicId ?? "")}`} class="btn btn-ghost" rel="noopener">Son profil sur OpenFront</a>
    </div>
    <p class="mt-3 text-sm text-muted" role="status" data-copy-status data-testid="copy-status"></p>
  </div>
</Base>

<script>
  // Copier le lien de la fiche pour le coller sur Discord : l'aperçu y montre l'image de la fiche. Sans presse-papiers, le bouton reste caché.
  const button = document.querySelector<HTMLButtonElement>("[data-copy-link]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  if (button && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      const link = location.href.split("#")[0] ?? location.href;
      try {
        await navigator.clipboard.writeText(link);
        status.textContent = "Lien copié.";
      } catch {
        status.textContent = `Le lien de cette fiche : ${link}`;
      }
    });
  }
</script>
