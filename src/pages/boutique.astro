---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";

// « La boutique » a eu sa page le 15 novembre 2026, puis, le même jour, le pilote l'a mise dans « Mon Gaulois » (/village),
// en onglet à côté de la forge (« déplace la boutique »). L'adresse reste, pour les liens déjà donnés (Discord, favoris) :
// elle ouvre l'onglet ; /boutique#marche descend au marché des membres, /boutique#familiers à la pochette des familiers.
const cible = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/village`;
---

<Base title="La boutique" description="La boutique du clan GAL est maintenant dans « Mon Gaulois »." noindex>
  <div class="wrap">
    <PageHeader title="La boutique" compact />
    <p class="card max-w-3xl p-6 text-lg" data-testid="boutique-deplacee">
      La boutique est maintenant dans « Mon Gaulois ». <a href={`${cible}#boutique`}>Ouvrir la boutique</a>
    </p>
  </div>
  <script is:inline define:vars={{ cible }}>
    location.replace(`${cible}${location.hash === "#marche" || location.hash === "#familiers" ? location.hash : "#boutique"}`);
  </script>
</Base>
