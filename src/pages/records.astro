---
import Base from "../layouts/Base.astro";
import ClanResults from "../components/ClanResults.astro";
import DataStatus from "../components/DataStatus.astro";
import PageHeader from "../components/PageHeader.astro";
import PlayerPodiums from "../components/PlayerPodiums.astro";
import PlayerRecords from "../components/PlayerRecords.astro";
import { loadMeta } from "../lib/data";
import { MAX_AGE_HOURS } from "../lib/freshness";

const meta = loadMeta();
---

<Base title="Records" description="Les podiums et les records des joueurs du clan GAL, et les records du clan.">
  <div class="wrap">
    <PageHeader title="Records">
      <div class="mt-4">
        <DataStatus state={meta.sessions} maxAgeHours={MAX_AGE_HOURS.sessions} />
      </div>
    </PageHeader>
    {/* Les podiums écrivent eux-mêmes « Pas de données » : la page n'est jamais vide. */}
    <PlayerPodiums />
    <PlayerRecords />
    <ClanResults />
  </div>
</Base>
