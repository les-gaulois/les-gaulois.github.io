---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import Empty from "../components/Empty.astro";
import GazetteEditionBlock from "../components/GazetteEdition.astro";
import GazetteOlder from "../components/GazetteOlder.astro";
import PageHeader from "../components/PageHeader.astro";
import { clan } from "../../config/clan";
import { loadHistory, loadMembers, loadMemberWeeks, loadMeta, loadSessions, loadTerritoryReadings } from "../lib/data";
import { fmtDay, fmtInt } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { GAZETTE_RECENT_EDITIONS, gazetteEditions, weekLabel } from "../lib/gazette";
import { clanRecords } from "../lib/results";
import { currentWeek, currentWeekComparison, currentWeekLead } from "../lib/semaine";
import { addDays } from "../lib/time";
import { endSentence } from "../lib/vie-du-clan";

const meta = loadMeta();
const sessions = loadSessions();
const history = loadHistory();
const territory = loadTerritoryReadings();
const members = loadMembers();
const editions = gazetteEditions({ sessions, history, territory, weekTops: loadMemberWeeks().tops, members, archiveStart: clan.archiveStart, completeThrough: meta.sessions.completeThrough });
const [latest, ...older] = editions;
// Les dernières éditions d'abord ; les plus anciennes restent dans la page, repliées ensemble : la liste reste courte.
const recentOlder = older.slice(0, GAZETTE_RECENT_EDITIONS);
const ancient = older.slice(GAZETTE_RECENT_EDITIONS);
const oldest = ancient.at(-1);
// La semaine qui n'est pas finie : arrêtée à la dernière collecte, et comparée à la semaine d'avant au même moment.
const week = currentWeek(sessions, meta.sessions.coveredUntil, clan.archiveStart);
const weekComparison = week ? currentWeekComparison(week) : null;
// Les records de tout l'historique : un temps fort d'une semaine qui les égale, même moment compris, est un record du clan.
const records = clanRecords(sessions);
const context = { firstStanding: history[0]?.date ?? null, firstTerritory: territory[0]?.date ?? null, membersAt: members?.fetchedAt ?? null };
// La date affichée est celle des sessions. Une panne des autres sources doit se voir aussi.
const failures = [
  { label: "du classement", state: meta.leaderboard },
  { label: "de la carte des clans", state: meta.clanmap },
  { label: "de la liste des membres", state: meta.members },
].filter((source) => source.state.lastError);
---

<Base title="Gazette" description="Le bilan de chaque semaine du clan GAL : parties, victoires, classement, territoire et arrivées.">
  <div class="wrap">
    <PageHeader title="La gazette du clan">
      <div class="mt-4">
        <DataStatus state={meta.sessions} maxAgeHours={MAX_AGE_HOURS.sessions} />
        {
          failures.map((source) => (
            <p class="mt-1 text-sm font-semibold text-warn" role="status" data-testid="gazette-failure">
              La dernière collecte {source.label} a échoué : ses derniers relevés valides restent utilisés.
            </p>
          ))
        }
      </div>
    </PageHeader>

    {
      week && (
        <section class="card card-accent p-5 md:p-6" aria-labelledby="gazette-now-title" data-testid="gazette-now">
          <h2 id="gazette-now-title" class="text-2xl">Semaine en cours, {weekLabel(week)}</h2>
          <p class="tnum mt-2 text-lg" data-testid="gazette-now-lead">{currentWeekLead(week)}</p>
          {weekComparison && <p class="tnum mt-1 text-sm text-muted" data-testid="gazette-now-comparison">{weekComparison}</p>}
          <p class="mt-2 text-sm text-muted">{endSentence(`Édition complète le lundi ${fmtDay(addDays(week.to, 1))}`)}</p>
        </section>
      )
    }

    {
      latest ? (
        <>
          <article class="stage stage-blue reveal mt-8" aria-labelledby="gazette-latest-title" data-testid="gazette-latest">
            <h2 id="gazette-latest-title" class="section-title">Semaine {weekLabel(latest)}</h2>
            <GazetteEditionBlock edition={latest} records={records} {...context} />
          </article>

          {older.length > 0 && (
            <section class="reveal mt-10" aria-labelledby="gazette-older-title">
              <h2 id="gazette-older-title" class="section-title">Les éditions précédentes</h2>
              <div class="mt-6 space-y-3">
                {recentOlder.map((edition) => (
                  <GazetteOlder edition={edition} records={records} {...context} />
                ))}
              </div>
              {oldest && (
                <details class="mt-5" data-testid="gazette-ancient">
                  <summary class="cursor-pointer font-semibold">
                    {ancient.length > 1 ? `Voir les ${fmtInt(ancient.length)} éditions plus anciennes` : "Voir l'édition la plus ancienne"}
                    <span class="tnum font-normal text-muted"> · depuis la semaine {weekLabel(oldest)}</span>
                  </summary>
                  <div class="mt-4 space-y-3">
                    {ancient.map((edition) => (
                      <GazetteOlder edition={edition} records={records} {...context} />
                    ))}
                  </div>
                </details>
              )}
            </section>
          )}
        </>
      ) : (
        <Empty title="Pas de données">Aucune semaine complète n'a encore été collectée.</Empty>
      )
    }
  </div>
</Base>
