---
// La liste officielle des membres, onglet de la rubrique Membres depuis le 12 novembre 2026 à la demande du pilote :
// elle était en bas de la page Membres, qui garde les paliers, l'encadrement et le classé.
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import PageHeader from "../components/PageHeader.astro";
import MembersTable from "../components/MembersTable.tsx";
import ReadingNote from "../components/ReadingNote.astro";
import { NiveauEmblem } from "../components/NiveauEmblem";
import { clan } from "../../config/clan";
import { loadMeta } from "../lib/data";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { prestigeKey } from "../lib/niveau";

const PRESTIGE_KEY = prestigeKey();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const src = `${base}/data/members.json`;
---

<Base title="Liste des membres" description="La liste officielle des membres du clan GAL sur OpenFront : victoires, parties et taux en équipe sous le tag, date d'arrivée et niveau du compte de ceux qui le montrent.">
  <div class="wrap">
    <PageHeader title="Liste des membres">
      <div class="mt-4">
        <DataStatus state={meta.members} maxAgeHours={MAX_AGE_HOURS.members} />
      </div>
      <ReadingNote>
        <p data-testid="members-scope">La liste officielle du clan dans OpenFront. Parties publiques en équipe jouées avec le tag {clan.tag}, sans le classé, le FFA ni Humains contre Nations.</p>
        <p>« 0 » signifie aucune partie sous le tag, ce qui ne veut pas dire que le joueur est inactif. « — » signifie pas de données, ou pas de taux sans partie jouée. Un pseudo mène à la fiche du membre.</p>
        <p data-testid="members-level-scope">Le niveau et le prestige sont ceux du compte OpenFront, tout le jeu confondu, pas seulement les parties sous le tag. « non visible » : le réglage « Montrer mon niveau aux autres joueurs » est éteint dans son compte OpenFront, ou il n'a pas encore de niveau. Chaque cran allumé autour de l'emblème est un prestige, dans la couleur que lui donne le jeu :</p>
        <ul class="mt-2 flex flex-wrap gap-x-6 gap-y-2" data-testid="prestige-colors">
          {PRESTIGE_KEY.map((k) => (
            <li class="flex items-center gap-2 whitespace-nowrap text-sm">
              <NiveauEmblem account={k.account} />
              {k.label}
            </li>
          ))}
        </ul>
      </ReadingNote>
    </PageHeader>

    <MembersTable client:load src={src} />
    <noscript><p class="card mt-4 p-5">JavaScript est nécessaire pour afficher et trier la liste des membres.</p></noscript>
  </div>
</Base>
