---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { clan } from "../../config/clan";
import { brandFile } from "../lib/brand";
import { loadSessions } from "../lib/data";
import { fmtDate, fmtPct } from "../lib/format";
import { groupStats } from "../lib/sessions";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hasLogo = brandFile("vertical") !== null;
const group = groupStats(loadSessions());
const alone = group?.sizes[0];
const together = group?.sizes[group.sizes.length - 1];
// Une étape qui se comprend à son titre n'a pas de phrase.
const steps: { title: string; body?: string }[] = [
  { title: "Créez un compte OpenFront" },
  { title: `Cherchez le clan [${clan.tag}]`, body: "Ouvrez la section Clans du jeu, puis l'onglet Rechercher." },
  clan.join.inviteOnly
    ? { title: "Demandez une invitation", body: "Sur sa fiche : « Demander une invitation ». Un officier vous répond." }
    : { title: "Rejoignez le clan", body: "Sur sa fiche, utilisez « Rejoindre le clan »." },
  { title: "Retrouvez-nous sur Discord" },
];
---

<Base title="Rejoindre" description="Comment rejoindre le clan GAL dans OpenFront et sur Discord.">
  {/* Le halo du logo dépasse de sa colonne et suit la souris : il ne doit jamais élargir la page. */}
  <div class="overflow-x-clip">
    <div class="wrap">
      <PageHeader title="Rejoindre le clan" />

      <div class="grid items-center gap-10 lg:grid-cols-[3fr_2fr]">
        <div>
          <ol class="grid gap-3" data-testid="join-steps">
            {
              steps.map((s, i) => (
                <li class="card flex gap-4 p-5" data-tilt="2">
                  <span class="tnum font-display text-3xl font-extrabold text-blue-text" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h2 class="text-lg">{s.title}</h2>
                    {s.body && <p class="mt-1 text-muted">{s.body}</p>}
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href={clan.links.discord} class="btn btn-lg btn-primary" rel="noopener">Rejoindre le Discord</a>
            <a href={clan.links.openfront} class="btn btn-lg btn-secondary" rel="noopener">Jouer à OpenFront</a>
          </div>
        </div>
        {
          hasLogo && (
            <div class="fx-stage relative hidden justify-center lg:flex">
              <div class="hero-glow" aria-hidden="true"></div>
              <div class="float relative w-full max-w-sm">
                <img src={`${base}/generated/logo-vertical-720.webp`} width="720" height="720" alt="" class="h-auto w-full" draggable="false" data-fx-logo />
              </div>
            </div>
          )
        }
      </div>

      {
        alone && together && (
          <section class="reveal mt-8 max-w-3xl" data-testid="join-group">
            <p class="text-lg text-muted">
              {alone.label} : {fmtPct(alone.winRate)} de victoires. {together.label} : {fmtPct(together.winRate)}. <a href={`${base}/activite`}>Voir quand trouver un groupe</a>.
            </p>
            <p class="mt-1 text-sm text-muted">Depuis le {fmtDate(`${clan.archiveStart}T12:00:00Z`)}. Un lien, pas une preuve.</p>
          </section>
        )
      }
      <p class="reveal mt-4 max-w-3xl text-muted" data-testid="join-guides">Nouveau sur OpenFront ? <a href={`${base}/debuter`}>Lisez le guide du clan</a>.</p>

      {
        clan.entryConditions.length > 0 && (
          <section class="mt-10 max-w-3xl">
            <h2 class="text-2xl">Conditions d'entrée</h2>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-muted">
              {clan.entryConditions.map((c) => <li>{c}</li>)}
            </ul>
          </section>
        )
      }
      {
        clan.values.length > 0 && (
          <section class="mt-10 max-w-3xl">
            <h2 class="text-2xl">Nos valeurs</h2>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-muted">
              {clan.values.map((v) => <li>{v}</li>)}
            </ul>
          </section>
        )
      }
      {
        clan.history && (
          <section class="mt-10 max-w-3xl">
            <h2 class="text-2xl">Notre histoire</h2>
            <p class="mt-3 text-muted">{clan.history}</p>
          </section>
        )
      }
    </div>
  </div>
</Base>
