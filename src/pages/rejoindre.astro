---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { clan } from "../../config/clan";
import { brandFile } from "../lib/brand";
import { loadSessions } from "../lib/data";
import { fmtDate, fmtPct } from "../lib/format";
import { groupStats } from "../lib/sessions";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const hasLogo = brandFile("vertical") !== null;
const group = groupStats(loadSessions());
const alone = group?.sizes[0];
const together = group?.sizes[group.sizes.length - 1];
const steps = [
  { title: "Créez un compte OpenFront", body: "Le jeu demande un compte pour rejoindre un clan." },
  { title: `Cherchez le clan [${clan.tag}]`, body: "Ouvrez la section Clans du jeu, puis l'onglet Rechercher." },
  clan.join.inviteOnly
    ? { title: "Demandez une invitation", body: "Le clan fonctionne sur invitation : sur sa fiche, utilisez « Demander une invitation ». Un chef ou un officier répond à la demande." }
    : { title: "Rejoignez le clan", body: "Sur sa fiche, utilisez « Rejoindre le clan »." },
  { title: "Retrouvez-nous sur Discord", body: "Le lien du serveur du clan se trouve juste en dessous." },
];
---

<Base title="Rejoindre" description="Comment rejoindre le clan GAL dans OpenFront et sur Discord.">
  <div>
    <div class="wrap">
      <PageHeader title="Rejoindre le clan" intro="Quatre étapes pour nous rejoindre dans le jeu, puis sur le Discord." />

      <div class="grid items-center gap-10 lg:grid-cols-[3fr_2fr] lg:gap-14">
        <div>
          {/* Une vraie suite d'étapes : les numéros disent l'ordre. */}
          <ol class="divide-y divide-line border-y border-line" data-testid="join-steps">
            {
              steps.map((s, i) => (
                <li class="grid grid-cols-[2.75rem_1fr] gap-4 py-5 sm:grid-cols-[3.5rem_1fr]">
                  <span class="figure text-4xl text-blue-text sm:text-5xl" aria-hidden="true">{i + 1}</span>
                  <div>
                    <h2 class="text-2xl">{s.title}</h2>
                    <p class="mt-1 text-muted">{s.body}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-3">
            <a href={clan.links.discord} class="btn btn-lg btn-primary" rel="noopener">Rejoindre le Discord</a>
            <a href={clan.links.openfront} class="link" rel="noopener">Jouer à OpenFront</a>
          </div>
        </div>
        {
          hasLogo && (
            <div class="hidden justify-center lg:flex">
              <img src={`${base}/generated/logo-vertical-720.webp`} width="720" height="720" alt="" class="h-auto w-full max-w-xs" loading="lazy" />
            </div>
          )
        }
      </div>

      {
        alone && together && (
          <section class="band mt-12 max-w-3xl" data-testid="join-group">
            <p class="text-lg text-muted">
              {alone.label} : {fmtPct(alone.winRate)} de victoires. {together.label} : {fmtPct(together.winRate)}. <a href={`${base}/activite`}>Voir quand trouver un groupe</a>.
            </p>
            <p class="mt-1 text-sm text-muted">Parties publiques en équipe jouées avec le tag depuis le {fmtDate(`${clan.archiveStart}T12:00:00Z`)}. Un lien, pas une preuve : le niveau des joueurs et le format de la partie comptent aussi.</p>
          </section>
        )
      }
      <p class="mt-4 max-w-3xl text-lg text-muted" data-testid="join-guides">Nouveau sur OpenFront ? <a href={`${base}/debuter`}>Lisez les guides</a>.</p>

      {
        clan.entryConditions.length > 0 && (
          <section class="mt-10 max-w-3xl">
            <h2 class="section-title-sm">Conditions d'entrée</h2>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-muted">
              {clan.entryConditions.map((c) => <li>{c}</li>)}
            </ul>
          </section>
        )
      }
      {
        clan.values.length > 0 && (
          <section class="mt-10 max-w-3xl">
            <h2 class="section-title-sm">Nos valeurs</h2>
            <ul class="mt-3 list-disc space-y-1 pl-5 text-muted">
              {clan.values.map((v) => <li>{v}</li>)}
            </ul>
          </section>
        )
      }
      {
        clan.history && (
          <section class="mt-10 max-w-3xl">
            <h2 class="section-title-sm">Notre histoire</h2>
            <p class="mt-3 text-muted">{clan.history}</p>
          </section>
        )
      }
    </div>
  </div>
</Base>
