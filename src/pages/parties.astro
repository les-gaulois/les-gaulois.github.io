---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import Empty from "../components/Empty.astro";
import GamesJournal from "../components/GamesJournal.tsx";
import MapNamesCredit from "../components/MapNamesCredit.astro";
import PageHeader from "../components/PageHeader.astro";
import ReadingNote from "../components/ReadingNote.astro";
import { clan } from "../../config/clan";
import { loadGames, loadLeaderboard, loadMeta, loadSessions } from "../lib/data";
import { fmtInt } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { MIN_CLAN_PLAYERS } from "../lib/games";
import { clanJournal, JOURNAL_DAYS, JOURNAL_FIRST_ROWS } from "../lib/journal";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const { rows, sides, coverage } = clanJournal({
  sessions: loadSessions(),
  games: loadGames(),
  coveredUntil: meta.sessions.coveredUntil,
  tag: clan.tag,
  officialTags: loadLeaderboard()?.clans.map((c) => c.clanTag) ?? [],
});
---

<Base title="Dernières parties" description="Les dernières parties du clan GAL sur OpenFront : carte, format, résultat, clans rencontrés et lien vers le jeu.">
  <div class="wrap">
    <PageHeader title="Dernières parties" intro={`Les ${JOURNAL_DAYS} derniers jours, heure de Paris.`}>
      <div class="mt-4">
        <DataStatus state={meta.sessions} maxAgeHours={MAX_AGE_HOURS.sessions} />
      </div>
    </PageHeader>

    {
      rows.length === 0 ? (
        <Empty title="Pas de données">Aucune partie enregistrée n'est disponible sur cette période.</Empty>
      ) : (
        <>
          <GamesJournal client:load src={`${base}/parties.json`} initial={rows.slice(0, JOURNAL_FIRST_ROWS)} sides={sides} />
          {!sides && (
            <p class="mt-4 max-w-3xl font-semibold text-warn" role="status" data-testid="journal-clans-suspended">
              Les autres clans ne sont plus affichés : trop de parties récentes contredisent le calcul de leurs équipes. Les règles du jeu ont peut-être changé.
            </p>
          )}
          <noscript><p class="card mt-4 p-4 text-sm text-muted">JavaScript est nécessaire pour les filtres et pour afficher plus de parties.</p></noscript>
          <ReadingNote label="Comment lire cette liste">
            <p>Parties publiques en équipe jouées avec le tag. Le résultat est celui qu'OpenFront compte pour le clan.</p>
            <p>« Gaulois » donne les joueurs du clan et ceux de la partie, tels qu'OpenFront les compte : un joueur parti très tôt peut ne pas y figurer.</p>
            {sides && (
              <p data-testid="journal-clans-note">
                « Contre » et « Avec » ne citent que les clans de la liste officielle, avec au moins {MIN_CLAN_PLAYERS} joueurs dans la partie, et leur nombre entre parenthèses. Les autres tags ne sont pas repris : chacun choisit le sien librement. L'API ne donne pas l'équipe des perdants : elle est calculée avec la règle du jeu, et rien n'est écrit si le calcul contredit le résultat officiel. Les <a href={`${base}/rivaux`}>face-à-face de la page Nos rivaux</a> utilisent ce calcul, mais ils ne gardent que les parties à {MIN_CLAN_PLAYERS} Gaulois ou plus, sur 90 jours : leurs chiffres ne sont pas ceux du filtre « Contre le clan ».
              </p>
            )}
            <p>« — » : le détail de cette partie n'est pas encore lu. C'est lui qui donne la carte, la durée et les autres clans.</p>
          </ReadingNote>
          {/* La couverture ne s'écrit que lorsqu'il manque des parties : c'est alors elle qui change la lecture des chiffres. */}
          {coverage.read < coverage.total && <p class="tnum mt-2 text-sm text-muted" data-testid="journal-coverage">Détail lu pour {fmtInt(coverage.read)} parties sur {fmtInt(coverage.total)}.</p>}
          <MapNamesCredit />
          <div class="mt-4">
            <p class="text-sm font-semibold text-muted">Le détail des parties</p>
            <DataStatus state={meta.games} maxAgeHours={MAX_AGE_HOURS.games} />
          </div>
        </>
      )
    }
  </div>
</Base>
