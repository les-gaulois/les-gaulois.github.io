---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import Empty from "../components/Empty.astro";
import Invite from "../components/Invite.astro";
import PageJumps from "../components/PageJumps.astro";
import TerritoryChart from "../components/TerritoryChart.tsx";
import { clan } from "../../config/clan";
import { clanRgb } from "../lib/clanmap/codec";
import { NEUTRAL_PIXEL_TROOPS, RULES_CHECKED_ON, TROOPS_PER_CAP, capsToTroops, neutralPixelsFor, objectiveFor } from "../lib/clanmap/economy";
import { FILM_MS, SHOT_SPACING_MS } from "../lib/fx/camera";
import { SPEED_MAX, SPEED_MIN, SPEED_STEP, speedLabel, speedText } from "../lib/fx/speed";
import { changeSinceLastDay, dayHighlights, dayRows, parisDayOf, territorySeries, type DayRow } from "../lib/clanmap/days";
import { findMoments, nextThreshold } from "../lib/clanmap/moments";
import { loadClanMapFilm, loadClanMapJournal, loadMeta } from "../lib/data";
import { fmtDate, fmtDay, fmtDec1, fmtEpochDay, fmtEpochTime, fmtInt, fmtRank } from "../lib/format";
import { endingOn } from "../lib/gazette";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { loadVisitSnapshot } from "../lib/visite-snapshot";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const film = loadClanMapFilm();
const gal = film?.galSummary ?? null;
const assets = `${base}/generated/carte/`;
const ordinal = (n: number) => `${n}${n === 1 ? "er" : "e"}`;
const signed = (n: number) => `${n > 0 ? "+" : n < 0 ? "−" : ""}${fmtInt(Math.abs(n))}`;
const rgb = (color: number | null) => `rgb(${clanRgb(color).join(" ")})`;
const stillHeight = film ? Math.round((1400 * film.rows) / film.cols) : 0;
const landShare = film ? (film.claimed / film.land) * 100 : 0;
const clansOnMap = film?.frames.at(-1)?.clans ?? 0;
const standings = film?.standings ?? [];
const lead = standings[0]?.pixels ?? 1;
const galLine = gal ? (gal.rank === null ? `[${clan.tag}] n'a plus de pixel sur la carte.` : `GAL : ${ordinal(gal.rank)} avec ${fmtInt(gal.pixels)} pixels.`) : "GAL n'est pas sur la carte.";
const moments = film ? findMoments(film.frames) : [];

// Les vraies dates : absentes d'un film d'avant leur collecte, qui se refait au passage suivant.
const lastAt = film?.frames.at(-1)?.at;
const days = film ? dayRows(film.days ?? [], film.frames, film.fetchedAt) : [];
const recentDays = [...days].reverse();
// Seule la plus belle journée est mise en avant : le plus dur recul reste dans les grands moments et dans le tableau jour après jour.
const { gain: bestDay } = dayHighlights(days);
const dayLabel = (day: DayRow) => `Le ${fmtDay(day.date)} : ${signed(day.net)} pixels`;
const dayReplay = (day: DayRow) => ({ "data-film-day": day.start, "data-film-day-end": day.frame, "data-film-day-label": dayLabel(day) });
const dayCards = bestDay ? [{ row: bestDay, title: "Le jour où GAL a le plus progressé" }] : [];
const hasHistory = moments.length > 0 || dayCards.length > 0 || (gal?.zones.length ?? 0) > 0;
// La dernière journée terminée se rejoue d'un clic : un nouveau mini-film chaque jour.
const lastDay = [...days].reverse().find((d) => d.complete) ?? null;
const threshold = gal ? nextThreshold(gal.pixels) : null;
// Le relevé que le navigateur garde : le film reprend après la dernière image vue.
const visit = loadVisitSnapshot();

// Objectif et réserves : uniquement des chiffres collectés, et un calcul documenté.
const objective = objectiveFor(standings, clan.tag);
const treasury = film?.treasury ?? null;
const troopPixels = treasury?.troops === null || treasury?.troops === undefined ? null : neutralPixelsFor(treasury.troops);
const capPixels = treasury?.caps === null || treasury?.caps === undefined ? null : neutralPixelsFor(capsToTroops(treasury.caps));
const reservePixels = troopPixels === null && capPixels === null ? null : (troopPixels ?? 0) + (capPixels ?? 0);
const goalProgress = objective?.above ? Math.min(100, (objective.me.pixels / objective.above.pixels) * 100) : null;
const troopsText = treasury?.troops === null || treasury?.troops === undefined ? "pas de données" : fmtInt(treasury.troops);
const capsText = treasury?.caps === null || treasury?.caps === undefined ? "pas de données" : fmtInt(treasury.caps);
// Avec une seule des deux valeurs, le total n'est qu'un minimum : il peut dire « assez », jamais « il en manque ».
const reserveComplete = troopPixels !== null && capPixels !== null;
const reserveGoal =
  reservePixels === null || !objective || objective.gap === null
    ? null
    : reservePixels >= objective.gap
      ? "Assez pour atteindre l'objectif."
      : reserveComplete
        ? `Il en manque ${fmtInt(objective.gap - reservePixels)} pour l'objectif.`
        : null;

// La page se lit de haut en bas : revoir l'histoire, où en est GAL, puis le détail.
const jumps = [
  { href: "#histoire", label: "Revoir l'histoire", show: hasHistory },
  { href: "#objectif", label: "Où en est GAL", show: gal !== null },
  { href: "#details", label: "Les détails", show: true },
].filter((jump) => jump.show);

const journal = loadClanMapJournal();
const today = journal.at(-1);
const previousDay = journal.at(-2);
// Depuis la dernière journée terminée, comme le tableau jour après jour. Le journal ne sert qu'aux films sans dates.
const sinceDay = gal ? changeSinceLastDay(days, gal.pixels) : null;
const sinceLine =
  sinceDay
    ? `${signed(sinceDay.change)} pixels depuis la fin du ${fmtDay(sinceDay.date).replace(/\.$/, "")}.`
    : today && previousDay
      ? `${signed(today.pixels - previousDay.pixels)} pixels depuis le ${fmtDay(previousDay.date).replace(/\.$/, "")}.`
      : null;
---

<Base title="Carte" description="Le territoire du clan GAL sur la carte officielle des clans d'OpenFront, rejoué du premier pixel au dernier, et l'objectif du moment.">
  {
    !film ? (
      <div class="wrap pt-12">
        <Invite path="/carte" />
        <h1 class="page-title">La carte des clans</h1>
        <div class="mt-4">
          <DataStatus state={meta.clanmap} maxAgeHours={MAX_AGE_HOURS.clanmap} />
        </div>
        <div class="mt-6">
          <Empty title="Pas de données">La carte n'a pas encore été collectée.</Empty>
        </div>
      </div>
    ) : (
      <>
        <section data-film data-assets={assets} data-visit={visit ? JSON.stringify(visit) : undefined} aria-labelledby="map-page-title">
          <div class="film-hero">
            <div class="film-title">
              <Invite path="/carte" />
              <h1 id="map-page-title">La carte des clans</h1>
              <DataStatus state={meta.clanmap} maxAgeHours={MAX_AGE_HOURS.clanmap} />
            </div>

            <div class="film-map" data-film-map data-testid="film-map">
              <img
                src={`${assets}finale-1400.webp`}
                srcset={`${assets}finale-800.webp 800w, ${assets}finale-1400.webp 1400w`}
                sizes="100vw"
                width="1400"
                height={stillHeight}
                alt={`La carte officielle des clans à la fin de l'historique. ${galLine}`}
              />
              <canvas data-film-canvas hidden role="img" aria-label="Carte animée des territoires de clans. Les mêmes chiffres sont donnés en texte à côté et sous la carte."></canvas>
              <p class="film-hud tnum" data-film-ready hidden aria-hidden="true"><strong class="film-hud-date" data-film-date data-testid="film-date" hidden></strong>Événement <span data-film-event></span></p>
              <button type="button" class="chip film-world" data-film-world hidden>Vue d'ensemble</button>
              <p class="film-caption" data-film-caption hidden aria-hidden="true"></p>
              <div class="film-tip" data-film-tip hidden aria-hidden="true"></div>
            </div>

            <aside class="card film-ladder p-4" aria-labelledby="ladder-title">
              <h2 id="ladder-title" class="text-base">Le territoire à cet instant</h2>
              <p class="mt-1 text-xs text-muted">Pixels peints sur la carte, pas le classement des clans.</p>
              <p class="tnum mt-1 text-xs text-muted"><span data-film-land>{fmtDec1(landShare)}</span> % des terres · <span data-film-clans>{fmtInt(clansOnMap)}</span> clans</p>
              <ol class="film-rows tnum mt-2" data-film-rows>
                {
                  standings.slice(0, 5).map((c, i) => (
                    <li class:list={["film-row", c.tag === clan.tag && "is-gal"]} style={{ transform: `translateY(${i * 38}px)` }}>
                      <span class="text-muted">{i + 1}</span>
                      <span class="truncate font-semibold">{c.tag ?? "Clan supprimé"}</span>
                      <span>{fmtInt(c.pixels)}</span>
                      <span class="film-bar"><i style={{ width: `${(c.pixels / lead) * 100}%`, background: rgb(c.color) }}></i></span>
                    </li>
                  ))
                }
              </ol>
              <p class="tnum border-t border-line pt-2 text-sm font-semibold" data-film-pinned data-testid="film-gal">{galLine}</p>
            </aside>

            <div class="film-controls" data-film-ready hidden>
              <div class="film-deck">
                <button type="button" class="btn btn-primary film-play" data-film-play data-testid="film-play">
                  <svg viewBox="0 0 14 14" width="14" height="14" fill="currentColor" aria-hidden="true"><path data-film-play-icon d="M2 1l11 6-11 6z"></path></svg>
                  <span data-film-play-label>Lancer le film</span>
                </button>
                {lastDay && (
                  <button type="button" class="btn btn-ghost" {...dayReplay(lastDay)} data-testid="film-last-day" aria-label={`Revoir le ${fmtDay(lastDay.date)}, la dernière journée terminée`}>
                    Revoir le {fmtDay(lastDay.date)}
                  </button>
                )}
                <div class="film-scrub">
                  <svg data-film-curve preserveAspectRatio="none" aria-hidden="true" style={{ "--gal": rgb(film.gal === null ? null : (film.clans[film.gal]?.color ?? null)) }}><path></path></svg>
                  <span class="film-ticks" data-film-ticks aria-hidden="true"></span>
                  <input type="range" min="0" value="0" step="1" data-film-pos data-testid="film-pos" aria-label="Position dans le film" />
                  <span class="film-dates tnum" data-film-dates data-testid="film-dates" aria-hidden="true"></span>
                </div>
                <div class="film-speed">
                  <label for="film-speed" class="text-sm font-semibold text-muted">Vitesse</label>
                  <input
                    id="film-speed"
                    class="film-range"
                    type="range"
                    min={SPEED_MIN}
                    max={SPEED_MAX}
                    step={SPEED_STEP}
                    value={SPEED_MAX}
                    aria-valuetext={speedText(SPEED_MAX)}
                    data-film-speed
                    data-testid="film-speed"
                  />
                  {/* La valeur écrite pour les yeux ; le curseur la donne déjà aux lecteurs d'écran. */}
                  <output for="film-speed" class="tnum text-sm font-semibold" aria-hidden="true" data-film-speed-value>{speedLabel(SPEED_MAX)}</output>
                </div>
                <div class="film-opts">
                  <button type="button" class="chip" data-film-focus aria-pressed="false">Griser les autres</button>
                </div>
              </div>
            </div>
          </div>

          <p class="sr-only" role="status" data-film-status></p>
          <div class="wrap mt-3 flex flex-wrap items-center gap-3 text-sm font-semibold text-warn" role="status" data-film-message hidden>
            <span data-film-message-text></span>
            <button type="button" class="btn btn-ghost !min-h-10 !py-1.5" data-film-retry>Réessayer</button>
          </div>

          <div class="wrap mt-2">
            <PageJumps links={jumps} />
          </div>
        </section>

        <div class="wrap mt-10 grid grid-cols-1 gap-12 md:gap-16">
          {
            hasHistory && (
              <section class="scroll-mt-24" id="histoire" aria-labelledby="history-title">
                <h2 id="history-title" class="section-title section-title-sm">Revoir l'histoire</h2>
                {/* Large et peu haut : les grands moments en tuiles sur toute la largeur, puis la journée et les zones côte à côte. */}
                {
                  moments.length > 0 && (
                    <div class="card mt-5 p-4 sm:p-5" data-film-ready hidden data-testid="map-moments">
                      <h3 class="text-lg">Les grands moments</h3>
                      <ol class="film-tiles mt-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
                        {moments.map((m) => (
                          <li>
                            <button type="button" class="film-tile" data-film-moment={m.frame}>
                              <span class="tnum text-xs text-muted">{m.at === null ? "" : fmtEpochDay(m.at)}</span>
                              {/* Le dernier relevé n'a pas besoin de ses chiffres ici : ils sont juste au-dessus, sous la carte. Le film les garde dans sa légende. */}
                              <span class="font-semibold">{m.kind === "now" ? "Dernier relevé" : m.title}</span>
                            </button>
                          </li>
                        ))}
                      </ol>
                    </div>
                  )
                }
                {
                  (dayCards.length > 0 || (gal?.zones.length ?? 0) > 0) && (
                    <div class="mt-5 grid grid-cols-1 gap-5 md:grid-cols-2">
                      {
                        dayCards.length > 0 && (
                          <div class="card p-4 sm:p-5" data-testid="map-days">
                            <h3 class="text-lg">La plus belle journée</h3>
                            {dayCards.map(({ row, title }) => (
                              <div class="mt-3 flex flex-wrap items-end justify-between gap-x-4 gap-y-3" data-testid="map-day">
                                <div>
                                  <p class="text-sm font-semibold text-muted">{title}</p>
                                  <p class="tnum mt-1 font-display text-2xl font-extrabold">{signed(row.net)} pixels</p>
                                  <p class="tnum mt-1 text-sm text-muted">Le {fmtDay(row.date)} : {fmtInt(row.taken)} pris, {fmtInt(row.lost)} perdus.</p>
                                </div>
                                <div data-film-ready hidden>
                                  <button type="button" class="btn btn-ghost !min-h-10 !py-1.5 !text-sm" {...dayReplay(row)} aria-label={`Revoir cette journée, le ${fmtDay(row.date)}`}>Revoir cette journée</button>
                                </div>
                              </div>
                            ))}
                          </div>
                        )
                      }
                      {
                        gal && gal.zones.length > 0 && (
                          <div class="card p-4 sm:p-5" data-film-ready hidden>
                            <h3 class="text-lg">Nos territoires</h3>
                            <p class="tnum mt-1 text-sm text-muted">Les {fmtInt(gal.zones.length)} plus grandes, sur {fmtInt(gal.zoneCount)} zones d'un seul tenant.</p>
                            <ul class="film-tiles mt-3 grid-cols-[repeat(auto-fill,minmax(8rem,1fr))]">
                              {gal.zones.map((z, i) => (
                                <li>
                                  <button type="button" class="film-tile" data-film-look={`Zone ${i + 1} : ${fmtInt(z.pixels)} pixels`} data-x={z.x} data-y={z.y} data-half-width={z.halfWidth} data-half-height={z.halfHeight}>
                                    {/* Le nom lu reprend le texte visible, avec une pause entre le numéro et les pixels. */}
                                    <span class="text-xs text-muted">Zone {i + 1}<span class="sr-only"> :</span></span>
                                    <span class="tnum font-semibold">{fmtInt(z.pixels)} pixels</span>
                                  </button>
                                </li>
                              ))}
                            </ul>
                          </div>
                        )
                      }
                    </div>
                  )
                }
              </section>
            )
          }

          {
            gal && (
              <section class="stage stage-blue grid scroll-mt-24 grid-cols-1 items-start gap-8 md:grid-cols-2" id="objectif" aria-labelledby="goal-title" data-testid="map-goal">
                <div>
                  {objective ? (
                    <>
                      <p class="text-sm font-semibold uppercase tracking-wide text-muted">{ordinal(objective.rank)} sur la carte</p>
                      {objective.above && objective.gap !== null ? (
                        <>
                          <h2 id="goal-title" class="section-title mt-2">Prochain objectif&nbsp;: dépasser {objective.above.tag ?? "le clan suivant"}</h2>
                          <p class="tnum mt-4 font-display text-5xl font-extrabold" data-testid="map-gap" data-count={objective.gap}>{fmtInt(objective.gap)}</p>
                          <p class="mt-1 text-lg text-muted">pixels à gagner pour passer {ordinal(objective.rank - 1)}.</p>
                          <div class="meter meter-lg mt-5" aria-hidden="true"><i style={{ "--v": `${goalProgress}%` }}></i></div>
                          <p class="tnum mt-2 text-sm text-muted">GAL <span data-testid="map-pixels">{fmtInt(objective.me.pixels)}</span> · {objective.above.tag} {fmtInt(objective.above.pixels)}</p>
                        </>
                      ) : (
                        <>
                          <h2 id="goal-title" class="section-title mt-2">GAL occupe le plus grand territoire</h2>
                          <p class="tnum mt-2 text-lg text-muted"><span data-testid="map-pixels">{fmtInt(objective.me.pixels)}</span> pixels.</p>
                        </>
                      )}
                      {objective.below && objective.lead !== null && (
                        <p class="tnum mt-3 text-sm text-muted">{objective.below.tag ?? "Le clan suivant"} suit à {fmtInt(objective.lead)} pixels.</p>
                      )}
                    </>
                  ) : (
                    <>
                      <h2 id="goal-title" class="section-title mt-2">GAL sur la carte</h2>
                      <p class="tnum mt-2 text-lg text-muted"><span data-testid="map-pixels">{fmtInt(gal.pixels)}</span> pixels{gal.rank === null && " : plus aucun sur la carte"}.</p>
                    </>
                  )}
                  {/* Territoire et place ne sont écrits qu'ici, et sous le film : « GAL en chiffres » ne les répète pas. */}
                  {sinceLine && <p class="tnum mt-3 text-sm font-semibold" data-testid="map-journal">{sinceLine}</p>}
                  {threshold && (
                    <p class="tnum mt-4 font-semibold" data-testid="map-next-threshold">
                      Prochain palier : {fmtInt(threshold.threshold)} pixels, encore {fmtInt(threshold.remaining)}.
                    </p>
                  )}
                </div>
                <div class="panel">
                  {/* Sur téléphone, ces chiffres se replient : le rang et le territoire du moment restent écrits au-dessus, et dans l'encart du film. Sans script, tout reste ouvert. */}
                  <details class="fold-phone" open data-fold-phone data-testid="fold-figures">
                    <summary><h3 class="text-sm tracking-wide text-muted">GAL en chiffres</h3></summary>
                  <dl class="tnum mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2">
                    <div data-testid="map-figure">
                      <dt class="text-sm text-muted">Plus grand territoire</dt>
                      <dd class="mt-1 font-display text-2xl font-extrabold" data-testid="map-peak">{fmtInt(gal.peak.pixels)} pixels</dd>
                      {gal.peak.pixels === gal.pixels ? (
                        <dd class="mt-1 text-sm text-muted">C'est son territoire actuel.</dd>
                      ) : (
                        gal.peak.at !== undefined && <dd class="mt-1 text-sm text-muted">Atteint le {endingOn(parisDayOf(gal.peak.at))}</dd>
                      )}
                    </div>
                    <div data-testid="map-figure">
                      <dt class="text-sm text-muted">Pris et perdus</dt>
                      <dd class="mt-1 font-display text-2xl font-extrabold">+{fmtInt(gal.taken)} / −{fmtInt(gal.lost)}</dd>
                      <dd class="mt-1 text-sm text-muted">Dont {fmtInt(gal.neutralTaken)} pixels pris sur des terres neutres.</dd>
                    </div>
                    <div data-testid="map-figure">
                      <dt class="text-sm text-muted">Premier pixel</dt>
                      <dd class="mt-1 font-display text-2xl font-extrabold" data-testid="map-first">{gal.firstAt === undefined ? `Événement n° ${fmtInt(gal.firstEvent)}` : fmtDate(new Date(gal.firstAt * 1000).toISOString())}</dd>
                      <dd class="mt-1 text-sm text-muted">{gal.firstAt !== undefined && `Événement n° ${fmtInt(gal.firstEvent)}, sur `}{gal.firstAt === undefined && "Sur "}{fmtInt(film.events)} changements de main au total.</dd>
                    </div>
                    {/* La fiche du clan ne répond pas toujours à la collecte : sans chiffre, pas de grande case vide, mais une ligne sous les chiffres le dit. */}
                    {reservePixels !== null && (
                      <div data-testid="map-figure">
                        <dt class="text-sm text-muted">Réserves du clan</dt>
                        <dd class="mt-1 font-display text-2xl font-extrabold">{reserveComplete ? "Environ" : "Au moins"} {fmtInt(reservePixels)} pixels neutres</dd>
                        <dd class="mt-1 text-sm text-muted" data-testid="map-reserves">Troupes prêtes : {troopsText}. Capsules au trésor : {capsText}.</dd>
                        {reserveGoal && <dd class="mt-1 text-sm font-semibold">{reserveGoal}</dd>}
                      </div>
                    )}
                  </dl>
                  {gal.neutralBorder !== null && <p class="tnum mt-5 text-sm text-muted" data-testid="map-neutral-border">{fmtInt(gal.neutralBorder)} pixels de terre neutre touchent déjà notre territoire.</p>}
                  {reservePixels === null && <p class="mt-2 text-sm text-muted" data-testid="map-no-reserves">Réserves du clan : pas de données.</p>}
                  {
                    (reservePixels !== null || gal.neutralBorder !== null) && (
                      <p class="mt-2 text-xs text-muted">
                        {reservePixels === null ? "Repère indicatif" : "Repères indicatifs"}, selon les règles du jeu lues le {fmtDate(`${RULES_CHECKED_ON}T12:00:00Z`)}.
                      </p>
                    )
                  }
                  </details>
                  <script is:inline>
                    (function (fold) {
                      if (fold && matchMedia("(width < 48rem)").matches) fold.open = false;
                    })(document.currentScript.previousElementSibling);
                  </script>
                </div>
              </section>
            )
          }

          <section class="scroll-mt-24" id="details" aria-labelledby="details-title">
            <h2 id="details-title" class="section-title section-title-sm">Les détails</h2>
            <div class="fold-list mt-4">
              {
                days.length > 0 && (
                  <details class="fold" data-testid="fold-days">
                    <summary><h3 class="text-xl">Jour après jour</h3></summary>
                    <div class="mt-4">
                      <TerritoryChart client:visible points={territorySeries(days)} />
                    </div>
                    <div class="card mt-4 overflow-x-auto">
                      <table class="data-table film-fronts tnum w-full" data-testid="film-days">
                        <caption class="p-3 text-left text-sm text-muted">Les journées de GAL sur la carte depuis son premier pixel, la plus récente d'abord, en heure de Paris. Territoire et place à la fin de la journée.</caption>
                        <thead>
                          <tr>
                            <th scope="col">Jour</th>
                            <th scope="col" class="num hidden sm:table-cell">Pris</th>
                            <th scope="col" class="num hidden sm:table-cell">Perdus</th>
                            <th scope="col" class="num">Solde</th>
                            <th scope="col" class="num">Territoire</th>
                            <th scope="col" class="num">Place</th>
                          </tr>
                        </thead>
                        <tbody>
                          {recentDays.map((d) => (
                            <tr>
                              <td class="font-semibold">
                                <button type="button" class="film-front-link" {...dayReplay(d)} aria-label={`Revoir la journée du ${fmtDay(d.date)} sur la carte`}>{fmtDay(d.date)}</button>
                                {!d.complete && lastAt !== undefined && <span class="block text-xs font-normal text-muted" data-testid="film-day-partial">relevée jusqu'à {fmtEpochTime(lastAt)}</span>}
                              </td>
                              <td class="num hidden sm:table-cell">{fmtInt(d.taken)}</td>
                              <td class="num hidden sm:table-cell">{fmtInt(d.lost)}</td>
                              <td class="num font-semibold">{signed(d.net)}</td>
                              <td class="num">{fmtInt(d.pixels)}</td>
                              <td class="num">{d.rank === null ? "—" : fmtRank(d.rank)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <p class="mt-2 text-sm text-muted" data-film-ready hidden>Cliquez sur un jour pour le rejouer sur la carte.</p>
                  </details>
                )
              }

              {
                gal && gal.fronts.length > 0 && (
                  <details class="fold" data-testid="fold-fronts">
                    <summary><h3 class="text-xl">Les fronts de GAL</h3></summary>
                    <div class="card mt-4 overflow-x-auto">
                      <table class="data-table film-fronts tnum w-full" data-testid="film-fronts">
                        <caption class="p-3 text-left text-sm text-muted">Les {gal.fronts.length} clans avec lesquels GAL a échangé le plus de pixels, hors terres neutres.</caption>
                        <thead>
                          <tr>
                            <th scope="col">Clan</th>
                            <th scope="col" class="num">Pris</th>
                            <th scope="col" class="num">Perdus</th>
                            <th scope="col" class="num">Solde</th>
                            <th scope="col" class="num">Frontière</th>
                          </tr>
                        </thead>
                        <tbody>
                          {gal.fronts.map((f) => (
                            <tr>
                              <td class="font-semibold">
                                {f.at ? (
                                  <button
                                    type="button"
                                    class="film-front-link"
                                    data-film-look={`Front ${f.tag ?? "Clan supprimé"} : ${fmtInt(f.border)} pixels de frontière`}
                                    data-x={f.at[0]}
                                    data-y={f.at[1]}
                                    data-half-width="200"
                                    data-half-height="130"
                                    data-clan={f.clan}
                                    aria-label={`Voir le front avec ${f.tag ?? "ce clan"} sur la carte`}
                                  >
                                    {f.tag ?? "Clan supprimé"}
                                  </button>
                                ) : (
                                  (f.tag ?? "Clan supprimé")
                                )}
                              </td>
                              <td class="num">{fmtInt(f.taken)}</td>
                              <td class="num">{fmtInt(f.lost)}</td>
                              <td class="num font-semibold">{signed(f.taken - f.lost)}</td>
                              <td class="num">{f.border > 0 ? fmtInt(f.border) : "—"}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <p class="mt-2 text-sm text-muted">Cliquez sur un clan pour voir ce front sur la carte.</p>
                  </details>
                )
              }

              <details class="fold" data-testid="fold-read">
                <summary><h3 class="text-xl">Comment lire cette carte</h3></summary>
                <ul class="mt-4 max-w-prose list-disc space-y-3 pl-5 text-muted">
                  <li><strong class="text-white">Une autre vue.</strong> <a href={`${base}/carte-monde/`}>La carte « World »</a> reporte la part des terres de GAL sur la carte du monde du jeu.</li>
                  <li><strong class="text-white">Ce n'est pas le classement des clans.</strong> La carte compte des pixels peints, pas des victoires. L'ordre des clans suit celui de la carte officielle. Le classement du clan reste sur la page <a href={`${base}/classement`}>Classement</a>.</li>
                  {
                    lastAt === undefined ? (
                      <li><strong class="text-white">Pas de dates dans le film.</strong> La frise suit l'ordre réel des changements, pas le temps.</li>
                    ) : (
                      <li><strong class="text-white">Des dates, mais pas une horloge.</strong> Chaque image porte la date de son dernier changement, donnée par OpenFront et écrite en heure de Paris. Le film suit le rythme des changements : une journée très active prend plus de place sur la frise qu'une journée calme.</li>
                    )
                  }
                  <li><strong class="text-white">Une vitesse au choix.</strong> À {speedLabel(SPEED_MAX)}, le film entier dure {FILM_MS / 1000} secondes. Le curseur « Vitesse » le ralentit pas à pas jusqu'à {speedLabel(SPEED_MIN)}, {Math.round(SPEED_MAX / SPEED_MIN)} fois plus lent.</li>
                  <li><strong class="text-white">Une caméra posée.</strong> La caméra glisse sans à-coup. Elle s'approche lentement de GAL sur quelques grands moments, au plus une fois toutes les {SHOT_SPACING_MS / 1000} secondes, et revient d'elle-même à la vue d'ensemble. Avec « réduire les animations », elle ne s'approche jamais et passe directement d'un cadre à l'autre.</li>
                  <li><strong class="text-white">Le film reprend où vous l'aviez laissé.</strong> Votre navigateur garde la date de la dernière image vue, sur cet appareil seulement : au retour, le film ne rejoue que la suite, et « Rejouer » redonne le film entier. Rien n'est envoyé au site.</li>
                  <li><strong class="text-white">Une mise à jour par jour.</strong> Ce ne sont pas des données en temps réel. La carte vient de l'historique public documenté par OpenFront, lu par la collecte du site et jamais par votre navigateur. Les réserves du clan viennent de sa fiche, une route non documentée : quand elle ne répond pas à la collecte, « GAL en chiffres » le dit en une ligne, sans chiffre{reservePixels === null && ", comme en ce moment"}.</li>
                  <li><strong class="text-white">Vérifié à chaque mise à jour.</strong> Chaque événement officiel annonce l'ancien propriétaire du pixel. Rejoué depuis le premier pixel, l'historique retombe dessus, avec {fmtInt(film.check.mismatches)} écart sur {fmtInt(film.check.events)} événements. En cas d'écart, le film n'est pas mis à jour.</li>
                  <li><strong class="text-white">Des paliers du site.</strong> Le prochain palier de pixels est un repère du site, pas du jeu : les mêmes paliers que les grands moments du film.</li>
                  <li><strong class="text-white">Ce que l'historique ne donne pas.</strong> Il ne dit pas les troupes des autres clans. Le site n'affiche donc pas le coût exact d'un pixel ennemi.</li>
                  <li><strong class="text-white">Des coûts indicatifs.</strong> Les réserves du clan sont converties avec les règles lues dans le code de la carte : 1 capsule = {fmtInt(TROOPS_PER_CAP)} troupes, 1 pixel neutre = {fmtInt(NEUTRAL_PIXEL_TROOPS)} troupes. Ces coûts ne tiennent pas compte de la forme du territoire ni des pixels verrouillés, et le jeu peut les changer.</li>
                  <li><strong class="text-white">Image allégée.</strong> Les chiffres sont calculés sur la carte complète, {fmtInt(film.width)} × {fmtInt(film.height)} pixels. Seul le film est affiché en résolution réduite.</li>
                  <li><strong class="text-white">Dessins des joueurs.</strong> Les motifs visibles sont peints par les joueurs, et le site ne les filtre pas.</li>
                </ul>
                <p class="mt-4 text-sm text-muted">Carte, terrain et données © OpenFront et ses contributeurs. <a href="https://clanmap.openfront.io/" rel="noopener">Voir la carte officielle</a>.</p>
                <p class="mt-2 text-sm text-muted" data-testid="map-license">Le fond de carte et la surface de terre viennent de <a href="https://github.com/openfrontio/OpenFrontIO/tree/main/resources/maps/giantworldmap" rel="noopener">Giant World Map</a>, une carte d'OpenFront sous licence <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr" rel="noopener">CC BY-SA 4.0</a>. Ce site a réduit et assombri le fond de carte, qui reste sous la même licence.</p>
              </details>
            </div>
          </section>
        </div>
      </>
    )
  }
</Base>

<script>
  import "../scripts/film";

  // Les blocs repliés sur téléphone seulement : au-delà de 48rem, ils sont toujours ouverts et leur titre ne prend pas le focus.
  // Un écran qui s'élargit (rotation) les rouvre ; un écran qui rétrécit les laisse comme ils sont.
  const narrow = matchMedia("(width < 48rem)");
  const folds = document.querySelectorAll<HTMLDetailsElement>("details[data-fold-phone]");
  const sync = () => {
    for (const fold of folds) {
      if (!narrow.matches) fold.open = true;
      const summary = fold.querySelector("summary");
      if (summary) summary.tabIndex = narrow.matches ? 0 : -1;
    }
  };
  sync();
  narrow.addEventListener("change", sync);
  // Sur grand écran, le titre n'est pas un bouton : aucune activation, aide technique comprise, ne referme le bloc.
  for (const fold of folds) {
    fold.querySelector("summary")?.addEventListener("click", (event) => {
      if (!narrow.matches && fold.open) event.preventDefault();
    });
  }
</script>
