---
import Base from "../layouts/Base.astro";
import DataStatus from "../components/DataStatus.astro";
import Empty from "../components/Empty.astro";
import Invite from "../components/Invite.astro";
import TerritoryChart from "../components/TerritoryChart.tsx";
import Fenetre from "../components/carte/Fenetre.astro";
import AllianceApp from "../components/carte/alliance/AllianceApp";
import { AUTH_ENABLED } from "../lib/compte/api";
import IconePartie from "../components/compte/IconePartie";
import { SITE_DISCLAIMER, SITE_LICENSE_NOTICE, clan } from "../../config/clan";
import { FENETRES, type FenetreId } from "../lib/carte-console";
import { clanRgb } from "../lib/clanmap/codec";
import { NEUTRAL_PIXEL_TROOPS, RULES_CHECKED_ON, TROOPS_PER_CAP, capsToTroops, neutralPixelsFor, objectiveFor } from "../lib/clanmap/economy";
import { SPEED_MAX, SPEED_MIN, SPEED_STEP, speedLabel, speedText } from "../lib/fx/speed";
import { changeSinceLastDay, dayHighlights, dayRows, parisDayOf, territorySeries, type DayRow } from "../lib/clanmap/days";
import { findMoments, nextThreshold } from "../lib/clanmap/moments";
import { TOP_SIZE } from "../lib/clanmap/replay";
import { indexDesClans } from "../lib/clanmap/vue";
import { adresseVersionnee } from "../lib/clanmap/adresse";
import { FICHIERS_DE_L_ETAT, versionDeLaCarte } from "../lib/clanmap/version";
import { loadClanMapFilm, loadClanMapJournal, loadMeta } from "../lib/data";
import { fmtDate, fmtDay, fmtDec1, fmtEpochDay, fmtEpochHour, fmtEpochTime, fmtInt, fmtRank } from "../lib/format";
import { endingOn } from "../lib/gazette";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { loadVisitSnapshot } from "../lib/visite-snapshot";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const meta = loadMeta();
const film = loadClanMapFilm();
const gal = film?.galSummary ?? null;
const assets = `${base}/generated/carte/`;
// Les fichiers de la carte gardent leur nom d'un build à l'autre : leur version, ajoutée à leur adresse, empêche un
// navigateur de mêler un ancien fond au nouveau script (src/lib/clanmap/version.ts).
const version = versionDeLaCarte("public/generated/carte");
// La carte de l'alliance a la sienne : son état change chaque heure, le film une fois par jour.
const versionEtat = versionDeLaCarte("public/generated/carte", FICHIERS_DE_L_ETAT);
const fichier = (nom: string) => adresseVersionnee(assets, nom, version);
const ordinal = (n: number) => `${n}${n === 1 ? "er" : "e"}`;
const signed = (n: number) => `${n > 0 ? "+" : n < 0 ? "−" : ""}${fmtInt(Math.abs(n))}`;
const rgb = (color: number | null) => `rgb(${clanRgb(color).join(" ")})`;
const stillHeight = film ? Math.round((1400 * film.rows) / film.cols) : 0;
const landShare = film ? (film.claimed / film.land) * 100 : 0;
const clansOnMap = film?.frames.at(-1)?.clans ?? 0;
const standings = film?.standings ?? [];
const lead = standings[0]?.pixels ?? 1;
const galLine = gal ? (gal.rank === null ? `[${clan.tag}] n'a plus de pixel sur la carte.` : `GAL : ${ordinal(gal.rank)} avec ${fmtInt(gal.pixels)} pixels.`) : "GAL n'est pas sur la carte.";
const moments = film ? findMoments(film.frames) : [];

// Les vraies dates : absentes d'un film d'avant leur collecte, qui se refait au passage suivant.
const lastAt = film?.frames.at(-1)?.at;
const days = film ? dayRows(film.days ?? [], film.frames, film.fetchedAt) : [];
const recentDays = [...days].reverse();
// Seule la plus belle journée est mise en avant : le plus dur recul reste dans les grands moments et dans le tableau jour après jour.
const { gain: bestDay } = dayHighlights(days);
const dayLabel = (day: DayRow) => `Le ${fmtDay(day.date)} : ${signed(day.net)} pixels`;
const dayReplay = (day: DayRow) => ({ "data-film-day": day.start, "data-film-day-end": day.frame, "data-film-day-label": dayLabel(day) });
const dayCards = bestDay ? [{ row: bestDay, title: "Le jour où GAL a le plus progressé" }] : [];
// La dernière journée terminée se rejoue d'un clic : un nouveau mini-film chaque jour.
const lastDay = [...days].reverse().find((d) => d.complete) ?? null;
const threshold = gal ? nextThreshold(gal.pixels) : null;
// Le relevé que le navigateur garde : le film reprend après la dernière image vue.
const visit = loadVisitSnapshot();

// Objectif et réserves : uniquement des chiffres collectés, et un calcul documenté.
const objective = objectiveFor(standings, clan.tag);
const treasury = film?.treasury ?? null;
const troopPixels = treasury?.troops === null || treasury?.troops === undefined ? null : neutralPixelsFor(treasury.troops);
const capPixels = treasury?.caps === null || treasury?.caps === undefined ? null : neutralPixelsFor(capsToTroops(treasury.caps));
const reservePixels = troopPixels === null && capPixels === null ? null : (troopPixels ?? 0) + (capPixels ?? 0);
const goalProgress = objective?.above ? Math.min(100, (objective.me.pixels / objective.above.pixels) * 100) : null;
const troopsText = treasury?.troops === null || treasury?.troops === undefined ? "pas de données" : fmtInt(treasury.troops);
const capsText = treasury?.caps === null || treasury?.caps === undefined ? "pas de données" : fmtInt(treasury.caps);
// Avec une seule des deux valeurs, le total n'est qu'un minimum : il peut dire « assez », jamais « il en manque ».
const reserveComplete = troopPixels !== null && capPixels !== null;
const reserveGoal =
  reservePixels === null || !objective || objective.gap === null
    ? null
    : reservePixels >= objective.gap
      ? "Assez pour atteindre l'objectif."
      : reserveComplete
        ? `Il en manque ${fmtInt(objective.gap - reservePixels)} pour l'objectif.`
        : null;

const journal = loadClanMapJournal();
const today = journal.at(-1);
const previousDay = journal.at(-2);
// Depuis la dernière journée terminée, comme le tableau jour après jour. Le journal ne sert qu'aux films sans dates.
const sinceDay = gal ? changeSinceLastDay(days, gal.pixels) : null;
// Le chiffre en gros, puis ce qu'il compte (fenêtre « Objectif »).
const sinceParts =
  sinceDay
    ? { chiffre: signed(sinceDay.change), suite: `pixels depuis la fin du ${fmtDay(sinceDay.date).replace(/\.$/, "")}` }
    : today && previousDay
      ? { chiffre: signed(today.pixels - previousDay.pixels), suite: `pixels depuis le ${fmtDay(previousDay.date).replace(/\.$/, "")}` }
      : null;

// Tous les clans de la carte, du plus grand territoire au plus petit, comme sur la carte officielle. L'index du clan dans
// le film le retrouve sur la carte : un clan supprimé, sans tag, ou un tag porté par deux clans n'a pas de bouton.
const clanIndex = indexDesClans(film?.clans ?? []);
const clanRows = standings.map((s, i) => ({ ...s, rank: i + 1, index: s.tag === null ? null : (clanIndex.get(s.tag) ?? null) }));

// La console : une fenêtre n'existe, avec son entrée dans la rangée du bas, que si elle a quelque chose à montrer.
const presentes = new Set<FenetreId>(["clans", "reglages"]);
// La carte de l'alliance n'existe qu'avec la connexion du site (Supabase) : sans elle, le site reste entièrement statique.
const allianceOn = AUTH_ENABLED && film !== null;
if (allianceOn) presentes.add("alliance");
if (gal) presentes.add("objectif").add("chiffres");
if (moments.length > 0) presentes.add("moments");
if (days.length > 0) presentes.add("journees");
if (gal && gal.zones.length > 0) presentes.add("zones");
if (gal && gal.fronts.length > 0) presentes.add("fronts");
const dock = FENETRES.filter((f) => presentes.has(f.id));
---

{/* La carte, le classement en colonne (docs/DESIGN.md) : la carte à gauche, la fenêtre ouverte et le classement dans la
    colonne de droite, les entrées en rail sur la carte, le film dans une pastille posée en bas, dans les codes des autres
    pages du site (bleu de la page, onglets, chiffres clés, tableaux). Plus de style Terminal. */}
<Base title="Carte" description="Le territoire du clan GAL sur la carte officielle des clans d'OpenFront, rejoué du premier pixel au dernier, et l'objectif du moment.">
  {
    !film ? (
      <div class="wrap pt-12">
        <Invite path="/carte" />
        <h1 class="page-title">La carte des clans</h1>
        <div class="mt-4">
          <DataStatus state={meta.clanmap} maxAgeHours={MAX_AGE_HOURS.clanmap} />
        </div>
        <div class="mt-6">
          <Empty title="Pas de données">La carte n'a pas encore été collectée.</Empty>
        </div>
      </div>
    ) : (
      <section class="carte" data-carte data-film data-assets={assets} data-version={version ?? undefined} data-version-etat={versionEtat ?? undefined} data-visit={visit ? JSON.stringify(visit) : undefined} aria-labelledby="map-page-title" style='--console-hote: "carte"'>
        {/* Avant le premier affichage : la page tient dans l'écran, tout se passe sur la carte. Si le script de la page
            n'arrive pas, elle redevient une page ordinaire, qui défile, avec toutes ses fenêtres l'une sous l'autre. */}
        <script is:inline>
          document.documentElement.classList.add("carte-console");
          setTimeout(function () {
            if (!document.documentElement.hasAttribute("data-carte-prete")) document.documentElement.classList.remove("carte-console");
          }, 6000);
        </script>

        {/* L'écran : la carte, et ce qui se pose dessus. */}
        <div class="carte-ecran">
          <div class="carte-session">
            {/* La ligne de toutes les pages du site, au-dessus du titre : le filet bleu, blanc, rouge et l'invite. */}
            <div class="page-tete-ligne">
              <span class="tribar" />
              <Invite path="/carte" />
            </div>
            <h1 id="map-page-title">La carte des clans</h1>
            <DataStatus state={meta.clanmap} maxAgeHours={MAX_AGE_HOURS.clanmap} />
          </div>

          {/* La carte se manie aussi au clavier, une fois choisie : c'est un groupe, que le film rend atteignable au clavier
              et décrit par la ligne d'aide placée après lui. Sans le film, il n'y a rien à manier. */}
          <div class="film-map" data-film-map data-testid="film-map" role="group" aria-label="Carte des territoires">
            <img
              src={fichier("finale-1400.webp")}
              srcset={`${fichier("finale-800.webp")} 800w, ${fichier("finale-1400.webp")} 1400w`}
              sizes="100vw"
              width="1400"
              height={stillHeight}
              alt={`La carte officielle des clans à la fin de l'historique. ${galLine}`}
            />
            <canvas data-film-canvas hidden role="img" aria-label="Carte animée des territoires de clans. Les mêmes chiffres sont donnés en texte dans les fenêtres de la page."></canvas>
            {/* Décoratifs : la bande de lumière qui passe une fois à l'ouverture, et la mire, deux traits qui suivent la souris. */}
            <span class="carte-balayage" aria-hidden="true"></span>
            <span class="carte-mire" data-film-mire hidden aria-hidden="true"><i></i><i></i></span>
            <div class="carte-outils" data-film-ready hidden>
              <button type="button" class="carte-touche" data-film-zoom="1" aria-label="Zoomer sur la carte"><span aria-hidden="true">+</span></button>
              <button type="button" class="carte-touche" data-film-zoom="-1" aria-label="Dézoomer la carte"><span aria-hidden="true">−</span></button>
              <button type="button" class="carte-touche carte-touche-large" data-film-world hidden>
                <IconePartie nom="tour" />
                Vue d'ensemble
              </button>
            </div>
            <p class="film-caption" data-film-caption hidden aria-hidden="true"></p>
            <div class="film-tip" data-film-tip hidden aria-hidden="true"></div>
            {/* Le crédit de la carte, toujours sous les yeux, comme sur toute carte en ligne : il mène aux crédits des
                mentions légales, qui donnent la source, la licence et ce que le site a changé au fond de carte. La console
                n'a pas de bas de page : sur un écran large, le code source et les mentions légales, que l'AGPL et la loi
                veulent sur chaque page, sont sur la ligne au-dessus ; sur téléphone, au bout de la fenêtre ouverte. */}
            <p class="carte-credit" data-testid="map-credit">
              <span class="carte-credit-liens">
                <a href={clan.links.source} rel="noopener">Code source</a>
                <span aria-hidden="true">·</span>
                <a href={`${base}/mentions-legales`}>Mentions légales</a>
              </span>
              <span><a class="carte-credit-mention" href={`${base}/mentions-legales#credits`}>© OpenFront and Contributors · CC BY-SA 4.0</a></span>
            </p>
            {/* La carte de l'alliance, à la place du film quand sa fenêtre est ouverte (src/scripts/alliance-ecran.ts) : la
                carte complète au dernier relevé, pixel par pixel, ses zones à prendre et, au passage de la souris, une bulle
                qui dit tout de la zone survolée, avec la légende des couleurs (le calque, rendu par AllianceApp.tsx). Les
                mêmes chiffres sont écrits dans la fenêtre. Ses textes suivent la langue choisie dans la fenêtre. */}
            {
              allianceOn && (
                <>
                  <canvas data-alliance-canvas data-testid="alliance-canvas" hidden role="img" aria-label="Carte de l'alliance : les territoires des clans et les zones à prendre, chacun dans sa couleur. Les mêmes chiffres sont écrits dans la fenêtre Alliance." aria-describedby="carte-clavier"></canvas>
                  <div class="carte-outils alliance-outils" data-alliance-outils>
                    <button type="button" class="carte-touche" data-alliance-zoom="1" aria-label="Zoomer sur la carte de l'alliance"><span aria-hidden="true">+</span></button>
                    <button type="button" class="carte-touche" data-alliance-zoom="-1" aria-label="Dézoomer la carte de l'alliance"><span aria-hidden="true">−</span></button>
                    <button type="button" class="carte-touche carte-touche-large" data-alliance-monde>
                      <IconePartie nom="tour" />
                      <span data-alliance-monde-texte>Vue d'ensemble</span>
                    </button>
                    {/* La capture de la carte telle qu'elle est cadrée, avec le logo de GAL, à envoyer sur Discord : ouvre
                        l'onglet « Capture » de la fenêtre et la prend aussitôt (AllianceCapture.tsx). */}
                    <button type="button" class="carte-touche carte-touche-large" data-alliance-capture data-testid="alliance-capture-carte">
                      <IconePartie nom="oeil" />
                      <span data-alliance-capture-texte>Capture</span>
                    </button>
                  </div>
                  <div class="alliance-calque" aria-hidden="true" data-alliance-calque></div>
                </>
              )
            }
          </div>
          {/* Cachée : elle n'est lue que comme description de la carte, une fois que le film l'a rendue maniable. */}
          <p id="carte-clavier" hidden>Au clavier : les flèches déplacent la carte, plus et moins changent le zoom, zéro revient à la vue d'ensemble.</p>

          <div class="carte-alerte" role="status" data-film-message hidden>
            <span data-film-message-text></span>
            <button type="button" class="btn btn-ghost !min-h-10 !py-1.5" data-film-retry>Réessayer</button>
          </div>
        </div>

        {/* La lecture du film : sur un écran large, une pastille posée en bas de la carte ; sous la carte sur téléphone. La
            date de l'image affichée est au bout de la frise ; les réglages s'ouvrent dans leur fenêtre. */}
        <div class="carte-transport" data-film-ready hidden>
          <button type="button" class="btn btn-primary film-play" data-film-play data-testid="film-play">
            <svg viewBox="0 0 14 14" width="14" height="14" fill="currentColor" aria-hidden="true"><path data-film-play-icon d="M2 1l11 6-11 6z"></path></svg>
            <span data-film-play-label>Lancer le film</span>
          </button>
          <div class="film-scrub">
            <svg data-film-curve preserveAspectRatio="none" aria-hidden="true" style={{ "--gal": rgb(film.gal === null ? null : (film.clans[film.gal]?.color ?? null)) }}><path></path></svg>
            <span class="film-ticks" data-film-ticks aria-hidden="true"></span>
            <input type="range" min="0" value="0" step="1" data-film-pos data-testid="film-pos" aria-label="Position dans le film" />
            <span class="film-dates tnum" data-film-dates data-testid="film-dates" aria-hidden="true"></span>
          </div>
          {/* La date de l'image affichée, le numéro de l'événement et, au passage de la souris, la position sur la carte : le
              curseur de la frise dit déjà tout cela aux lecteurs d'écran. */}
          <p class="film-hud tnum" aria-hidden="true">
            <strong class="film-hud-date" data-film-date data-testid="film-date" hidden></strong>
            <span class="film-hud-evenement">Événement <span data-film-event></span></span>
            <span class="film-hud-coords" data-film-coords hidden></span>
          </p>
          <a href="#reglages" class="carte-transport-reglages" data-ouvre="reglages" aria-label="Réglages du film">
            <IconePartie nom="roue" />
          </a>
        </div>

        {/* Le rail des entrées : une par fenêtre, sur la carte (sous la carte, en rangée, sur téléphone). Des liens : sans
            script, ils mènent à la partie de la page. */}
        <nav class="carte-dock" aria-label="Fenêtres de la carte" data-testid="carte-dock">
          <ul>
            {dock.map((f) => (
              <li data-film-ready={"film" in f && f.film ? "" : undefined} hidden={"film" in f && f.film} data-console-seulement={f.id === "alliance" ? "" : undefined}>
                <a href={`#${f.id}`} class="carte-dock-entree" data-ouvre={f.id}>
                  <IconePartie nom={f.icon} />
                  <span>{f.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>

        {/* Les fenêtres : la colonne de droite sur un écran large, sous la carte sur téléphone. La fenêtre ouverte en haut, le
            classement du film dessous (il suit chaque image du film), sauf avec les clans, qui le donnent en entier. */}
        <div class="carte-panneaux" data-carte-panneaux>
          <aside class="carte-fenetre carte-podium" aria-labelledby="ladder-title">
            <div class="carte-fenetre-corps">
              <h2 id="ladder-title">Le territoire à cet instant</h2>
              <ol class="film-rows tnum" data-film-rows>
                {
                  standings.slice(0, TOP_SIZE).map((c, i) => (
                    <li class:list={["film-row", c.tag === clan.tag && "is-gal"]} style={{ "--rang": i }}>
                      <span class="film-row-rank">{i + 1}</span>
                      <span class="truncate font-semibold">{c.tag ?? "Clan supprimé"}</span>
                      <span>{fmtInt(c.pixels)}</span>
                      <span class="film-bar"><i style={{ width: `${(c.pixels / lead) * 100}%`, background: rgb(c.color) }}></i></span>
                    </li>
                  ))
                }
              </ol>
              <p class="tnum carte-podium-gal" data-film-pinned data-testid="film-gal">{galLine}</p>
              <p class="carte-podium-note">Pixels peints sur la carte, pas le classement des clans.</p>
              <p class="tnum carte-podium-mesure"><span data-film-land>{fmtDec1(landShare)}</span> % des terres · <span data-film-clans>{fmtInt(clansOnMap)}</span> clans</p>
            </div>
          </aside>

          {
            gal && (
              <Fenetre id="objectif" testid="map-goal">
                <Fragment slot="titre">
                  {objective ? (objective.above && objective.gap !== null ? <>Prochain objectif&nbsp;: dépasser {objective.above.tag ?? "le clan suivant"}</> : "GAL occupe le plus grand territoire") : "GAL sur la carte"}
                </Fragment>
                {/* Le film peut montrer un autre jour à côté : cette fenêtre dit de quand sont ses chiffres. */}
                {objective && <p class="carte-sur">{ordinal(objective.rank)} sur la carte, au dernier relevé</p>}
                {objective ? (
                  objective.above && objective.gap !== null ? (
                    <>
                      {/* Le duel : GAL face au clan à dépasser, chacun dans sa couleur de la carte, la corde entre les deux. */}
                      <div class="carte-duel tnum">
                        <p class="carte-camp">
                          <span class="carte-camp-tag"><i style={{ background: rgb(objective.me.color) }}></i>{objective.me.tag}</span>
                          <span class="carte-camp-px"><span data-testid="map-pixels">{fmtInt(objective.me.pixels)}</span> <small>{ordinal(objective.rank)}</small></span>
                        </p>
                        <span class="carte-contre">contre</span>
                        <p class="carte-camp carte-camp-face">
                          <span class="carte-camp-tag">{objective.above.tag ?? "Clan supprimé"}<i style={{ background: rgb(objective.above.color) }}></i></span>
                          <span class="carte-camp-px"><small>{ordinal(objective.rank - 1)}</small> {fmtInt(objective.above.pixels)}</span>
                        </p>
                      </div>
                      <div class="carte-corde" aria-hidden="true" style={{ "--gal": rgb(objective.me.color), "--face": rgb(objective.above.color), "--v": `${goalProgress}%` }}><i></i></div>
                      <div class="carte-manque">
                        <p class="tnum carte-chiffre" data-testid="map-gap" data-count={objective.gap}>{fmtInt(objective.gap)}</p>
                        <p class="carte-suite">pixels à gagner pour passer {ordinal(objective.rank - 1)}.</p>
                      </div>
                    </>
                  ) : (
                    <p class="tnum carte-suite"><span data-testid="map-pixels">{fmtInt(objective.me.pixels)}</span> pixels.</p>
                  )
                ) : (
                  <p class="tnum carte-suite"><span data-testid="map-pixels">{fmtInt(gal.pixels)}</span> pixels{gal.rank === null && " : plus aucun sur la carte"}.</p>
                )}
                {/* Territoire et place ne sont écrits qu'ici, et dans le classement : « Chiffres » ne les répète pas. Chaque
                    repère : le chiffre en gros, puis ce qu'il compte. */}
                {(sinceParts || (objective?.below && objective.lead !== null) || threshold) && (
                  <ul class="carte-trois tnum">
                    {sinceParts && (
                      <li data-testid="map-journal">
                        <b>{sinceParts.chiffre}</b> {sinceParts.suite}
                      </li>
                    )}
                    {objective?.below && objective.lead !== null && (
                      <li>
                        <b>{fmtInt(objective.lead)}</b> pixels d'avance sur {objective.below.tag ?? "le clan suivant"}, {ordinal(objective.rank + 1)}
                      </li>
                    )}
                    {threshold && (
                      <li data-testid="map-next-threshold">
                        <b>{fmtInt(threshold.remaining)}</b> pixels avant le palier de {fmtInt(threshold.threshold)}
                      </li>
                    )}
                  </ul>
                )}
              </Fenetre>
            )
          }

          <Fenetre id="clans">
            <Fragment slot="titre">{fmtInt(standings.length)} clans sur la carte</Fragment>
            <div class="carte-table-cadre">
              <table class="data-table carte-table film-fronts tnum" data-testid="map-clans">
                <caption>
                  {/* Sous 640 px de haut, le podium perd sa note : ce tableau la redit. */}
                  Le territoire de chaque clan au dernier relevé{lastAt !== undefined && `, le ${fmtEpochHour(lastAt)}`}, du plus grand au plus petit : des pixels peints, pas le classement des clans.
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Rang</th>
                    <th scope="col">Clan</th>
                    <th scope="col" class="num">Pixels</th>
                  </tr>
                </thead>
                <tbody>
                  {clanRows.map((c) => (
                    <tr class:list={[c.tag === clan.tag && "est-gal"]}>
                      <td>{c.rank}</td>
                      <td class="font-semibold">
                        <span class="carte-pastille" style={{ background: rgb(c.color) }} aria-hidden="true"></span>
                        {c.index === null ? (
                          (c.tag ?? "Clan supprimé")
                        ) : (
                          <button type="button" class="film-front-link" data-film-clan={c.index} aria-label={`Voir ${c.tag} sur la carte`}>{c.tag}</button>
                        )}
                      </td>
                      <td class="num">{fmtInt(c.pixels)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="carte-aide" data-film-ready hidden>Un clic sur un clan le montre sur la carte.</p>
            {/* Le seul lien de la page vers la carte « World », depuis le retrait de la fenêtre « Légende ». */}
            <p class="carte-aide"><a href={`${base}/carte-monde/`}>La carte « World »</a> reporte la part des terres de GAL sur la carte du monde du jeu.</p>
          </Fenetre>

          {/* La carte de l'alliance (13 novembre 2026) : la porte pour tous, puis, pour les Gaulois validés et les alliés
              invités, ce que le serveur leur donne. Seulement avec la connexion du site : sans elle, le site reste statique. */}
          {
            allianceOn && (
              <Fenetre id="alliance" class="alliance-fenetre" consoleSeulement libre testid="map-alliance">
                <Fragment slot="titre">La carte de l'alliance</Fragment>
                <AllianceApp client:only="preact" />
              </Fenetre>
            )
          }

          {
            moments.length > 0 && (
              <Fenetre id="moments" film>
                <Fragment slot="titre">Les grands moments</Fragment>
                <ol class="carte-liste" data-testid="map-moments">
                  {moments.map((m) => (
                    <li>
                      <button type="button" class="film-tile" data-film-moment={m.frame} data-recul={m.kind === "fall" || m.kind === "loss" ? "" : undefined}>
                        <span class="tnum carte-date">{m.at === null ? "" : fmtEpochDay(m.at)}</span>
                        {/* Le repère du moment sur la frise du film, repris ici : blanc, rouge pour un recul. */}
                        <i class="carte-repere" aria-hidden="true"></i>
                        {/* Le dernier relevé n'a pas besoin de ses chiffres ici : ils sont dans le podium. Le film les garde dans sa légende. */}
                        <span class="font-semibold">{m.kind === "now" ? "Dernier relevé" : m.title}</span>
                      </button>
                    </li>
                  ))}
                </ol>
              </Fenetre>
            )
          }

          {
            days.length > 0 && (
              <Fenetre id="journees">
                <Fragment slot="titre">Jour après jour</Fragment>
                {dayCards.length > 0 && (
                  <div class="carte-bloc carte-cle" data-testid="map-days">
                    <h3>La plus belle journée</h3>
                    {dayCards.map(({ row, title }) => (
                      <div data-testid="map-day">
                        <p class="carte-cle-libelle">{title}</p>
                        <p class="tnum carte-chiffre carte-chiffre-sm">{signed(row.net)} pixels</p>
                        <p class="tnum carte-cle-suite">Le {fmtDay(row.date)} : {fmtInt(row.taken)} pris, {fmtInt(row.lost)} perdus.</p>
                        <div class="carte-cle-action" data-film-ready hidden>
                          <button type="button" class="btn btn-ghost !min-h-10 !py-1.5" {...dayReplay(row)} aria-label={`Revoir cette journée, le ${fmtDay(row.date)}`}>Revoir cette journée</button>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
                <div class="carte-bloc carte-courbe">
                  <TerritoryChart client:visible points={territorySeries(days)} />
                </div>
                <div class="carte-table-cadre">
                  <table class="data-table carte-table film-fronts tnum" data-testid="film-days">
                    <caption>Les journées de GAL sur la carte depuis son premier pixel, la plus récente d'abord, en heure de Paris. Territoire et place à la fin de la journée.</caption>
                    <thead>
                      <tr>
                        <th scope="col">Jour</th>
                        <th scope="col" class="num carte-col-large hidden sm:table-cell">Pris</th>
                        <th scope="col" class="num carte-col-large hidden sm:table-cell">Perdus</th>
                        <th scope="col" class="num">Solde</th>
                        <th scope="col" class="num">Territoire</th>
                        <th scope="col" class="num">Place</th>
                      </tr>
                    </thead>
                    <tbody>
                      {recentDays.map((d) => (
                        <tr>
                          <td class="font-semibold">
                            <button type="button" class="film-front-link" {...dayReplay(d)} aria-label={`Revoir la journée du ${fmtDay(d.date)} sur la carte`}>{fmtDay(d.date)}</button>
                            {!d.complete && lastAt !== undefined && <span class="block font-normal text-muted carte-petit" data-testid="film-day-partial">relevée jusqu'à {fmtEpochTime(lastAt)}</span>}
                          </td>
                          <td class="num carte-col-large hidden sm:table-cell">{fmtInt(d.taken)}</td>
                          <td class="num carte-col-large hidden sm:table-cell">{fmtInt(d.lost)}</td>
                          <td class="num font-semibold">{signed(d.net)}</td>
                          <td class="num">{fmtInt(d.pixels)}</td>
                          <td class="num">{d.rank === null ? "—" : fmtRank(d.rank)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="carte-aide" data-film-ready hidden>Un clic sur un jour le rejoue sur la carte.</p>
              </Fenetre>
            )
          }

          {
            gal && gal.zones.length > 0 && (
              <Fenetre id="zones" film>
                <Fragment slot="titre">Nos territoires</Fragment>
                <p class="tnum carte-sur">Les {fmtInt(gal.zones.length)} plus grandes, sur {fmtInt(gal.zoneCount)} zones d'un seul tenant.</p>
                <ul class="carte-liste carte-liste-zones">
                  {gal.zones.map((z, i) => (
                    <li>
                      <button type="button" class="film-tile" data-film-look={`Zone ${i + 1} : ${fmtInt(z.pixels)} pixels`} data-x={z.x} data-y={z.y} data-half-width={z.halfWidth} data-half-height={z.halfHeight}>
                        {/* Le nom lu reprend le texte visible, avec une pause entre le numéro et les pixels. */}
                        <span class="carte-date">Zone {i + 1}<span class="sr-only"> :</span></span>
                        <span class="tnum font-semibold">{fmtInt(z.pixels)} pixels</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </Fenetre>
            )
          }

          {
            gal && gal.fronts.length > 0 && (
              <Fenetre id="fronts">
                <Fragment slot="titre">Les fronts de GAL</Fragment>
                <div class="carte-table-cadre">
                  <table class="data-table carte-table film-fronts tnum" data-testid="film-fronts">
                    <caption>Les {gal.fronts.length} clans avec lesquels GAL a échangé le plus de pixels, hors terres neutres.</caption>
                    <thead>
                      <tr>
                        <th scope="col">Clan</th>
                        <th scope="col" class="num">Pris</th>
                        <th scope="col" class="num">Perdus</th>
                        <th scope="col" class="num">Solde</th>
                        <th scope="col" class="num">Frontière</th>
                      </tr>
                    </thead>
                    <tbody>
                      {gal.fronts.map((f) => (
                        <tr>
                          <td class="font-semibold">
                            {f.at ? (
                              <button
                                type="button"
                                class="film-front-link"
                                data-film-look={`Front ${f.tag ?? "Clan supprimé"} : ${fmtInt(f.border)} pixels de frontière`}
                                data-x={f.at[0]}
                                data-y={f.at[1]}
                                data-half-width="200"
                                data-half-height="130"
                                data-clan={f.clan}
                                aria-label={`Voir le front avec ${f.tag ?? "ce clan"} sur la carte`}
                              >
                                {f.tag ?? "Clan supprimé"}
                              </button>
                            ) : (
                              (f.tag ?? "Clan supprimé")
                            )}
                          </td>
                          <td class="num">{fmtInt(f.taken)}</td>
                          <td class="num">{fmtInt(f.lost)}</td>
                          <td class="num font-semibold">{signed(f.taken - f.lost)}</td>
                          <td class="num">{f.border > 0 ? fmtInt(f.border) : "—"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="carte-aide">Un clic sur un clan montre ce front sur la carte.</p>
              </Fenetre>
            )
          }

          {
            gal && (
              <Fenetre id="chiffres">
                <Fragment slot="titre">GAL en chiffres</Fragment>
                <dl class="tnum carte-chiffres">
                  <div data-testid="map-figure">
                    <dt>Plus grand territoire</dt>
                    <dd class="carte-chiffre carte-chiffre-sm" data-testid="map-peak">{fmtInt(gal.peak.pixels)} pixels</dd>
                    {gal.peak.pixels === gal.pixels ? (
                      <dd class="text-muted">C'est son territoire actuel.</dd>
                    ) : (
                      gal.peak.at !== undefined && <dd class="text-muted">Atteint le {endingOn(parisDayOf(gal.peak.at))}</dd>
                    )}
                  </div>
                  <div data-testid="map-figure">
                    <dt>Pris et perdus</dt>
                    <dd class="carte-chiffre carte-chiffre-sm">+{fmtInt(gal.taken)} / −{fmtInt(gal.lost)}</dd>
                    <dd class="text-muted">Dont {fmtInt(gal.neutralTaken)} pixels pris sur des terres neutres.</dd>
                  </div>
                  <div data-testid="map-figure">
                    <dt>Premier pixel</dt>
                    <dd class="carte-chiffre carte-chiffre-sm" data-testid="map-first">{gal.firstAt === undefined ? `Événement n° ${fmtInt(gal.firstEvent)}` : fmtDate(new Date(gal.firstAt * 1000).toISOString())}</dd>
                    <dd class="text-muted">{gal.firstAt !== undefined && `Événement n° ${fmtInt(gal.firstEvent)}, sur `}{gal.firstAt === undefined && "Sur "}{fmtInt(film.events)} changements de main au total.</dd>
                  </div>
                  {/* La fiche du clan ne répond pas toujours à la collecte : sans chiffre, pas de case vide, mais une ligne sous les chiffres le dit. */}
                  {reservePixels !== null && (
                    <div data-testid="map-figure">
                      <dt>Réserves du clan</dt>
                      <dd class="carte-chiffre carte-chiffre-sm">{reserveComplete ? "Environ" : "Au moins"} {fmtInt(reservePixels)} pixels neutres</dd>
                      <dd class="text-muted" data-testid="map-reserves">Troupes prêtes : {troopsText}. Capsules au trésor : {capsText}.</dd>
                      {reserveGoal && <dd class="font-semibold">{reserveGoal}</dd>}
                    </div>
                  )}
                </dl>
                <div class="carte-notes">
                {gal.neutralBorder !== null && <p class="tnum" data-testid="map-neutral-border">{fmtInt(gal.neutralBorder)} pixels de terre neutre touchent déjà notre territoire.</p>}
                {reservePixels === null && <p data-testid="map-no-reserves">Réserves du clan : pas de données.</p>}
                {
                  (reservePixels !== null || gal.neutralBorder !== null) && (
                    <p class="carte-petit">
                      {reservePixels === null ? "Repère indicatif" : "Repères indicatifs"}, selon les règles du jeu lues le {fmtDate(`${RULES_CHECKED_ON}T12:00:00Z`)}
                      {reservePixels !== null && ` : une capsule vaut ${fmtInt(TROOPS_PER_CAP)} troupes, un pixel neutre en coûte ${fmtInt(NEUTRAL_PIXEL_TROOPS)}`}.
                    </p>
                  )
                }
                </div>
              </Fenetre>
            )
          }

          {/* Les réglages du film, ouverts depuis le rail ou le bouton rond au bout de la pastille du film. */}
          <Fenetre id="reglages" film>
            <Fragment slot="titre">Réglages du film</Fragment>
            <div class="carte-reglages-corps">
              {lastDay && (
                <div class="carte-reglage">
                  <button type="button" class="btn btn-ghost" {...dayReplay(lastDay)} data-testid="film-last-day" aria-label={`Revoir le ${fmtDay(lastDay.date)}, la dernière journée terminée`}>
                    Revoir le {fmtDay(lastDay.date)}
                  </button>
                </div>
              )}
              <div class="film-speed carte-reglage">
                <label for="film-speed">Vitesse</label>
                <input
                  id="film-speed"
                  class="film-range"
                  type="range"
                  min={SPEED_MIN}
                  max={SPEED_MAX}
                  step={SPEED_STEP}
                  value={SPEED_MAX}
                  aria-valuetext={speedText(SPEED_MAX)}
                  data-film-speed
                  data-testid="film-speed"
                />
                {/* La valeur écrite pour les yeux ; le curseur la donne déjà aux lecteurs d'écran. */}
                <output for="film-speed" class="tnum" aria-hidden="true" data-film-speed-value>{speedLabel(SPEED_MAX)}</output>
              </div>
              <div class="carte-reglage">
                <button type="button" class="chip" data-film-focus aria-pressed="false">Griser les autres</button>
              </div>
            </div>
          </Fenetre>

          {/* Le bas de la console quand tout s'empile (téléphone) : au bout de la fenêtre ouverte, comme le bas d'une page.
              Sur un écran large, le crédit posé sur la carte en tient lieu ; sans script, le pied de page du site est là. */}
          <p class="carte-pied" data-console-seulement data-testid="carte-pied">
            {SITE_DISCLAIMER} {SITE_LICENSE_NOTICE} <a href={clan.links.source} rel="noopener">Code source</a> · <a href={`${base}/mentions-legales`}>Mentions légales</a>
          </p>
        </div>

        <p class="sr-only" role="status" data-film-status></p>
      </section>
    )
  }
</Base>

<script>
  import "../scripts/carte-console";
  import "../scripts/film";
</script>
