---
import Base from "../layouts/Base.astro";
import Empty from "../components/Empty.astro";
import GauloisPortrait from "../components/GauloisPortrait.astro";
import MapNamesCredit from "../components/MapNamesCredit.astro";
import PageHeader from "../components/PageHeader.astro";
import ReadingNote from "../components/ReadingNote.astro";
import RejeuPartie from "../components/RejeuPartie.tsx";
import { loadFilms, loadMembers, loadRecordsPersonnels, loadSeriesEnCours } from "../lib/data";
import { FLAMME, FLAMME_DOREE } from "../lib/flamme-serie";
import { fmtDayAndTime, fmtInt } from "../lib/format";
import { gauloisDeLaPartie, gauloisDuSite, portraitDuGaulois } from "../lib/gaulois-site";
import { tenueOf } from "../lib/gaulois-sprite";
import { mapLabel } from "../lib/map-names";
import { JOURS_DE_FILMS } from "../lib/rejeu/films-index";
import { insignesParPseudo, porteursDesPseudos, type Insignes } from "../lib/rejeu/insignes";
import type { Decor } from "../lib/village/decor";
import { formatLabel } from "../lib/results";
import { rareteDuCadre } from "../lib/village/vitrine";

/** Les parties listées sous le lecteur ; les autres s'ouvrent depuis « Dernières parties ». */
const LISTES = 12;
/** Les Gaulois montrés sur la case d'une partie ; les autres sont comptés à la suite. */
const GAULOIS_PAR_CASE = 6;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const liste = loadFilms();
// Le replay seul (demande du pilote, 16 novembre 2026 : « je veux plus de film mais uniquement le replay ») : seules les parties
// qui ont le vrai lecteur du jeu sont proposées.
const parties = (liste?.films ?? []).filter((f) => f.jeu);
// Les membres au pseudo public de chaque partie listée qui ont créé leur Gaulois (src/lib/gaulois-site.ts).
const gaulois = new Map(parties.slice(0, LISTES).flatMap((f) => { const presents = gauloisDeLaPartie(f.partie); return presents.length > 0 ? [[f.partie, presents] as const] : []; }));
// Ce que le lecteur reçoit, écrit dans la page au build : pas de fichier lu au chargement, que le cache de GitHub Pages pourrait
// servir en retard. Les parties rejouées sans replay prêt sont seulement nommées, pour le dire.
const pourLeLecteur = parties.map(({ partie, debut, carte, victoire, equipes, gaulois, joueurs, secondes, forme, jeu, faits, bilan }) => ({ partie, debut, carte, victoire, equipes, gaulois, joueurs, secondes, forme, jeu: jeu!, faits, bilan }));
// Le journal « Entre Gaulois » (src/lib/rejeu/journal.ts) nomme les membres par leur pseudo public : le Gaulois de chacun, par
// pseudo, s'il a créé le sien. Un pseudo porté par deux membres ne désigne personne : pas de Gaulois.
// Sa case prend la couleur de la rareté la plus haute de ce qu'il porte, comme sa carte de la vitrine (`rareteDuCadre`).
const portraits: Record<string, { image: string; largeur: number; hauteur: number; buste: number; rarete: string | null }> = {};
let insignes: Record<string, Insignes> = {};
if (parties.some((f) => (f.faits ?? 0) > 0 || f.bilan)) {
  const membres = loadMembers()?.members ?? [];
  for (const [pseudo, ids] of porteursDesPseudos(membres)) {
    const portrait = ids.length === 1 ? portraitDuGaulois(ids[0]) : null;
    const tenue = portrait ? tenueOf(gauloisDuSite(), ids[0]) : null;
    if (portrait) portraits[pseudo] = { ...portrait, image: `${base}${portrait.image}`, rarete: tenue ? rareteDuCadre(tenue) : null };
  }
  // À côté du nom (demande du pilote, 17 novembre 2026) : le niveau et le prestige du compte, « tout le jeu », tels que la liste
  // du clan les donne aujourd'hui, et la flamme de la série en cours, à partir de 5 victoires d'affilée (`serie-en-cours.ts`).
  // Ceux d'aujourd'hui, pas ceux du jour de la partie : l'écran et la note de lecture le disent (`src/lib/rejeu/insignes.ts`).
  insignes = insignesParPseudo(membres, loadSeriesEnCours(), loadRecordsPersonnels());
}
/** Une flamme en image, case pour case (`flamme-serie.ts`), pour les lignes du fil : un SVG dans une adresse `data:`. */
const flammeEnImage = ({ largeur, hauteur, cases }: Decor) => {
  let rects = "";
  for (let y = 0; y < hauteur; y++) for (let x = 0; x < largeur; x++) if (cases[y * largeur + x]) rects += `<rect x="${x}" y="${y}" width="1" height="1" fill="${cases[y * largeur + x]}"/>`;
  return { image: `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${largeur} ${hauteur}" shape-rendering="crispEdges">${rects}</svg>`)}`, largeur, hauteur };
};
const flammes = { normale: flammeEnImage(FLAMME), doree: flammeEnImage(FLAMME_DOREE) };
const enAttente = (liste?.films ?? []).filter((f) => !f.jeu).map((f) => f.partie);
const plusAncien = parties.at(-1)?.debut ?? null;
const siteDuLecteur = parties[0]?.jeu ? new URL(parties[0].jeu).origin : null;
---

<Base title="Revoir une partie" description="Les dernières parties du clan GAL dans le lecteur de replay d'OpenFront : qui tenait chaque territoire, du début à la fin.">
  <div class="wrap">
    <PageHeader title="Revoir une partie" intro={plusAncien ? `${parties.length > 1 ? `${fmtInt(parties.length)} parties à revoir` : "1 partie à revoir"}, depuis le ${fmtDayAndTime(plusAncien)}.` : "Les parties du clan, dans le lecteur de replay du jeu."}>
      {liste?.fait && <p class="info-discrete tnum mt-2" data-testid="revoir-date">À jour du {fmtDayAndTime(liste.fait)}.</p>}
    </PageHeader>

    {
      parties.length === 0 ? (
        <Empty title="Pas de replay">Les parties paraissent ici environ une heure après leur fin.</Empty>
      ) : (
        <>
          <RejeuPartie client:idle parties={pourLeLecteur} enAttente={enAttente} jours={JOURS_DE_FILMS} base={base} portraits={portraits} insignes={insignes} flammes={flammes} />
          <noscript>
            <p class="card mt-4 p-4 text-sm text-muted">JavaScript est nécessaire pour voir le replay.</p>
          </noscript>

          <h2 class="section-title-sm mt-section">Dernières parties</h2>
          {/* Le nom du lien est son contenu (résultat, carte, date, format) : pas d'étiquette à part, qui ne dirait pas ce qu'on lit.
              Le résultat d'abord, d'un coup d'œil (filet de couleur et mot), puis la carte en grand. Le lecteur repère la
              partie à l'écran (`data-revoir-partie`, RejeuPartie.tsx). */}
          <ul class="revoir-liste mt-6" data-testid="revoir-liste">
            {parties.slice(0, LISTES).map((f) => (
              <li>
                <a
                  href={`${base}/revoir?partie=${encodeURIComponent(f.partie)}`}
                  class="card tnum"
                  data-revoir-partie={f.partie}
                  data-resultat={f.victoire ? "victoire" : "defaite"}
                >
                  <span class="revoir-liste-tete">
                    <span class="revoir-resultat" data-resultat={f.victoire ? "victoire" : "defaite"}>
                      <i aria-hidden="true" />
                      {f.victoire ? "Victoire" : "Défaite"}
                    </span>
                    <span class="revoir-ici">À l'écran</span>
                  </span>
                  <span class="revoir-liste-carte font-display">{mapLabel(f.carte)}</span>
                  <span class="text-muted">
                    {fmtDayAndTime(f.debut)} · {formatLabel(f.equipes)} · {fmtInt(f.gaulois)} Gaulois
                  </span>
                  {gaulois.has(f.partie) && (
                    <span class="revoir-gaulois" data-testid="revoir-gaulois">
                      {gaulois.get(f.partie)!.slice(0, GAULOIS_PAR_CASE).map((g) => (
                        <span>
                          <GauloisPortrait portrait={g.portrait} />
                          <span>{g.username}</span>
                        </span>
                      ))}
                      {gaulois.get(f.partie)!.length > GAULOIS_PAR_CASE && <span class="revoir-gaulois-reste">et {fmtInt(gaulois.get(f.partie)!.length - GAULOIS_PAR_CASE)} de plus</span>}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
          {parties.length > LISTES && (
            <p class="info-discrete mt-4">
              Les {fmtInt(parties.length - LISTES)} autres s'ouvrent par « Revoir » dans <a class="link" href={`${base}/parties`}>Dernières parties</a>.
            </p>
          )}
          <p class="mt-6">
            <a class="link" href={`${base}/utiles`} data-testid="revoir-utiles">Les Gaulois les plus utiles, en moyenne sur ces parties</a>
          </p>
        </>
      )
    }

    <p class="mt-section max-w-3xl text-sm text-muted" data-testid="revoir-credit">
      Lecteur de replay et moteur du jeu <a class="link" href="https://github.com/openfrontio/OpenFrontIO" rel="noopener">OpenFront</a> (AGPL-3.0), légèrement modifiés, avec ses cartes et ses images : © OpenFront and Contributors, <a class="link" href="https://creativecommons.org/licenses/by-sa/4.0/deed.fr" rel="noopener">CC BY-SA 4.0</a>{siteDuLecteur && <> (<a class="link" href={`${siteDuLecteur}/jeu/LISEZ-MOI.txt`} rel="noopener">notice</a>)</>}.
    </p>
    <MapNamesCredit />
    <ReadingNote label="Comment lire ce replay">
      <p>C'est le lecteur de replay d'OpenFront lui-même, légèrement modifié et construit par le site à partir de son code libre, sur un site du clan à part : sans publicité ni mesure, non officiel, avec tous les pseudos de la partie comme dans le jeu.</p>
      <p>Il part de lui-même en accéléré (× 8), sauf si vous avez demandé moins d'animations (bouton pause en haut de la page, ou réglage de l'appareil). « Ouvrir le replay en grand » l'ouvre dans un onglet ; « Ouvrir la partie sur OpenFront » mène à son propre site.</p>
      <p>« Entre Gaulois » liste ce que le moteur du jeu a noté pendant ce rejeu : les dons réussis entre joueurs au tag du clan, aux montants de l'écran du jeu, puis les éliminations, bombes, cibles, émojis, messages rapides et alliances où un Gaulois est en jeu. Le joueur visé par une bombe est celui qui tenait la case visée au lancement. Un joueur sans pseudo public sur la liste du clan, Gaulois ou non, y porte le pseudo qu'il avait dans la partie, comme dans le replay ; le tag de son clan le précède s'il est au classement officiel. À côté du nom d'un membre au pseudo public : le niveau de son compte, tout le jeu, à la couleur de son prestige, et sa flamme à partir de 5 victoires d'affilée sous le tag, tels qu'ils sont aujourd'hui, pas le jour de la partie. « Bilan des Gaulois » compte, pour chaque joueur au tag du clan, ce que le jeu écrit à la fin de la partie (l'or produit par le travail, le commerce et les trains, les troupes envoyées à l'attaque, les unités et bâtiments ennemis détruits ou pris, les joueurs éliminés) et les dons relevés pendant ce rejeu, à tous ses alliés (le fil « Entre Gaulois » ne liste que ceux entre Gaulois : ses totaux peuvent être plus petits). Un Gaulois sans stats dans la fiche de la partie n'y est pas. Chaque barre est la part du joueur dans le total des Gaulois de la partie : Économie pour l'or produit, Combat pour la moyenne des troupes à l'attaque et des prises, Soutien pour la moyenne des troupes et de l'or donnés. L'utilité est la moyenne de ces parts, 100 étant la part moyenne d'un Gaulois de la partie. La place de départ, les dons reçus et une élimination précoce pèsent sur ce score : il compare les Gaulois d'une même partie, il ne mesure pas le niveau d'un joueur. « Les plus utiles », dans Résultats, en fait la moyenne par membre au pseudo public. Les messages rapides sont les phrases toutes faites du jeu (© OpenFront and Contributors, CC BY-SA 4.0). Le fil suit le replay ; l'heure d'une ligne y mène.</p>
      <p>Une partie arrive ici environ une heure après sa fin, rejouée d'abord par le robot du site avec le moteur du jeu, à la version qui l'a jouée. Seules les plus récentes restent, {JOURS_DE_FILMS} jours au plus.</p>
    </ReadingNote>
  </div>
</Base>
