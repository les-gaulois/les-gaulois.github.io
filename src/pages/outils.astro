---
import Base from "../layouts/Base.astro";
import BotCalculator from "../components/BotCalculator.tsx";
import PageHeader from "../components/PageHeader.astro";
import { loadLinks } from "../lib/data";

const tools = loadLinks().tools;
---

<Base title="Calculateur et outils" description="Le calculateur de troupes à envoyer contre un bot, et les outils de la communauté OpenFront.">
  <div class="wrap">
    <PageHeader title="Calculateur et outils" intro="Un repère pour attaquer les bots, et les sites de la communauté OpenFront." />

    <section class="band scroll-mt-24" aria-labelledby="calc-title" id="calculateur">
      <h2 id="calc-title" class="section-title">Troupes à envoyer contre un bot</h2>
      <p class="mb-6 mt-3 max-w-3xl text-lg text-muted">
        Un repère calculé à partir des règles du jeu. Ce qui pèse le plus est la taille du bot, plus que ses troupes.
      </p>
      <BotCalculator client:load />
    </section>

    <section class="band scroll-mt-24" aria-labelledby="outils" id="outils-section">
      <h2 id="outils" class="section-title">Outils communautaires</h2>
      {
        tools.length === 0 ? (
          <p class="mt-5 border-y border-line py-5 text-muted">Aucun outil répertorié pour le moment.</p>
        ) : (
          <ul class="mt-6 divide-y divide-line border-y border-line">
            {tools.map((t) => (
              <li class="grid gap-1 py-4 sm:grid-cols-[16rem_1fr] sm:gap-8">
                <a href={t.url} rel="noopener" class="link text-lg">{t.name}</a>
                <span class="text-muted">{t.description}</span>
              </li>
            ))}
          </ul>
        )
      }
      <p class="mt-3 text-sm text-muted">Sites tiers, indépendants du clan.</p>
    </section>
  </div>
</Base>
