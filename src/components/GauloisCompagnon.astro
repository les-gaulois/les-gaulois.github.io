---
// Le Gaulois compagnon (14 novembre 2026, demande du pilote : « que le petit Gaulois se déplace de page en page sur le
// site, qu'il nous suive et soit interactif », puis « qu'il me suive sur tout l'écran ») : le Gaulois du village, en
// pixels, qui suit le curseur sur toute la fenêtre. Rangé, il attend dans une petite prison au coin bas gauche, dessinée
// par Claude Fable 5.2 (`src/lib/compagnon/prison.ts`) ; un clic l'en sort.
// Monté une fois, dans le pied de page de `Base.astro` : il est donc le dernier dans l'ordre du clavier. Le script ne le
// montre ni sur la Carte, qui n'a pas de pied de page, ni au village, qui a déjà ses Gaulois (« ça fait doublon »), même
// en prison. Rien ne s'affiche sans script : `src/scripts/compagnon.ts` le montre.
// Voir « Le Gaulois compagnon » dans docs/DESIGN.md.
import { PRISONNIER, PRISON_H, PRISON_L } from "../lib/compagnon/prison";
import { VERSION_DESSIN } from "../lib/compagnon/version-dessin";

// L'empreinte du dessin du Gaulois, des poses du village, du dessin du compagnon et de sa prison, calculée à la
// construction du site (`src/lib/compagnon/version-dessin.ts`) : dès que l'un d'eux change, les images du compagnon
// (celles du Gaulois de départ, de la prison, celles peintes et gardées dans l'onglet) sont refaites.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const version = VERSION_DESSIN;
// Le Gaulois de départ et la prison, peints à la construction (src/pages/compagnon/[planche].png.ts) : ce que voit un
// visiteur, sans dessin à charger. La prison n'est téléchargée que si elle se montre (image de fond d'un bouton caché).
const depart = { gaulois: `${base}/compagnon/depart-gaulois.png?v=${version}`, lit: `${base}/compagnon/depart-lit.png?v=${version}` };
const prison = `${base}/compagnon/prison.png?v=${version}`;
const mesuresDeLaPrison = `--prison-l: ${PRISON_L}; --prison-h: ${PRISON_H}; --prisonnier-x: ${PRISONNIER.x}; --prisonnier-y: ${PRISONNIER.y}; --prison-planche: url("${prison}");`;
---

<div class="compagnon" data-compagnon data-version={version} data-depart-gaulois={depart.gaulois} data-depart-lit={depart.lit} hidden>
  <button type="button" class="compagnon-gaulois" data-compagnon-gaulois aria-label="Le Gaulois compagnon : lui parler" aria-expanded="false" aria-controls="compagnon-bulle">
    <span class="compagnon-image" data-compagnon-image aria-hidden="true"></span>
    <span class="compagnon-lit" data-compagnon-lit aria-hidden="true"></span>
  </button>
  <div class="compagnon-bulle" id="compagnon-bulle" data-compagnon-bulle role="group" aria-label="Le Gaulois compagnon">
    <p class="compagnon-parole" data-compagnon-parole aria-live="polite"></p>
    <a class="compagnon-choix compagnon-village" data-compagnon-village href={`${base}/village`} hidden>Aller au village</a>
    <div class="compagnon-actions">
      <button type="button" class="compagnon-choix" data-compagnon-suivre>Reste là</button>
      <button type="button" class="compagnon-choix" data-compagnon-ranger>En prison</button>
    </div>
  </div>
</div>
{/* Rangé, il attend là, au coin bas gauche de la fenêtre, sur toutes les pages sauf la Carte et le village ; un clic le libère. */}
<button type="button" class="compagnon-prison" data-compagnon-prison aria-label="Libérer le Gaulois" style={mesuresDeLaPrison} hidden>
  <span class="compagnon-prison-fond" aria-hidden="true"></span>
  <span class="compagnon-prison-gaulois" data-compagnon-prisonnier aria-hidden="true"></span>
  <span class="compagnon-prison-devant" aria-hidden="true"></span>
  <span class="compagnon-prison-mot" aria-hidden="true">Libérer</span>
</button>

<script>
  import "../scripts/compagnon";
</script>
