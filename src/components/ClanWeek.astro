---
import MapNamesCredit from "./MapNamesCredit.astro";
import { clan } from "../../config/clan";
import { fmtCount, fmtInt, fmtRank } from "../lib/format";
import { editionLead, type GazetteEdition, playersPeriod, weekLabel } from "../lib/gazette";
import { currentMilestonesPeriod, endSentence, homeMilestones, NAMES_SHOWN, restAfter, type CurrentMilestones } from "../lib/vie-du-clan";

/**
 * Les Gaulois de la semaine, sur l'accueil : le résumé de la dernière gazette (podium, plus actifs, arrivées)
 * et le fil de ce que les membres viennent de faire. Tout renvoie à sa page : l'accueil résume, il ne recopie pas.
 * Une ligne sans donnée n'existe pas, et chaque chiffre garde sa période et son périmètre.
 */
interface Props {
  edition: GazetteEdition;
  /** Les paliers franchis depuis le relevé du lundi : la semaine en cours, avec les heures des deux relevés. `null` : pas de relevé. */
  currentMilestones: CurrentMilestones | null;
  /** Les records du clan des sept derniers jours, ceux de la page Records, déjà en mots. */
  records: readonly string[];
  /** Le plus grand territoire sur la carte des clans, s'il est récent, déjà en mots. Ce n'est pas un record de la page Records. */
  territoryRecord: string | null;
  /** « 8 nov., 17:02 sur Baïkal : 9 Gaulois ensemble, victoire en 8 min. » */
  bestGame: string | null;
  /** La belle partie cite une carte de jeu : son nom vient de la traduction du jeu, dont le crédit accompagne le bloc. */
  creditMaps: boolean;
}
const { edition, currentMilestones, records, territoryRecord, bestGame, creditMaps } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { players, active, arrivals } = edition;
const period = playersPeriod(edition);
const milestones = homeMilestones(currentMilestones, edition.milestones);
const week = weekLabel(edition);
// Les paliers d'une gazette portent sur la période de son podium : ses dates s'écrivent quand elle est plus courte que la semaine.
const milestonesWhen = milestones === null ? "" : milestones.when === "current" ? currentMilestonesPeriod(milestones.since, milestones.until) : period && period !== "de la semaine" ? period : `la semaine ${week}`;
const fiche = (id: string) => `${base}/membres/${encodeURIComponent(id)}`;
const arrivalNames = arrivals ? arrivals.named.slice(0, NAMES_SHOWN) : [];
const arrivalRest = arrivals ? restAfter(arrivals.count, arrivalNames.length) : null;
const hasFeed = milestones !== null || records.length > 0 || territoryRecord !== null || bestGame !== null || (arrivals !== null && arrivals.count > 0);
const capital = (text: string) => text.charAt(0).toLocaleUpperCase("fr") + text.slice(1);
---

{/* Une section posée sur le fond : le podium et le fil du clan en deux colonnes séparées par un filet, sans panneau. */}
<section class="band" aria-labelledby="week-title" data-testid="home-week">
  <h2 id="week-title" class="section-title">Les Gaulois de la semaine</h2>
  <p class="label tnum mt-4">Semaine {week}</p>
  <p class="mt-2 max-w-3xl text-xl leading-snug" data-testid="home-week-lead">{editionLead(edition, clan.tag)}</p>

  <div class:list={["mt-8 grid gap-10", players && hasFeed && "lg:grid-cols-2 lg:gap-0"]}>
    {
      players && (
        <div class:list={[hasFeed && "lg:pr-12"]} data-testid="home-podium">
          <h3 class="text-xl">Le plus de victoires{period && ` ${period}`}</h3>
          <ol class="tap-links tnum mt-3 divide-y divide-line border-y border-line">
            {players.map((p) => (
              <li class="flex flex-wrap items-baseline gap-x-3 py-2 [overflow-wrap:anywhere]" data-testid="home-podium-player">
                <span class="figure w-10 flex-none text-2xl">{fmtRank(p.place)}</span>
                <span class="min-w-0 text-lg font-semibold">
                  <a href={fiche(p.id)}>{p.username}</a>
                </span>
                <span class="ml-auto text-sm text-muted">{fmtCount(p.wins, "victoire")}</span>
              </li>
            ))}
          </ol>
          {
            active && (
              <>
                <h3 class="mt-7 text-xl">Les plus actifs</h3>
                <ol class="tap-links tnum mt-3 divide-y divide-line border-y border-line">
                  {active.map((p) => (
                    <li class="flex flex-wrap items-baseline gap-x-3 py-2 [overflow-wrap:anywhere]" data-testid="home-active-player">
                      <span class="figure w-10 flex-none text-2xl">{fmtRank(p.place)}</span>
                      <span class="min-w-0 text-lg font-semibold">
                        <a href={fiche(p.id)}>{p.username}</a>
                      </span>
                      <span class="ml-auto text-sm text-muted">{fmtCount(p.games, "partie")}</span>
                    </li>
                  ))}
                </ol>
              </>
            )
          }
          <p class="mt-4 text-sm text-muted">
            Victoires{active ? " et parties" : ""} en équipe sous le tag, parmi les membres avec pseudo. Cela compte d'abord le temps de jeu : ce n'est pas un classement de niveau.
          </p>
        </div>
      )
    }

    {
      hasFeed && (
        <div class:list={[players && "lg:border-l lg:border-line lg:pl-12"]} data-testid="home-feed">
          <h3 class="text-xl">Le fil du clan</h3>
          {/* Ici, les liens sont pris dans des phrases : pas de zone agrandie, qui écarterait les lignes. */}
          <ul class="mt-3 space-y-4">
            {milestones && (
              <li class="tnum [overflow-wrap:anywhere]" data-testid="home-feed-milestones">
                <strong>Paliers franchis {endSentence(milestonesWhen)}</strong>{" "}
                <span class="text-muted">
                  {milestones.groups.map((group, g) => (
                    <>
                      {g > 0 && " · "}
                      {fmtCount(group.tier, "victoire")} :{" "}
                      {group.players.map((p, i) => (
                        <>
                          {i > 0 && ", "}
                          <a href={fiche(p.id)}>{p.username}</a>
                        </>
                      ))}
                    </>
                  ))}
                </span>
              </li>
            )}
            {records.length > 0 && (
              <li class="tnum" data-testid="home-feed-records">
                <strong>{records.length > 1 ? "Records du clan battus." : "Record du clan battu."}</strong> <span class="text-muted">{records.map(capital).map(endSentence).join(" ")}</span>
              </li>
            )}
            {territoryRecord && (
              <li class="tnum" data-testid="home-feed-territory">
                <strong>
                  Plus grand territoire sur la <a href={`${base}/carte`}>carte des clans</a>.
                </strong>{" "}
                <span class="text-muted">{endSentence(territoryRecord)}</span>
              </li>
            )}
            {bestGame && (
              <li class="tnum" data-testid="home-best-game">
                <strong>La belle partie d'hier.</strong> <span class="text-muted">{bestGame}</span>
              </li>
            )}
            {arrivals && arrivals.count > 0 && (
              <li class="tnum [overflow-wrap:anywhere]" data-testid="home-feed-arrivals">
                <strong>
                  {fmtInt(arrivals.count)} {arrivals.count > 1 ? "arrivées" : "arrivée"} la semaine {week}, encore dans le clan.
                </strong>
                {arrivalNames.length > 0 && <span class="text-muted"> {endSentence([arrivalNames.join(", "), arrivalRest].filter(Boolean).join(" "))}</span>}
              </li>
            )}
          </ul>
          {creditMaps && <MapNamesCredit />}
        </div>
      )
    }
  </div>

  <div class="mt-6 flex flex-wrap gap-x-7">
    <a href={`${base}/gazette`} class="link">Lire la gazette</a>
    <a href={`${base}/membres`} class="link">Voir les membres</a>
    {
      records.length > 0 && (
        <a href={`${base}/records`} class="link">
          Voir les records
        </a>
      )
    }
  </div>
</section>
