---
import { loadMembers } from "../lib/data";
import GauloisPortrait from "./GauloisPortrait.astro";
import ReadingNote from "./ReadingNote.astro";
import { fmtCount, fmtDate, fmtDay, fmtInt, fmtPct, fmtRank } from "../lib/format";
import { portraitDuGaulois } from "../lib/gaulois-site";
import { singlePseudos } from "../lib/members";
import { weekRecordKeys, type RecordKey } from "../lib/records-battus";
import type { ClanRecords } from "../lib/results";
import { arrivalsGap, comparisonSentence, editionNotes, type GazetteEdition, playersPeriod, rankWords, standingDetails, standingGap, territoryDetails, territoryGap } from "../lib/gazette";

interface Props {
  edition: GazetteEdition;
  /** Date du tout premier relevé de chaque mesure, pour expliquer une absence. `null` : aucun relevé. */
  firstStanding: string | null;
  firstTerritory: string | null;
  /** Date de relevé de la liste des membres. */
  membersAt: string | null;
  /** Les records de tout l'historique : un temps fort qui les égale, même moment compris, est un record du clan. */
  records?: ClanRecords | null;
  /**
   * Ses précisions repliées sous l'édition (par défaut). Faux sur la page de la gazette : celles de toutes les éditions se
   * réunissent dans un seul repli, en bas de la page (`gazetteNotes`).
   */
  note?: boolean;
}
const { edition, firstStanding, firstTerritory, membersAt, records = null, note = true } = Astro.props;
const { totals, highlights, standing, territory, arrivals, players, active, milestones } = edition;
const period = playersPeriod(edition);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Une photo Discord ne va qu'à côté d'un pseudo porté par un seul membre : jamais à côté d'un homonyme (src/scripts/visages.ts).
const faces = singlePseudos(loadMembers()?.members ?? []);
// Le Gaulois d'un membre qui a créé le sien prend la place de la photo, à côté de son pseudo (src/lib/gaulois-site.ts).
const gaulois = (id: string | null | undefined) => portraitDuGaulois(id);
const members = standing?.end.membersTotal ?? null;
const comparison = comparisonSentence(edition);
const newRecords = weekRecordKeys(highlights, records);
const tiles: { key: RecordKey; label: string; value: string; hint: string }[] = highlights
  ? [
      { key: "bestDay", label: "Meilleure journée", value: fmtCount(highlights.bestDay.wins, "victoire"), hint: `sur ${fmtCount(highlights.bestDay.games, "partie")}, le ${fmtDay(highlights.bestDay.date)}` },
      { key: "streak", label: "Plus longue série", value: fmtCount(highlights.streak.wins, "victoire"), hint: `dernière victoire le ${fmtDate(highlights.streak.endedAt)}` },
      { key: "biggestGroup", label: "Le plus de Gaulois dans une partie gagnée", value: fmtCount(highlights.biggestGroup.players, "joueur"), hint: `le ${fmtDate(highlights.biggestGroup.at)}` },
      { key: "mostTeams", label: "Victoire avec le plus d'équipes en jeu", value: fmtCount(highlights.mostTeams.teams, "équipe"), hint: `${fmtCount(highlights.mostTeams.players, "joueur")} dans la partie, le ${fmtDate(highlights.mostTeams.at)}` },
    ]
  : [];
---

{/* Pas de phrase d'introduction : elle redisait les parties, les victoires, le taux et le rang écrits juste dessous. L'accueil garde la sienne. */}
<div class="mt-6 grid gap-x-8 gap-y-6 md:grid-cols-2 lg:grid-cols-3">
  <section class="panel" data-testid="gazette-totals">
    <h3 class="text-xl">Les parties</h3>
    <p class="kpi-value mt-2">{fmtInt(totals.games)}</p>
    <p class="tnum mt-1 text-sm text-muted">{totals.winRate === null ? "Aucune partie, donc pas de taux de victoire." : `${fmtCount(totals.wins, "victoire")}, soit ${fmtPct(totals.winRate)}.`}</p>
    {comparison && <p class="tnum mt-1 text-sm text-muted" data-testid="gazette-comparison">{comparison}</p>}
  </section>

  <section class="panel" data-testid="gazette-standing">
    <h3 class="text-xl">Le classement officiel</h3>
    {
      standing ? (
        <>
          <p class="kpi-value mt-2" style="white-space:normal">{rankWords(standing.end.rank)}</p>
          {standingDetails(standing).map((line) => (
            <p class="tnum mt-1 text-sm text-muted">{line}</p>
          ))}
          <p class="mt-1 text-xs text-muted">Sur 90 jours glissants.</p>
        </>
      ) : (
        <>
          <p class="mt-2 font-display text-lg font-bold">Pas de données</p>
          <p class="mt-1 text-sm text-muted">{standingGap(firstStanding, edition.to)}</p>
        </>
      )
    }
  </section>

  <section class="panel md:col-span-2 lg:col-span-1" data-testid="gazette-territory">
    <h3 class="text-xl">La carte des clans</h3>
    {
      territory ? (
        <>
          <p class="kpi-value mt-2">{fmtInt(territory.end.pixels)}</p>
          {territoryDetails(territory).map((line) => (
            <p class="tnum mt-1 text-sm text-muted">{line}</p>
          ))}
        </>
      ) : (
        <>
          <p class="mt-2 font-display text-lg font-bold">Pas de données</p>
          <p class="mt-1 text-sm text-muted">{territoryGap(firstTerritory, edition.to)}</p>
        </>
      )
    }
  </section>

  {
    tiles.length > 0 && (
      <section class="panel md:col-span-2 lg:col-span-3" data-testid="gazette-highlights">
        <h3 class="text-xl">Les temps forts</h3>
        <dl class="mt-3 grid gap-x-6 gap-y-4 sm:grid-cols-2 lg:grid-cols-4">
          {tiles.map((t) => (
            <div class="kpi" data-testid="gazette-highlight">
              <dt class="text-sm font-semibold text-muted">
                {t.label}
                {newRecords.has(t.key) && <span class="ml-2 rounded border border-warn px-1.5 py-0.5 text-xs font-semibold text-warn" data-testid="gazette-record">Record du clan</span>}
              </dt>
              <dd class="mt-0.5">
                <span class="tnum block font-display text-xl font-extrabold">{t.value}</span>
                <span class="tnum block text-xs text-muted">{t.hint}</span>
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="panel md:col-span-2 lg:col-span-3" data-testid="gazette-players">
    <h3 class="text-xl">Le plus de victoires{period && ` ${period}`}</h3>
    {
      players ? (
        <>
          {/* Un podium en marches : le premier sur la plus haute. Le Gaulois de qui a créé le sien s'y tient debout. */}
          <ol class="gazette-podium tnum mt-4">
            {players.map((p) => (
              <li class="gazette-marche" data-place={Math.min(p.place, 3)} data-testid="gazette-player">
                <GauloisPortrait portrait={gaulois(p.id)} pose="pied" taille={2} />
                <span class="gazette-socle">
                  <span class="gazette-rang font-display">{fmtRank(p.place)}</span>
                  <span class="min-w-0 [overflow-wrap:anywhere]">
                    {!gaulois(p.id) && <span class="face-slot mr-1.5" aria-hidden="true" data-face={faces.has(p.username) ? p.username : undefined} hidden />}
                    <a class="pseudo text-lg" href={`${base}/membres/${encodeURIComponent(p.id)}`}>{p.username}</a>
                    <span class="block text-sm text-muted">{fmtCount(p.wins, "victoire")}</span>
                  </span>
                </span>
              </li>
            ))}
          </ol>
          {
            active && (
              <>
                <h4 class="mt-8 text-lg">Les plus actifs</h4>
                <ol class="tnum mt-3 grid gap-x-6 gap-y-3 sm:grid-cols-3">
                  {active.map((p) => (
                    <li class="gazette-ligne" data-testid="gazette-active">
                      <span class="text-muted">{fmtRank(p.place)}</span>
                      <GauloisPortrait portrait={gaulois(p.id)} />
                      <span class="min-w-0 [overflow-wrap:anywhere]">
                        {!gaulois(p.id) && <span class="face-slot mr-1.5" aria-hidden="true" data-face={faces.has(p.username) ? p.username : undefined} hidden />}
                        <a class="pseudo" href={`${base}/membres/${encodeURIComponent(p.id)}`}>{p.username}</a>
                        <span class="block text-sm text-muted">{fmtCount(p.games, "partie")}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              </>
            )
          }
          {/* Une semaine sans palier franchi n'a pas de liste vide : rien ne s'affiche. */}
          {
            milestones && milestones.length > 0 && (
              <>
                <h4 class="mt-8 text-lg">Paliers franchis</h4>
                <ul class="tnum mt-3 grid gap-x-6 gap-y-3 sm:grid-cols-3">
                  {milestones.map((p) => (
                    <li class="gazette-ligne" data-testid="gazette-milestone">
                      <GauloisPortrait portrait={gaulois(p.id)} />
                      <span class="min-w-0 [overflow-wrap:anywhere]">
                        <a class="pseudo" href={`${base}/membres/${encodeURIComponent(p.id)}`}>{p.username}</a>
                        <span class="block text-sm text-muted">{fmtCount(p.tier, "victoire")}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </>
      ) : (
        <>
          <p class="mt-2 font-display text-lg font-bold">Pas de données</p>
          <p class="mt-1 text-sm text-muted">Pas de relevé de la liste des membres au début et à la fin de cette semaine, ou plus personne à citer.</p>
        </>
      )
    }
  </section>

  <section class="panel md:col-span-2 lg:col-span-3" data-testid="gazette-arrivals">
    <h3 class="text-xl">Les arrivées</h3>
    {
      arrivals ? (
        <>
          <p class="kpi-value mt-2">{fmtInt(arrivals.count)}</p>
          {arrivals.count > 0 && <p class="tnum mt-1 text-sm text-muted">{fmtInt(arrivals.anonymous)} sans pseudo public.</p>}
          {arrivals.named.length > 0 && (
            <details class="fold mt-2">
              <summary>Voir {arrivals.named.length > 1 ? `les ${fmtInt(arrivals.named.length)} pseudos` : "le pseudo"}</summary>
              {/* Chaque pseudo mène à sa fiche, comme dans les paliers : un par ligne de lien, assez haut pour le doigt. */}
              <ul class="mt-1 flex flex-wrap items-center gap-x-4 text-sm" data-testid="gazette-names">
                {arrivals.named.map((p) => (
                  <li class="min-w-0 [overflow-wrap:anywhere]">
                    {p.id ? (
                      <a class="pseudo inline-flex items-center gap-1.5 py-1.5" href={`${base}/membres/${encodeURIComponent(p.id)}`}>
                        <GauloisPortrait portrait={gaulois(p.id)} />
                        {p.username}
                      </a>
                    ) : (
                      <span class="inline-block py-1.5 text-muted">{p.username}</span>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          )}
          <p class="info-discrete mt-2">Encore dans le clan{membersAt ? ` le ${fmtDate(membersAt)}` : ""}.{members !== null && ` Effectif le ${fmtDay(standing?.end.date ?? "")} : ${fmtInt(members)}.`}</p>
        </>
      ) : (
        <>
          <p class="mt-2 font-display text-lg font-bold">Pas de données</p>
          <p class="mt-1 text-sm text-muted">{arrivalsGap(membersAt, edition.to)}</p>
        </>
      )
    }
  </section>
</div>

{/* Les précisions de méthode, repliées : le chiffre d'abord (src/lib/gazette.ts, editionNotes). */}
{
  note && (
    <ReadingNote>
      {editionNotes(edition).map((p) => (
        <p>{p}</p>
      ))}
    </ReadingNote>
  )
}
