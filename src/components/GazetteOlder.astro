---
import GazetteEditionBlock from "./GazetteEdition.astro";
import { fmtCount, fmtPct } from "../lib/format";
import { type GazetteEdition, weekLabel } from "../lib/gazette";
import type { ClanRecords } from "../lib/results";

/** Une édition précédente de la gazette, repliée : sa semaine et ses totaux, puis tout son bilan à l'ouverture. */
interface Props {
  edition: GazetteEdition;
  records: ClanRecords | null;
  firstStanding: string | null;
  firstTerritory: string | null;
  membersAt: string | null;
}
const { edition, records, firstStanding, firstTerritory, membersAt } = Astro.props;
---

<details class="fold" data-testid="gazette-older">
  <summary>
    <span>
      Semaine {weekLabel(edition)}
      <span class="tnum font-normal text-muted"> · {fmtCount(edition.totals.games, "partie")}, {fmtCount(edition.totals.wins, "victoire")}{edition.totals.winRate !== null && `, ${fmtPct(edition.totals.winRate)}`}</span>
    </span>
  </summary>
  {/* En retrait derrière un filet, comme une branche : les replis de l'édition (« Comment lire ces chiffres ») ont le dessin
      d'une ligne d'édition et ne doivent pas passer pour l'édition suivante. */}
  <div class="border-l border-line pl-4 sm:pl-6">
    <GazetteEditionBlock edition={edition} records={records} firstStanding={firstStanding} firstTerritory={firstTerritory} membersAt={membersAt} />
  </div>
</details>
