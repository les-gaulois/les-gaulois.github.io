---
import DataStatus from "./DataStatus.astro";
import ReadingNote from "./ReadingNote.astro";
import { clan } from "../../config/clan";
import { loadMeta, loadRanked } from "../lib/data";
import { fmtInt } from "../lib/format";
import { MAX_AGE_HOURS } from "../lib/freshness";
import { RANKED_MODES, RANKED_TOP } from "../lib/ranked";

const meta = loadMeta();
const ranked = loadRanked();
---

{
  (ranked || meta.ranked.lastError) && (
    <section class="stage stage-wine reveal mt-6 scroll-mt-24" id="classe" aria-labelledby="ranked-title" data-testid="ranked-block">
      <h2 id="ranked-title" class="section-title">Membres présents au classé</h2>
      {/* Le classé est à part : une ligne le dit, le reste est replié. */}
      <p class="mt-4 max-w-3xl text-lg text-muted">Classement individuel, hors score du clan.</p>
      {
        ranked ? (
          <ul class="mt-6 grid grid-cols-3 gap-x-4 gap-y-2 md:gap-x-8">
            {RANKED_MODES.map(({ key, label }) => {
              const mode = ranked.modes[key];
              return (
                <li class="panel max-md:!pt-3" data-testid="ranked-mode">
                  <h3 class="text-xl md:text-2xl">{label}</h3>
                  {mode.listed === 0 ? (
                    <p class="mt-2 font-display text-base font-bold md:text-lg">Pas de données</p>
                  ) : (
                    <>
                      <p class="tnum mt-2 font-display text-3xl font-extrabold md:text-4xl" data-testid="ranked-members">{fmtInt(mode.members)}</p>
                      <p class="tnum mt-1 text-xs text-muted md:text-sm">{mode.members > 1 ? "membres" : "membre"} au moins, sur les {fmtInt(mode.listed)} premières places</p>
                      <p class="tnum mt-1 text-xs text-muted md:text-sm" data-testid="ranked-top">dont {fmtInt(mode.top)} sur les {RANKED_TOP} premières</p>
                    </>
                  )}
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="mt-6 font-display text-lg font-bold">Pas de données</p>
        )
      }
      <ReadingNote>
        <p>Combien de membres de [{clan.tag}] figurent au classement officiel de chaque mode classé d'OpenFront. Ce classement est individuel et à part : il ne compte pas dans le score du clan, et il ne dit pas sous quel tag ces parties ont été jouées. Seuls les membres avec un pseudo public sont reconnus : ces nombres sont donc des minimums.</p>
      </ReadingNote>
      <div class="mt-4">
        <DataStatus state={meta.ranked} maxAgeHours={MAX_AGE_HOURS.ranked} />
      </div>
    </section>
  )
}
