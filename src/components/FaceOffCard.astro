---
import { clan } from "../../config/clan";
import { fmtCount, fmtInt, fmtPct } from "../lib/format";
import type { FaceOff } from "../lib/games";

/** Un face-à-face : les rencontres avec un clan, et l'équipe qui a gagné. Les chiffres viennent de `faceOffs`. */
interface Props {
  row: FaceOff;
  /** Le début de l'archive, déjà écrit : « 10 avr. 2026 ». */
  start: string;
}
const { row, start } = Astro.props;
const part = (n: number, total: number) => ({ "--v": `${(n / total) * 100}%` });
---

<li class="panel" data-testid="face-off">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
    <h3 class="text-2xl">[{row.tag}]</h3>
    <span class="tnum text-sm text-muted" data-testid="face-off-meetings">{fmtCount(row.meetings, "partie")}</span>
  </div>
  <div class="split-bar mt-3" aria-hidden="true">
    <i class="bg-win" style={part(row.ours, row.meetings)}></i>
    <i class="bg-loss" style={part(row.theirs, row.meetings)}></i>
    <i class="split-other" style={part(row.others, row.meetings)}></i>
  </div>
  <dl class="tnum mt-3 space-y-1 text-sm">
    <div class="flex justify-between gap-4">
      <dt class="flex items-center gap-1.5"><i class="inline-block size-3 shrink-0 rounded-sm bg-win" aria-hidden="true"></i>L'équipe de [{clan.tag}] gagne</dt>
      <dd class="font-semibold" data-testid="face-off-ours">{fmtInt(row.ours)}</dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="flex items-center gap-1.5"><i class="inline-block size-3 shrink-0 rounded-sm bg-loss" aria-hidden="true"></i>L'équipe de [{row.tag}] gagne</dt>
      <dd class="font-semibold" data-testid="face-off-theirs">{fmtInt(row.theirs)}</dd>
    </div>
    <div class="flex justify-between gap-4">
      <dt class="flex items-center gap-1.5"><i class="split-other inline-block size-3 shrink-0 rounded-sm" aria-hidden="true"></i>Une autre équipe gagne</dt>
      <dd class="font-semibold" data-testid="face-off-others">{fmtInt(row.others)}</dd>
    </div>
  </dl>
  {row.share !== null && (
    <p class="tnum mt-3 text-sm text-muted">
      Quand l'équipe de l'un des deux gagne, c'est celle de [{clan.tag}] : {fmtInt(row.ours)} fois sur {fmtInt(row.ours + row.theirs)}, soit {fmtPct(row.share)}.
    </p>
  )}
  {row.allTime && <p class="tnum mt-1 text-xs text-muted">Depuis le {start} : {fmtCount(row.allTime.meetings, "partie")}, équipe de [{clan.tag}] {fmtInt(row.allTime.ours)}, équipe de [{row.tag}] {fmtInt(row.allTime.theirs)}.</p>}
</li>
