---
import { sectionOf } from "../lib/nav";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const path = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "/";
const section = sectionOf(path);
---

{/* Les onglets de la rubrique : on passe d'une page à l'autre sans repasser par le menu. En chasse fixe, comme le menu
    des parties du QG ; l'onglet ouvert a le filet rouge du marqueur de page (docs/DESIGN.md, « Le poste de commandement »). */}
{
  section && section.pages.length > 1 && (
    <div class="wrap pt-5 md:pt-6">
      <nav class="rubrique" aria-label={`Rubrique ${section.label}`} data-testid="section-nav">
        {section.pages.map((p) => (
          <a class="rubrique-onglet" href={`${base}${p.href}`} aria-current={path === p.href || path.startsWith(`${p.href}/`) ? "page" : undefined}>
            {p.label}
          </a>
        ))}
      </nav>
    </div>
  )
}
