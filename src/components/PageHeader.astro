---
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
// « Confidentialité », « Administration » : un si long mot ne peut pas passer à la ligne.
const hasLongWord = title.split(" ").some((word) => word.length >= 14);
---

<header class="pb-8 pt-7 md:pb-10 md:pt-12">
  <span class="tribar mb-5 md:mb-6"></span>
  <h1 class:list={["page-title", { "page-title-long": hasLongWord }]}>{title}</h1>
  {intro && <p class="mt-4 max-w-3xl text-lg text-muted md:mt-5">{intro}</p>}
  <slot />
</header>
