---
interface Props {
  label?: string;
}
const { label = "Comment lire ces chiffres" } = Astro.props;
---

{/* Les précisions restent dans la page et se lisent sans JavaScript, sans noyer les chiffres. */}
<details class="mt-4 max-w-3xl text-sm text-muted" data-testid="reading-note">
  <summary class="cursor-pointer font-semibold">{label}</summary>
  <div class="mt-2 space-y-2"><slot /></div>
</details>
