---
interface Props {
  label?: string;
}
const { label = "Comment lire ces chiffres" } = Astro.props;
---

{/* Les précisions restent dans la page et se lisent sans JavaScript, sans noyer les chiffres. */}
<details class="fold mt-4" data-testid="reading-note">
  <summary>{label}</summary>
  <div class="max-w-3xl space-y-2 text-sm text-muted"><slot /></div>
</details>
