---
// La porte du village sur l'accueil (14 novembre 2026, même revue que `AccueilCarte.astro`). Le dessin est le Gaulois de
// départ que le site publie déjà pour le compagnon (`src/pages/compagnon/[planche].png.ts`) : une planche de quatre poses
// de 48 cases sur 64, dont on ne montre que la première, debout, agrandie sans flou. Rien n'est importé du village, et
// le bloc ne décrit aucun de ses écrans : la phrase est celle de la description de la page. L'image pèse environ 1 Ko : elle se charge sans attendre,
// à la même adresse versionnée que celle du compagnon, pour n'être téléchargée qu'une fois.
import { VERSION_DESSIN } from "../lib/compagnon/version-dessin";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="stage stage-night reveal flex flex-col items-start" aria-labelledby="accueil-village-titre" data-testid="home-village">
  <h2 id="accueil-village-titre" class="section-title section-title-sm">Votre Gaulois</h2>
  <div class="mt-5 flex items-center gap-5 sm:gap-8">
    {/* 48 × 64 cases, deux fois plus grand sur téléphone, trois puis quatre fois ensuite : toujours un nombre entier d'écrans par case. */}
    <img
      src={`${base}/compagnon/depart-gaulois.png?v=${VERSION_DESSIN}`}
      width="192"
      height="64"
      decoding="async"
      alt="Un Gaulois en pixels, dans sa tenue de départ."
      class="h-32 w-24 max-w-none shrink-0 object-cover object-left [image-rendering:pixelated] sm:h-48 sm:w-36 xl:h-64 xl:w-48"
      draggable="false"
    />
    <div class="flex flex-col items-start">
      {/* La phrase suit la description de la page /village, « Mon Gaulois » depuis le retrait du monde du village (15 novembre 2026). */}
      <p class="max-w-md text-muted">Chaque membre habille son Gaulois en pixels avec les statères des points rapportés au clan, et le voit sur les images du clan sur Discord.</p>
      <a href={`${base}/village#gaulois`} class="btn btn-secondary mt-6">Habiller mon Gaulois</a>
    </div>
  </div>
</section>
