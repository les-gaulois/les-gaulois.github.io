---
import { fmtLongDay } from "../lib/format";
import { KIND_LABELS, typo, type NewsDay } from "../lib/nouveautes";

/** Une journée de mises à jour sur la page des nouveautés. */
interface Props {
  day: NewsDay;
}
const { day } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const id = `jour-${day.date}`;
---

<section class="card scroll-mt-24 p-5 md:p-6" id={id} aria-labelledby={`${id}-titre`} data-testid="nouveautes-day">
  <h2 id={`${id}-titre`} class="text-sm tracking-wide text-muted">{fmtLongDay(day.date)}</h2>
  <ul class="divide-y divide-line">
    {
      day.entries.map((entry) => (
        <li class="grid gap-2 py-4 last:pb-0 sm:grid-cols-[7rem_1fr] sm:gap-4" data-testid="nouveautes-entry">
          <p>
            <span class="inline-block rounded-full border border-line-strong px-2.5 py-0.5 text-xs font-semibold text-muted">{KIND_LABELS[entry.kind]}</span>
          </p>
          <div>
            <h3 class="text-lg">{typo(entry.title)}</h3>
            <p class="mt-1 max-w-3xl text-muted">{typo(entry.body)}</p>
            {entry.link && (
              <p class="mt-2">
                <a href={`${base}${entry.link.href}`}>{entry.link.label}</a>
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>
