---
import { fmtLongDay } from "../lib/format";
import { KIND_LABELS, typo, type NewsDay } from "../lib/nouveautes";

/** Une journée de mises à jour sur la page des nouveautés. */
interface Props {
  day: NewsDay;
}
const { day } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const id = `jour-${day.date}`;
---

<section class="scroll-mt-24 border-t border-line pt-6" id={id} aria-labelledby={`${id}-titre`} data-testid="nouveautes-day">
  <h2 id={`${id}-titre`} class="section-title-sm">{fmtLongDay(day.date)}</h2>
  <ul class="divide-y divide-line">
    {
      day.entries.map((entry) => (
        <li class="grid gap-2 py-4 last:pb-0 sm:grid-cols-[8rem_1fr] sm:gap-6" data-testid="nouveautes-entry">
          <p class="pt-1">
            <span class="inline-block rounded border border-line-strong px-2 py-0.5 text-xs font-semibold text-muted">{KIND_LABELS[entry.kind]}</span>
          </p>
          <div>
            <h3 class="text-xl">{typo(entry.title)}</h3>
            <p class="mt-1 max-w-3xl text-muted">{typo(entry.body)}</p>
            {entry.link && (
              <p class="tap-links mt-1">
                <a href={`${base}${entry.link.href}`}>{entry.link.label}</a>
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</section>
