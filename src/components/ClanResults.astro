---
import ReadingNote from "./ReadingNote.astro";
import { clan } from "../../config/clan";
import { loadMeta, loadSessions } from "../lib/data";
import { fmtCount, fmtDate, fmtInt, fmtPct } from "../lib/format";
import { recentRecordKeys, type RecordKey } from "../lib/records-battus";
import { clanRecords, formatResults, RESULTS_DAYS } from "../lib/results";

const sessions = loadSessions();
const results = formatResults(sessions, loadMeta().sessions.coveredUntil);
const records = clanRecords(sessions);
// Un record des sept derniers jours couverts se signale : le clan vient de le battre.
const recent = recentRecordKeys(records, loadMeta().sessions.coveredUntil);
const groups = results
  ? [
      { title: "Par nombre d'équipes", rows: results.byTeams },
      { title: "Par taille d'équipe", rows: results.bySize },
    ].filter((g) => g.rows.length > 0)
  : [];
const start = fmtDate(`${clan.archiveStart}T12:00:00Z`);
const tiles: { key: RecordKey; label: string; value: string; hint: string }[] = records
  ? [
      { key: "streak", label: "Plus longue série", value: fmtCount(records.streak.wins, "victoire"), hint: `terminée le ${fmtDate(records.streak.endedAt)}` },
      { key: "bestDay", label: "Meilleure journée", value: fmtCount(records.bestDay.wins, "victoire"), hint: `sur ${fmtCount(records.bestDay.games, "partie")}, le ${fmtDate(`${records.bestDay.date}T12:00:00Z`)}` },
      { key: "biggestGroup", label: "Le plus de Gaulois dans une partie gagnée", value: fmtCount(records.biggestGroup.players, "joueur"), hint: `le ${fmtDate(records.biggestGroup.at)}` },
      { key: "mostTeams", label: "Victoire avec le plus d'équipes en jeu", value: fmtCount(records.mostTeams.teams, "équipe"), hint: `${fmtCount(records.mostTeams.players, "joueur")} dans la partie, le ${fmtDate(records.mostTeams.at)}` },
    ]
  : [];
---

{
  tiles.length > 0 && (
    <section class="band" aria-labelledby="records-title" data-testid="clan-records">
      <h2 id="records-title" class="section-title">Les records du clan</h2>
      <dl class="mt-8 grid grid-cols-1 gap-x-0 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          tiles.map((t) => (
            <div class="sm:pr-6 lg:border-l lg:border-line lg:px-6 lg:first:border-l-0 lg:first:pl-0" data-testid="clan-record">
              <dt class="label">
                {t.label}
                {recent.has(t.key) && <span class="ml-2 rounded border border-warn px-1.5 py-0.5 text-xs font-semibold text-warn" data-testid="clan-record-new">Nouveau record</span>}
              </dt>
              <dd class="mt-1">
                <span class="figure mt-1 block text-[2rem] sm:text-4xl">{t.value}</span>
                <span class="tnum mt-1 block text-xs text-muted">{t.hint}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <ReadingNote>
        <p>
        Depuis le {start}, parties publiques en équipe jouées avec le tag, tous joueurs du clan confondus : une série mêle donc plusieurs groupes. Le jeu place tout un clan dans une seule équipe : le nombre de Gaulois d'une partie gagnée compte aussi ceux partis avant la fin. Une partie jouée seul contre des robots n'est pas comptée.
      </p>
      </ReadingNote>
    </section>
  )
}

{
  results && groups.length > 0 && (
    <section class="band" aria-labelledby="formats-title" data-testid="format-results">
      <h2 id="formats-title" class="section-title">Nos résultats par format</h2>
      <p class="mt-3 max-w-3xl text-lg text-muted">
        Un taux seul ne dit pas grand-chose : à 2 équipes, le hasard donne déjà 50 %. Le trait rouge sur chaque jauge marque le taux d'une équipe prise au hasard.
      </p>
      <div class="mt-8 space-y-10">
        {
          groups.map((group) => (
            <div>
              <h3 class="text-xl">{group.title}</h3>
              <ul class="mt-4 grid gap-x-8 gap-y-5 md:grid-cols-2 lg:grid-cols-3">
                {group.rows.map((row) => (
                  <li data-testid="format-row">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                      <span class="font-semibold">{row.label}</span>
                      <span class="figure text-2xl">{fmtPct(row.winRate)}</span>
                    </div>
                    <div class="meter relative mt-1" aria-hidden="true">
                      <i style={{ "--v": `${row.winRate}%` }}></i>
                      {row.chance !== null && <b class="meter-tick" style={{ left: `${row.chance}%` }}></b>}
                    </div>
                    <p class="tnum mt-1 text-xs text-muted">
                      {fmtInt(row.wins)} victoires sur {fmtInt(row.games)} parties{row.chance !== null && ` · au hasard : ${fmtPct(row.chance)}`}
                    </p>
                    <p class="tnum mt-0.5 text-xs text-muted">Depuis le {start} : {fmtPct(row.allTime.winRate)} sur {fmtInt(row.allTime.games)} parties</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="tnum mt-4 max-w-3xl text-sm text-muted" data-testid="format-period">Sur {RESULTS_DAYS} jours, du {fmtDate(`${results.from}T12:00:00Z`)} au {fmtDate(`${results.to}T12:00:00Z`)}.</p>
      <ReadingNote>
        <p>
        Le hasard est la moyenne de 1 ÷ nombre d'équipes sur ces parties. C'est un repère, pas une preuve : le niveau des adversaires et le nombre de Gaulois dans la partie comptent aussi. Un format sous 30 parties sur cette période n'est pas affiché.
      </p>
      </ReadingNote>
    </section>
  )
}
