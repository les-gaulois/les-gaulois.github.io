---
import { FENETRES, type FenetreId } from "../../lib/carte-console";

interface Props {
  /** L'ancre de la fenêtre, une de celles de `FENETRES`. */
  id: FenetreId;
  /** `true` : la fenêtre ne sert qu'une fois le film chargé (`data-film-ready`), et reste cachée sans lui. */
  film?: boolean;
  /** `true` : la fenêtre n'a de contenu que dans la console (la carte de l'alliance) ; sans script, elle n'existe pas. */
  consoleSeulement?: boolean;
  class?: string;
  testid?: string;
}
const { id, film = false, consoleSeulement = false, class: className, testid } = Astro.props;
const label = FENETRES.find((f) => f.id === id)?.label ?? id;
---

{/* Une fenêtre de la console de la carte (docs/DESIGN.md, « La carte en console ») : une barre de titre avec son bouton
    pour la fermer, une ligne de commande décorative, puis le titre et le contenu. Elle ne s'affiche que choisie dans la
    rangée du bas ; sans script, toutes se lisent l'une après l'autre. `tabindex` : la fenêtre ouverte reçoit le focus. */}
<section
  id={id}
  class:list={["carte-fenetre", className]}
  data-fenetre={id}
  data-film-ready={film ? "" : undefined}
  hidden={film}
  data-console-seulement={consoleSeulement ? "" : undefined}
  aria-labelledby={`${id}-titre`}
  tabindex="-1"
  data-testid={testid}
>
  <div class="carte-fenetre-barre">
    <span aria-hidden="true">{id}</span>
    {/* Son « [x] » est dessiné par la feuille de style : le nom du bouton reste celui que lisent les lecteurs d'écran. */}
    <button type="button" class="carte-fermer" data-ferme aria-label={`Fermer la fenêtre ${label}`}></button>
  </div>
  <div class="carte-fenetre-corps" data-commande={id}>
    <slot name="avant" />
    <h2 id={`${id}-titre`}><slot name="titre" /></h2>
    <slot />
  </div>
</section>
