---
import "../styles/global.css";
// Les deux polices du site, préchargées : le texte s'affiche presque toujours directement dans sa police.
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import outfitFont from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
import { clan, SITE_DISCLAIMER, SITE_LICENSE_NOTICE } from "../../config/clan";
import { brandFile } from "../lib/brand";
import { AUTH_ENABLED } from "../lib/compte/api";
import AuthMenu from "../components/AuthMenu";
import NouveautesMenu from "../components/NouveautesMenu.astro";
import PlayerViewBar from "../components/PlayerViewBar";
import SectionNav from "../components/SectionNav.astro";
import { SECTIONS, sectionOf } from "../lib/nav";
import { loadMeta, loadLinks, loadNouveautes } from "../lib/data";
import { fmtDateTime } from "../lib/format";
import { newsMarker } from "../lib/nouveautes";

interface Props {
  title?: string;
  description?: string;
  /** Pages personnelles : inutile qu'un moteur de recherche les retienne. */
  noindex?: boolean;
  /** Les pages de l'encadrement passent au rouge : voir « Thème rouge de l'encadrement » dans docs/DESIGN.md. */
  theme?: "rouge";
  /** L'image d'aperçu du lien, à la place de celle du site : un chemin qui commence par la base, et ce qu'elle montre. */
  image?: string;
  imageAlt?: string;
}
const { title, description = `${clan.tagline} Classement, progression, membres et activité du clan.`, noindex = false, theme, image, imageAlt } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fullTitle = title ? `${title} · [${clan.tag}] ${clan.name}` : `[${clan.tag}] ${clan.name} · Clan OpenFront`;
const path = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "/";
const currentSection = sectionOf(path);
const badge = brandFile("badge");
const ogImage = new URL(image ?? `${base}/generated/og.jpg`, Astro.site).href;
const lastRun = loadMeta().lastRunAt;
const usefulTools = loadLinks().tools.length > 0;
// La marque de la dernière mise à jour du site : src/scripts/nouveautes.ts la compare à celle que le visiteur a vue.
const nouveautesMarker = newsMarker(loadNouveautes());
---

<!doctype html>
<html lang="fr" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    {/* La barre du navigateur sur téléphone prend le fond de la page : le jeton navy de chaque thème. */}
    <meta name="theme-color" content={theme === "rouge" ? "#300A10" : "#0A1230"} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/generated/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/generated/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    <link rel="preload" href={outfitFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Avant le premier affichage : un visiteur ayant mis en pause ne voit aucune animation,
      // et les autres ne voient pas les blocs s'afficher puis disparaître avant leur apparition en fondu.
      try {
        if (localStorage.getItem("gal-fx") === "off") document.documentElement.classList.add("fx-off");
        else if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("fx-wait");
      } catch {
        // Stockage indisponible : les animations restent actives, le bouton pause fonctionne.
      }
    </script>
  </head>
  <body class="flex min-h-dvh flex-col" data-nouveautes-marker={nouveautesMarker ?? undefined}>
    <a
      href="#contenu"
      class="absolute left-2 top-[-4rem] z-50 rounded bg-white px-3 py-2 font-semibold text-navy focus:top-2"
      >Aller au contenu</a
    >
    <header class="sticky top-0 z-40 bg-navy/80 backdrop-blur-md">
      <div class="wrap flex min-h-16 items-center justify-between gap-4">
        <a href={`${base}/`} class="flex items-center gap-3 font-display font-extrabold">
          {
            badge ? (
              <img src={`${base}/generated/badge-96.webp`} alt={`[${clan.tag}], accueil`} width="40" height="40" class="size-10 rounded-full object-cover" />
            ) : (
              <span class="text-xl">[{clan.tag}]</span>
            )
          }
          <span class:list={[AUTH_ENABLED ? "hidden sm:inline xl:hidden" : "hidden sm:inline"]}>{clan.name}</span>
        </a>

        {/* Le bouton du compte prend de la place : le menu complet demande alors plus de largeur. */}
        <nav aria-label="Navigation principale" class:list={[AUTH_ENABLED ? "hidden xl:block" : "hidden lg:block"]}>
          <ul class="flex items-center gap-1">
            {
              SECTIONS.map((s) => (
                <li>
                  <a
                    href={`${base}${s.href}`}
                    aria-current={path === s.href ? "page" : currentSection === s ? "true" : undefined}
                    class:list={[
                      "block whitespace-nowrap rounded px-3 py-2 text-sm font-semibold text-white hover:underline hover:underline-offset-8",
                      currentSection === s && "underline decoration-red decoration-2 underline-offset-8",
                    ]}
                  >
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          {/* Les nouveautés du site : un bouton discret sur grand écran ; en dessous, la place manque et elles passent dans le menu. */}
          <div class="hidden lg:block">
            <NouveautesMenu />
          </div>
          {/* Avec le bouton de connexion, la place manque sur téléphone : le Discord reste dans la page et le pied de page. */}
          <span class:list={[AUTH_ENABLED ? "hidden md:inline-flex" : "inline-flex"]}>
            <a href={clan.links.discord} class="btn btn-secondary !min-h-10 !py-1.5 !text-sm" rel="noopener">
              Discord
            </a>
          </span>
          {AUTH_ENABLED && <AuthMenu client:idle />}
          <button
            type="button"
            class="btn btn-ghost fx-toggle !min-h-10 !px-2.5 !py-1.5"
            data-fx-toggle
            aria-pressed="false"
            aria-label="Mettre les animations en pause"
            title="Mettre les animations en pause"
            hidden
          >
            <svg class="fx-icon-pause" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
              <rect x="3" y="2" width="4" height="12" rx="1"></rect>
              <rect x="9" y="2" width="4" height="12" rx="1"></rect>
            </svg>
            <svg class="fx-icon-play" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M4 2.500v11l9-5.500z"></path>
            </svg>
          </button>
          <details class:list={["relative", AUTH_ENABLED ? "xl:hidden" : "lg:hidden"]} data-menu>
            <summary class="btn btn-ghost !min-h-10 !py-1.5 cursor-pointer list-none text-sm" aria-label="Ouvrir le menu" data-nouveautes-described>
              Menu
              {/* Le point dit qu'une nouveauté du site attend dans le menu. Allumé, src/scripts/nouveautes.ts le dit aussi aux lecteurs d'écran, par la description du bouton. */}
              {nouveautesMarker && <span class="nouveautes-dot lg:hidden" data-nouveautes-dot aria-hidden="true" hidden />}
            </summary>
            {nouveautesMarker && <span id="nouveautes-menu-note" hidden>Du nouveau sur le site depuis votre dernier passage</span>}
            <nav aria-label="Navigation mobile" class="card absolute right-0 mt-2 w-56 p-2 shadow-xl">
              <ul>
                {
                  SECTIONS.map((s) => (
                    <li>
                      <a
                        href={`${base}${s.href}`}
                        aria-current={path === s.href ? "page" : currentSection === s ? "true" : undefined}
                        class:list={["block rounded px-3 py-3 font-semibold", currentSection === s ? "bg-surface-2 text-white" : "text-muted"]}
                      >
                        {s.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
              {
                nouveautesMarker && (
                  <div class="mt-1 border-t border-line pt-1 lg:hidden">
                    <a
                      href={`${base}/nouveautes`}
                      aria-current={path === "/nouveautes" ? "page" : undefined}
                      class:list={["flex items-center gap-2 rounded px-3 py-3 font-semibold", path === "/nouveautes" ? "bg-surface-2 text-white" : "text-muted"]}
                      data-testid="nouveautes-menu-link"
                    >
                      Nouveautés du site
                      <span class="nouveautes-dot" data-nouveautes-dot hidden><span class="sr-only">: du nouveau depuis votre dernier passage</span></span>
                    </a>
                  </div>
                )
              }
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="contenu" class="flex-1">
      {/* La vue joueur de l'encadrement : une bande en haut de chaque page pour ne pas l'oublier et en sortir. Hors de l'en-tête collant, qui garde sa hauteur. */}
      {AUTH_ENABLED && <PlayerViewBar client:idle />}
      <SectionNav />
      <slot />
    </main>

    <footer class="mt-20 bg-night">
      <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[3fr_3fr_2fr_3fr]">
        <div>
          <p class="font-display text-lg font-extrabold">[{clan.tag}] {clan.name}</p>
          <span class="tribar mt-3"></span>
          <p class="mt-4 text-sm text-muted">{SITE_DISCLAIMER}</p>
          <p class="mt-2 text-sm text-muted">{SITE_LICENSE_NOTICE}</p>
        </div>
        <nav aria-label="Plan du site">
          <h2 class="text-sm uppercase tracking-wide text-muted">Le site</h2>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm" data-testid="footer-plan">
            {SECTIONS.flatMap((s) => s.pages).map((p) => <li><a href={`${base}${p.href}`}>{p.label}</a></li>)}
          </ul>
        </nav>
        <div>
          <h2 class="text-sm uppercase tracking-wide text-muted">Liens utiles</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href={clan.links.discord} rel="noopener">Discord du clan</a></li>
            <li><a href={clan.links.openfront} rel="noopener">Jouer à OpenFront</a></li>
            {usefulTools && <li><a href={`${base}/outils#outils-section`}>Outils communautaires</a></li>}
            {AUTH_ENABLED && <li><a href={`${base}/confidentialite`}>Confidentialité</a></li>}
            <li><a href={clan.links.source} rel="noopener">Code source</a></li>
          </ul>
        </div>
        <div class="text-sm text-muted">
          <h2 class="text-sm uppercase tracking-wide">Données</h2>
          <p class="mt-3">
            Chiffres issus de l'API publique d'OpenFront, collectés toutes les heures. Ce ne sont pas des données en temps réel.
          </p>
          {lastRun && <p class="mt-2 tnum">Dernière collecte : {fmtDateTime(lastRun)}, heure de Paris.</p>}
        </div>
      </div>
    </footer>

    <script>
      // Le site est statique : si la collecte s'arrête, seul le navigateur du
      // visiteur peut voir que les données ont vieilli.
      const now = Date.now();
      for (const el of document.querySelectorAll<HTMLElement>("[data-last-success]")) {
        const age = now - Date.parse(el.dataset.lastSuccess ?? "");
        const maxAge = Number(el.dataset.maxAgeHours) * 3_600_000;
        const msg = el.querySelector<HTMLElement>("[data-stale-msg]");
        if (msg && age > maxAge) {
          const hours = Math.floor(age / 3_600_000);
          msg.textContent = `Données périmées : dernière mise à jour il y a ${hours >= 48 ? `${Math.floor(hours / 24)} jours` : `${hours} h`}.`;
          msg.hidden = false;
        }
      }

      // Referme les menus de l'en-tête (le menu mobile, les nouveautés) avec Échap ou au clic en dehors.
      const menus = document.querySelectorAll<HTMLDetailsElement>("[data-menu]");
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        for (const menu of menus) {
          if (!menu.open) continue;
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", (e) => {
        for (const menu of menus) if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
      });
    </script>
    <script>
      import "../scripts/fx";
      import "../scripts/nouveautes";
    </script>
  </body>
</html>
