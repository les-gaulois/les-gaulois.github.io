---
// Les polices du site, préchargées : le texte s'affiche presque toujours directement dans sa police. Outfit ne l'est plus
// que pour le QG et la Direction : les autres pages écrivent leurs titres dans l'onciale de cases (plus bas).
import interFont from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import outfitFont from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
// La chasse fixe du poste de commandement : depuis le 12 novembre 2026, la machine du QG parle sur toutes les pages
// (invite, menu, onglets, libellés). Voir « Le poste de commandement » dans docs/DESIGN.md.
import consoleFont from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";
import { clan, SITE_DISCLAIMER, SITE_LICENSE_NOTICE } from "../../config/clan";
import { brandFile } from "../lib/brand";
import { AUTH_ENABLED } from "../lib/compte/api";
import { EARLIER_VISIT_KEYS, VISIT_COUNT_KEY } from "../lib/activite-site";
import AuthMenu from "../components/AuthMenu";
import AppelsGaulois from "../components/compte/AppelsGaulois";
import GauloisCompagnon from "../components/GauloisCompagnon.astro";
import NouveautesMenu from "../components/NouveautesMenu.astro";
import PlayerViewBar from "../components/PlayerViewBar";
import SectionNav from "../components/SectionNav.astro";
import { SECTIONS, sectionOf } from "../lib/nav";
import { feuillesDeLaPage } from "../lib/feuilles";
import { loadMeta, loadNouveautes } from "../lib/data";
import { fmtDateTime } from "../lib/format";
import { newsMarker } from "../lib/nouveautes";
// La feuille de style, en morceaux (src/lib/feuilles.ts) : chacun est traité par Tailwind et Vite comme un fichier à
// part, et la page écrit elle-même ses `<link>`, dans l'ordre de la cascade d'origine. Voir « Les feuilles de style, en
// morceaux » dans docs/DESIGN.md.
const adressesDesFeuilles = import.meta.glob<string>("../styles/feuilles/*.css", { query: "?url", import: "default", eager: true });

interface Props {
  title?: string;
  description?: string;
  /** Pages personnelles : inutile qu'un moteur de recherche les retienne. */
  noindex?: boolean;
  /** Les pages de l'encadrement passent au rouge : voir « Thème rouge de l'encadrement » dans docs/DESIGN.md. */
  theme?: "rouge";
  /**
   * La Direction et, depuis le 12 novembre 2026, le QG : l'ambiance d'un poste de commandement, en style Terminal, dans la
   * couleur de la page (rouge à la Direction, bleu au QG). Voir « Ambiance console » dans docs/DESIGN.md.
   */
  ambiance?: "console";
  /**
   * La Direction, depuis le 15 novembre 2026 : la page prend tout l'écran, en-tête et pied de page compris, au lieu de la
   * largeur du site (120 rem), comme un panneau d'administration. Voir « La largeur » dans docs/DESIGN.md.
   */
  largeur?: "ecran";
  /** L'image d'aperçu du lien, à la place de celle du site : un chemin qui commence par la base, et ce qu'elle montre. */
  image?: string;
  imageAlt?: string;
  /**
   * « Mon Gaulois » (/village), depuis le 21 novembre 2026 : un écran de jeu plein écran, sans l'en-tête, le menu, la
   * rubrique ni le pied de page du site. À leur place, ce que la page pose dans les fentes « barre-jeu » (la barre du jeu et
   * son fond, BarreDuJeu.astro) et « pied-jeu » (une ligne discrète en bas, PiedDuJeu.astro), et la feuille de son kit dans
   * la fente « tete ». Voir « Le kit du jeu » dans docs/DESIGN.md. Les autres pages n'importent ainsi rien du jeu, ce que
   * le test des feuilles (tests/unit/feuilles.test.ts) vérifie.
   */
  cadre?: "jeu";
}
const { title, description = `${clan.tagline} Classement, progression, membres et activité du clan.`, noindex = false, theme, ambiance, largeur, image, imageAlt, cadre } = Astro.props;
const jeu = cadre === "jeu";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fullTitle = title ? `${title} · [${clan.tag}] ${clan.name}` : `[${clan.tag}] ${clan.name} · Clan OpenFront`;
const path = Astro.url.pathname.replace(base, "").replace(/\/$/, "") || "/";
const currentSection = sectionOf(path);
const badge = brandFile("badge");
const ogImage = new URL(image ?? `${base}/generated/og.jpg`, Astro.site).href;
const lastRun = loadMeta().lastRunAt;
// La marque de la dernière mise à jour du site : src/scripts/nouveautes.ts la compare à celle que le visiteur a vue.
const nouveautesMarker = newsMarker(loadNouveautes());
// L'onciale de cases (src/lib/police/onciale.ts), fabriquée à chaque construction : les titres et les gros chiffres de toutes
// les pages sauf le QG et la Direction, comme l'a demandé le pilote le 12 novembre 2026 (« en dehors du QG et DIRECTION ») ;
// une page qui passerait en ambiance console la garderait. En cases visibles pour les grands titres et les chiffres clés,
// taillée (sans marches d'escalier) pour les petits textes. Le QG et la Direction gardent Outfit, dans leur style Terminal.
// Voir « Typographie » dans docs/DESIGN.md.
const lettresOnciale = !["/qg", "/direction"].includes(path);
// La barre du navigateur en thème clair : le fond de la page (blanc, à peine bleuté au QG, à peine rosé à la Direction).
const themeColorClair = theme === "rouge" ? (ambiance === "console" ? "#FFF9F9" : "#FFFFFF") : ambiance === "console" && !lettresOnciale ? "#F6F8FD" : "#FFFFFF";
const onciale = lettresOnciale
  ? [
      { famille: "GAL Onciale", url: `${base}/generated/polices/onciale.woff2` },
      { famille: "GAL Onciale Cases", url: `${base}/generated/polices/onciale-cases.woff2` },
    ]
  : null;
// Les morceaux de la feuille de style que cette page charge, dans l'ordre de la cascade.
const feuilles = feuillesDeLaPage(Astro.routePattern).map((fichier) => {
  const adresse = adressesDesFeuilles[`../styles/feuilles/${fichier}`];
  if (!adresse) throw new Error(`Base.astro : le morceau de feuille ${fichier} est introuvable dans src/styles/feuilles/`);
  return adresse;
});
---

<!doctype html>
{/* La console de la Direction et du QG est en style Terminal (data-console), voir « Ambiance console » dans docs/DESIGN.md. */}
{/* data-lettres : les pages écrites dans l'onciale de cases, toutes sauf le QG et la Direction (04-poste.css, « L'onciale de cases »). */}
<html
  lang="fr"
  data-theme={theme}
  data-ambiance={ambiance}
  data-console={ambiance === "console" ? "terminal" : undefined}
  data-largeur={largeur}
  data-lettres={lettresOnciale ? "onciale" : undefined}
  data-ecran={cadre}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    {/* La barre du navigateur prend le fond de la page (thème clair du 14 novembre 2026) : le blanc du site, guide compris, l'écran à peine bleuté du Terminal au QG, à peine rosé à la Direction. */}
    {/* En thème sombre « Nuit Marine » (16 novembre 2026), le script ci-dessous y met la valeur de data-sombre : le bleu marine de la page, le bordeaux sombre de la Direction. */}
    <meta name="theme-color" content={themeColorClair} data-clair={themeColorClair} data-sombre={theme === "rouge" ? "#300A10" : "#0A1230"} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/generated/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/generated/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/manifest.webmanifest`} />
    {
      onciale ? (
        <>
          {onciale.map((p) => (
            <link rel="preload" href={p.url} as="font" type="font/woff2" crossorigin />
          ))}
          <style
            is:inline
            set:html={onciale.map((p) => `@font-face{font-family:"${p.famille}";src:url("${p.url}") format("woff2");font-weight:100 900;font-display:swap}`).join("")}
          />
        </>
      ) : (
        <link rel="preload" href={outfitFont} as="font" type="font/woff2" crossorigin />
      )
    }
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={consoleFont} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Avant le premier affichage : le thème sombre « Nuit Marine », si le visiteur l'a choisi (bouton de l'en-tête,
      // src/scripts/mode.ts) ou, sans choix de sa part, si son appareil est réglé en sombre. Posé ici, la page ne
      // s'affiche jamais d'abord en clair.
      try {
        let mode = null;
        try {
          mode = localStorage.getItem("gal-mode");
        } catch {
          // Stockage indisponible : le réglage de l'appareil décide.
        }
        if (mode !== "clair" && mode !== "sombre") mode = matchMedia("(prefers-color-scheme: dark)").matches ? "sombre" : "clair";
        if (mode === "sombre") {
          document.documentElement.dataset.mode = "sombre";
          document.querySelector('meta[name="color-scheme"]').content = "dark";
          const barre = document.querySelector('meta[name="theme-color"]');
          barre.content = barre.dataset.sombre;
        }
      } catch {
        // Navigateur sans matchMedia : le site reste en clair.
      }
    </script>
    <script is:inline>
      // Avant le premier affichage : un visiteur ayant mis en pause ne voit aucune animation,
      // et les autres ne voient pas les blocs s'afficher puis disparaître avant leur apparition en fondu.
      try {
        if (localStorage.getItem("gal-fx") === "off") document.documentElement.classList.add("fx-off");
        else if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("fx-wait");
      } catch {
        // Stockage indisponible : les animations restent actives, le bouton pause fonctionne.
      }
    </script>
    {
      AUTH_ENABLED && (
        <script is:inline define:vars={{ visitKeys: [VISIT_COUNT_KEY, ...EARLIER_VISIT_KEYS] }}>
          // Le compte des visites (src/scripts/visite.ts) : ce navigateur est-il déjà venu ? Noté avant que les composants de
          // la page n'écrivent leurs propres traces. Seule cette réponse par oui ou non sert, rien du contenu.
          try {
            document.documentElement.dataset.visiteAvant = visitKeys.some((key) => localStorage.getItem(key) !== null) ? "1" : "0";
          } catch {
            // Stockage indisponible : visite.ts ne compte alors que des pages vues.
          }
        </script>
      )
    }
    {feuilles.map((href) => <link rel="stylesheet" href={href} />)}
    <slot name="tete" />
  </head>
  <body class="flex min-h-dvh flex-col" data-nouveautes-marker={nouveautesMarker ?? undefined} data-route={Astro.routePattern}>
    <a
      href="#contenu"
      class="absolute left-2 top-[-4rem] z-50 rounded bg-white px-3 py-2 font-semibold text-navy focus:top-2"
      >Aller au contenu</a
    >
    {/* En cadre de jeu (/village) : la barre du jeu et son fond, posés par la page, à la place de l'en-tête. */}
    {jeu ? (
      <slot name="barre-jeu" />
    ) : (
    /* La barre de commande : une vitre sombre, et l'horizon tricolore dessous (« Le poste de commandement », docs/DESIGN.md). */
    <header class="barre sticky top-0 z-40">
      <div class="wrap flex min-h-16 items-center justify-between gap-4">
        <a href={`${base}/`} class="flex items-center gap-3 font-display font-extrabold">
          {
            badge ? (
              <img src={`${base}/generated/badge-96.webp`} alt={`[${clan.tag}], accueil`} width="40" height="40" class="size-10 rounded-full object-cover" />
            ) : (
              <span class="text-xl">[{clan.tag}]</span>
            )
          }
          <span class:list={[AUTH_ENABLED ? "hidden sm:inline xl:hidden" : "hidden sm:inline"]}>{clan.name}</span>
        </a>

        {/* Le bouton du compte prend de la place : le menu complet demande alors plus de largeur. */}
        <nav aria-label="Navigation principale" class:list={[AUTH_ENABLED ? "hidden xl:block" : "hidden lg:block"]}>
          <ul class="flex items-center gap-1">
            {
              SECTIONS.map((s) => (
                <li>
                  <a href={`${base}${s.href}`} aria-current={path === s.href ? "page" : currentSection === s ? "true" : undefined} class="barre-lien">
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex items-center gap-2">
          {/* Les nouveautés du site : un bouton discret sur grand écran ; en dessous, la place manque et elles passent dans le menu. */}
          <div class="hidden lg:block">
            <NouveautesMenu />
          </div>
          {/* Avec le bouton de connexion, la place manque sur téléphone : le Discord passe dans le menu, plus bas. */}
          <span class:list={[AUTH_ENABLED ? "hidden md:inline-flex" : "inline-flex"]}>
            <a href={clan.links.discord} class="btn btn-secondary !min-h-10 !py-1.5 !text-sm" rel="noopener">
              Discord
            </a>
          </span>
          {AUTH_ENABLED && <AuthMenu client:idle />}
          <button
            type="button"
            class="btn btn-ghost fx-toggle !min-h-10 !px-2.5 !py-1.5"
            data-fx-toggle
            aria-pressed="false"
            aria-label="Mettre les animations en pause"
            title="Mettre les animations en pause"
            hidden
          >
            <svg class="fx-icon-pause" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
              <rect x="3" y="2" width="4" height="12" rx="1"></rect>
              <rect x="9" y="2" width="4" height="12" rx="1"></rect>
            </svg>
            <svg class="fx-icon-play" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M4 2.500v11l9-5.500z"></path>
            </svg>
          </button>
          {/* Clair ou sombre : le choix du visiteur, retenu dans son navigateur (src/scripts/mode.ts). Avec le bouton de
              connexion, la place manque sur téléphone : le choix passe alors dans le menu, plus bas. Masqué par son
              conteneur : .btn écrase la classe hidden. */}
          <span class:list={[AUTH_ENABLED ? "hidden sm:inline-flex" : "inline-flex"]}>
          <button type="button" class="btn btn-ghost mode-toggle !min-h-10 !px-2.5 !py-1.5" data-mode-toggle aria-pressed="false" aria-label="Thème sombre" title="Passer au thème sombre" hidden>
            <svg class="mode-icone-lune" viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M6.200 1.300a6.800 6.800 0 1 0 8.500 8.500 5.600 5.600 0 0 1-8.500-8.500z"></path>
            </svg>
            <svg class="mode-icone-soleil" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="8" cy="8" r="2.900" fill="currentColor" stroke="none"></circle>
              <path d="M8 1.200v1.600M8 13.200v1.600M1.200 8h1.600M13.200 8h1.600M3.200 3.200l1.100 1.100M11.700 11.700l1.100 1.100M3.200 12.800l1.100-1.100M11.700 4.300l1.100-1.100"></path>
            </svg>
          </button>
          </span>
          <details class:list={["relative", AUTH_ENABLED ? "xl:hidden" : "lg:hidden"]} data-menu>
            <summary class="btn btn-ghost !min-h-10 !py-1.5 cursor-pointer list-none text-sm" aria-label="Ouvrir le menu" data-nouveautes-described>
              Menu
              {/* Le point dit qu'une nouveauté du site attend dans le menu. Allumé, src/scripts/nouveautes.ts le dit aussi aux lecteurs d'écran, par la description du bouton. */}
              {nouveautesMarker && <span class="nouveautes-dot lg:hidden" data-nouveautes-dot aria-hidden="true" hidden />}
            </summary>
            {nouveautesMarker && <span id="nouveautes-menu-note" hidden>Du nouveau sur le site depuis votre dernier passage</span>}
            <nav aria-label="Navigation mobile" class="card absolute right-0 mt-2 w-56 p-2 shadow-xl">
              <ul>
                {
                  SECTIONS.map((s) => (
                    <li>
                      <a
                        href={`${base}${s.href}`}
                        aria-current={path === s.href ? "page" : currentSection === s ? "true" : undefined}
                        class:list={["block rounded px-3 py-3 font-semibold", currentSection === s ? "bg-surface-2 text-white" : "text-muted"]}
                      >
                        {s.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
              {
                /* Le Discord, porte d'entrée du clan : sur téléphone, le bouton de l'en-tête laisse sa place à la connexion, il
                   vient donc ici (revue du 18 novembre 2026). Texte seul, sans marque. */
                AUTH_ENABLED && clan.links.discord && (
                  <div class="mt-1 border-t border-line pt-1 md:hidden">
                    <a href={clan.links.discord} rel="noopener" class="block rounded px-3 py-3 font-semibold text-muted" data-testid="discord-menu">
                      Discord du clan
                    </a>
                  </div>
                )
              }
              {
                AUTH_ENABLED && (
                  <div class="mt-1 border-t border-line pt-1 sm:hidden">
                    {/* Le choix du thème, sur téléphone : son texte dit où il mène (src/scripts/mode.ts). */}
                    <button type="button" class="block w-full cursor-pointer rounded px-3 py-3 text-left font-semibold text-muted" data-mode-toggle data-testid="mode-menu" hidden>
                      <span data-mode-texte>Passer au thème sombre</span>
                    </button>
                  </div>
                )
              }
              {
                nouveautesMarker && (
                  <div class="mt-1 border-t border-line pt-1 lg:hidden">
                    <a
                      href={`${base}/nouveautes`}
                      aria-current={path === "/nouveautes" ? "page" : undefined}
                      class:list={["flex items-center gap-2 rounded px-3 py-3 font-semibold", path === "/nouveautes" ? "bg-surface-2 text-white" : "text-muted"]}
                      data-testid="nouveautes-menu-link"
                    >
                      Nouveautés du site
                      <span class="nouveautes-dot" data-nouveautes-dot hidden><span class="sr-only">: du nouveau depuis votre dernier passage</span></span>
                    </a>
                  </div>
                )
              }
            </nav>
          </details>
        </div>
      </div>
    </header>
    )}

    <main id="contenu" class="flex-1">
      {/* La vue joueur de l'encadrement : une bande en haut de chaque page pour ne pas l'oublier et en sortir. Hors de l'en-tête collant, qui garde sa hauteur. */}
      {AUTH_ENABLED && <PlayerViewBar client:idle />}
      {!jeu && <SectionNav />}
      <slot />
      {/* Les appels des Gaulois au QG, sur toutes les pages : rien pour un visiteur sans session, le serveur ne répond qu'aux membres validés. */}
      {AUTH_ENABLED && <AppelsGaulois client:idle />}
    </main>

    {jeu ? (
    <slot name="pied-jeu" />
    ) : (
    <footer class="mt-20 bg-night">
      <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-[3fr_3fr_2fr_3fr]">
        <div>
          <p class="font-display text-lg font-extrabold">[{clan.tag}] {clan.name}</p>
          <span class="tribar mt-3"></span>
          <p class="mt-4 text-sm text-muted">{SITE_DISCLAIMER}</p>
          {/* La mention de licence d'OpenFront : le Gaulois compagnon ne s'arrête pas dessus et s'efface s'il s'y trouve (src/scripts/compagnon.ts). */}
          <p class="mt-2 text-sm text-muted" data-compagnon-mention>{SITE_LICENSE_NOTICE}</p>
        </div>
        <nav aria-label="Plan du site">
          <h2 class="text-sm uppercase tracking-wide text-muted">Le site</h2>
          <ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm" data-testid="footer-plan">
            {SECTIONS.flatMap((s) => s.pages).map((p) => <li><a href={`${base}${p.href}`}>{p.label}</a></li>)}
          </ul>
        </nav>
        <div>
          <h2 class="text-sm uppercase tracking-wide text-muted">Liens utiles</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href={clan.links.discord} rel="noopener">Discord du clan</a></li>
            <li><a href={clan.links.openfront} rel="noopener">Jouer à OpenFront</a></li>
            {AUTH_ENABLED && <li><a href={`${base}/confidentialite`}>Confidentialité</a></li>}
            {/* La loi du 21 juin 2004 (article 1-1) met l'éditeur et l'hébergeur à la disposition du public : le lien est sur chaque page, serveur ou non. */}
            <li><a href={`${base}/mentions-legales`}>Mentions légales</a></li>
            <li><a href={clan.links.source} rel="noopener">Code source</a></li>
          </ul>
        </div>
        <div class="text-sm text-muted">
          <h2 class="text-sm uppercase tracking-wide">Données</h2>
          <p class="mt-3">
            Chiffres de l'API publique d'OpenFront, collectés toutes les heures : pas de temps réel.
          </p>
          {lastRun && <p class="mt-2 tnum">Dernière collecte : {fmtDateTime(lastRun)}, heure de Paris.</p>}
        </div>
      </div>
      <GauloisCompagnon />
    </footer>
    )}

    <script>
      // Le site est statique : si la collecte s'arrête, seul le navigateur du
      // visiteur peut voir que les données ont vieilli.
      const now = Date.now();
      for (const el of document.querySelectorAll<HTMLElement>("[data-last-success]")) {
        const age = now - Date.parse(el.dataset.lastSuccess ?? "");
        const maxAge = Number(el.dataset.maxAgeHours) * 3_600_000;
        const msg = el.querySelector<HTMLElement>("[data-stale-msg]");
        if (msg && age > maxAge) {
          const hours = Math.floor(age / 3_600_000);
          // Un en-tête qui date plusieurs sources nomme celle qui a vieilli (« de la liste des membres ») : DataStatus.astro.
          const label = msg.dataset.staleLabel ? ` ${msg.dataset.staleLabel}` : "";
          msg.textContent = `Données périmées : dernière mise à jour${label} il y a ${hours >= 48 ? `${Math.floor(hours / 24)} jours` : `${hours} h`}.`;
          msg.hidden = false;
        }
      }

      // Referme les menus de l'en-tête (le menu mobile, les nouveautés) avec Échap ou au clic en dehors.
      const menus = document.querySelectorAll<HTMLDetailsElement>("[data-menu]");
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        for (const menu of menus) {
          if (!menu.open) continue;
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
      document.addEventListener("click", (e) => {
        for (const menu of menus) if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
      });
    </script>
    <script>
      // Le compte des visites. La page qu'il compte : `data-route` du <body>, le modèle d'adresse (`/membres/[id]`, jamais
      // l'identifiant). S'il est déjà venu : la note posée en tête de page.
      import "../scripts/visite";
      import "../scripts/mode";
      import "../scripts/fx";
      import "../scripts/nouveautes";
      import "../scripts/visages";
    </script>
  </body>
</html>
