    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^1.7.0",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
